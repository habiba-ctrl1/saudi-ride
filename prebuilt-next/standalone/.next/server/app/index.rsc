18:T6f5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I book a taxi in Saudi Arabia?","acceptedAnswer":{"@type":"Answer","text":"You can book a taxi in Saudi Arabia online via our booking console or directly through WhatsApp booking. Simply provide your pickup location, destination, date, and time. Our 24/7 taxi service team will confirm your ride with a clear price, usually within 1–2 hours."}},{"@type":"Question","name":"How much is a Jeddah Airport to Makkah taxi?","acceptedAnswer":{"@type":"Answer","text":"The taxi fare for a Jeddah Airport to Makkah taxi is confirmed on WhatsApp before booking — a fixed fare with no hidden charges or surge. Standard sedans and larger family vehicles like the Hyundai Staria are available."}},{"@type":"Question","name":"Do you offer Umrah transport from Madinah?","acceptedAnswer":{"@type":"Answer","text":"Yes, our Umrah transport covers the Makkah to Madinah taxi route, Madinah to Makkah taxi route, and Madinah Ziyarat taxi services. Prayer and rest stops can be arranged on request, and trips are driven by professional chauffeurs in our partner network."}},{"@type":"Question","name":"Are the taxi drivers licensed and professional?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. Drivers in our partner network speak English and Arabic, and trips run 24 hours a day, ensuring a smooth Saudi airport transfer and intercity experience."}},{"@type":"Question","name":"Do you have vehicles for large families or groups?","acceptedAnswer":{"@type":"Answer","text":"Yes, we offer luxury SUV taxis like the GMC Yukon and spacious vans like the Toyota Hiace and Hyundai Staria. These are perfect for group Umrah airport transfers and family taxi trips across Saudi Arabia."}}]}c:["$","$1","c",{"children":[[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$18"}}]],["$","$L19",null,{}]],null,["$","$L1a",null,{"children":["$L1b",["$","$L1c",null,{"promise":"$@1d"}]]}]]}]
