1d:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"@id\":\"https://taxisaudiarabia.com/locations/jeddah/obhur#service\",\"name\":\"Taxi Service in Obhur (Abhur)\",\"serviceType\":\"Private transfer service\",\"description\":\"Private transfers to and from Obhur (Abhur), north Jeddah — Obhur Creek beach resorts, JED airport runs and day trips to Makkah. Fare agreed first, 24/7.\",\"url\":\"https://taxisaudiarabia.com/locations/jeddah/obhur\",\"provider\":{\"@type\":\"Organization\",\"name\":\"Taxi Saudi Arabia\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Jeddah\"},\"availableLanguage\":[\"English\",\"Arabic\"],\"about\":{\"@type\":\"Place\",\"name\":\"Obhur Creek, Jeddah\",\"description\":\"Resort and beach area in far north Jeddah.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Jeddah\",\"addressCountry\":\"SA\"}}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/locations/jeddah/obhur#webpage\",\"url\":\"https://taxisaudiarabia.com/locations/jeddah/obhur\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is Obhur close to Jeddah airport?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes — Obhur is in the far north of Jeddah, the stretch of coast closest to King Abdulaziz International Airport. Central Jeddah and Al-Balad are much further south.\"}},{\"@type\":\"Question\",\"name\":\"Do you pick up from North and South Obhur?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Tell us which side of Obhur Creek and the resort or compound name, and the driver comes to its entrance, 24/7.\"}},{\"@type\":\"Question\",\"name\":\"Can I go from an Obhur resort straight to Makkah?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Book a direct transfer from your resort to your Makkah hotel; allow extra time for crossing Jeddah first.\"}},{\"@type\":\"Question\",\"name\":\"Can you carry beach and diving gear?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes — mention it when you book so we send an SUV or van with enough space.\"}}]}"}}]],["$","section",null,{"className":"relative overflow-hidden bg-[#0B1F14]","children":[[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://taxisaudiarabia.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Locations\",\"item\":\"https://taxisaudiarabia.com/locations\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Jeddah\",\"item\":\"https://taxisaudiarabia.com/locations/jeddah\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Obhur (Abhur)\",\"item\":\"https://taxisaudiarabia.com/locations/jeddah/obhur\"}]}"}}]],["$","nav",null,{"aria-label":"Breadcrumb","className":"section-container max-w-7xl pt-24 pb-2 relative [&_a]:text-white/70 [&_a:hover]:text-white [&_span]:text-[#FACC15]","children":["$","ol",null,{"className":"flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1 text-[0.8rem] text-[#64748B]","children":["$L28","$L29","$L2a","$L2b"]}]}]],"$L2c"]}],"$L2d","$L2e"]}]
