27:T68f,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much is a taxi from Dhahran to Dammam airport?","acceptedAnswer":{"@type":"Answer","text":"A taxi from Dhahran to King Fahd International Airport (DMM) is about 25 km — roughly a 25-minute drive. Sedans, SUVs and vans are available, fare confirmed on WhatsApp before booking."}},{"@type":"Question","name":"Do you offer corporate accounts for Saudi Aramco contractors?","acceptedAnswer":{"@type":"Answer","text":"Yes. We offer monthly corporate billing for contractors, consultants, and companies working with Saudi Aramco, KFUPM, or based in Dhahran Techno Valley — a dedicated account manager and consolidated invoicing instead of per-trip payment. Contact us via WhatsApp to set one up."}},{"@type":"Question","name":"Can you pick up visitors from inside Aramco or KFUPM gates?","acceptedAnswer":{"@type":"Answer","text":"Share your host company, badge type, and gate name when booking so the driver can plan the correct visitor entry point and waiting area — some Aramco facilities have restricted access requiring advance notice."}},{"@type":"Question","name":"How far is Dhahran from Al Khobar and Jubail?","acceptedAnswer":{"@type":"Answer","text":"Dhahran is about 15 km from Al Khobar (roughly 15 minutes) and 85 km from Jubail (roughly an hour). We serve all three cities with the same Eastern Province driver network."}},{"@type":"Question","name":"Is taxi available in Dhahran 24/7?","acceptedAnswer":{"@type":"Answer","text":"Yes, we run 24/7 in Dhahran, including early-morning and late-night pickups for shift workers, contractors, and airport connections."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Taxi Service in Dhahran\",\"description\":\"Book a private transfer in Dhahran for transfers to and from King Fahd International Airport (DMM) (~25 km, ~25 min), corporate travel to Saudi Aramco headquarters, Dhahran Techno Valley, and King Fahd University of Petroleum & Minerals (KFUPM), plus connections to Dammam, Al Khobar, and Jubail. Our drivers know Aramco gate procedures, visitor-badge waiting areas, and shift-change traffic, and we offer monthly corporate accounts for contractors and companies who need consolidated billing instead of per-ride payment. Fares are fixed in advance with no surge pricing.\",\"serviceType\":\"Local Taxi & Car Service\",\"url\":\"https://taxisaudiarabia.com/locations/dhahran\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Dhahran\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/locations/dhahran#webpage\",\"url\":\"https://taxisaudiarabia.com/locations/dhahran\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"numberOfItems\":2,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Dammam Airport to Dhahran\",\"url\":\"https://taxisaudiarabia.com/routes/dammam-airport-to-dhahran\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Dhahran to Dammam Airport\",\"url\":\"https://taxisaudiarabia.com/routes/dhahran-to-dammam-airport\"}]}"}}]],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}]],"$undefined","$L28","$L29","$L2a","$L2b"]}]
