2a:["$","section",null,{"className":"section-container relative z-10 -mt-8 max-w-6xl","aria-label":"Summary","children":["$","div",null,{"className":"rounded-[2rem] border border-[#16A34A]/15 bg-white p-6 shadow-[0_30px_70px_-45px_rgba(15,23,42,0.5)] md:p-9","children":[["$","p",null,{"id":"speakable-summary","className":"text-[1.02rem] leading-relaxed text-[#1F2937] md:text-[1.1rem]","children":"A private driver in Makkah is a car and chauffeur booked for a block of hours or a whole day. The car waits outside every stop — a meeting, a shopping trip, a family visit, a Ziyarat — so you never re-book a ride or search for a taxi at the Haram after prayers. Waiting during prayers is covered by the hours you book; the 15–30 minutes free-waiting rule is for one-way transfers."}],["$","div",null,{"className":"mt-7","children":["$","dl",null,{"className":"grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-[#16A34A]/15 bg-[#16A34A]/15 md:grid-cols-4","children":[["$","div","Ziyarat stops",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Ziyarat stops"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Jabal al-Nour · Thawr · Mina · Arafat"}]]}],["$","div","Near the Haram",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Near the Haram"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Drop-off at the nearest permitted point"}]]}],["$","div","Jeddah day",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Jeddah day"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"About 85 k