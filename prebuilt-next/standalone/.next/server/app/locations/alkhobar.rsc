29:["$","section",null,{"aria-labelledby":"answer-heading","className":"section-container relative z-10 -mt-8 max-w-6xl","children":["$","div",null,{"className":"rounded-[2rem] border border-[#16A34A]/15 bg-white p-6 shadow-[0_30px_70px_-45px_rgba(15,23,42,0.5)] md:p-9","children":[["$","div",null,{"className":"grid gap-6 md:grid-cols-[auto_1fr] md:gap-8","children":[["$","p",null,{"id":"answer-heading","className":"text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A] md:w-32 md:pt-1","children":"The short answer"}],["$","p",null,{"id":"speakable-summary","className":"text-[1.05rem] leading-relaxed text-[#1F2937] md:text-lg","children":"Taxi Saudi Arabia arranges pre-booked private cars in Al Khobar through a vetted partner network. The most-booked trips are Bahrain over the King Fahd Causeway (Al Khobar to Manama is about 50 km — the shortest crossing of the three Eastern Province cities in our route data), King Fahd Airport (DMM) pickups, rides across Khobar, Dhahran and Dammam, Doha by road (400 km) and Riyadh (400 km). The fare is agreed before you book."}]]}],["$","div",null,{"className":"mt-7","children":["$","dl",null,{"className":"grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-[#16A34A]/15 bg-[#16A34A]/15 md:grid-cols-4","children":[["$","div","Al Khobar → Manama",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Al Khobar → Manama"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"50 km · ~50 min"}]]}],["$","div","Al Khobar → Doha",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Al Khobar → Doha"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"400 km · ~4 hr"}]]}],["$","div","Al Khobar → Riyadh",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Al Khobar → Riyadh"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"400 km · ~3 hr 40 min"}]]}],["$","div","Causeway fee",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Causeway fee"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Included for the vehicle"}]]}],["$","div","Flights",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Flights"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"We track your flight"}]]}],["$","div","Cancellation",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Cancellation"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Free up to 24 hours before"}]]}]]}]}]]}]}]
2a:["$","div",null,{"className":"section-container max-w-6xl space-y-20 py-20 md:space-y-28 md:py-28","children":[["$","section",null,{"aria-labelledby":"trip-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"Start here"}],["$","h2",null,{"id":"trip-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"Where are you going from Al Khobar?"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[#6B7280]","children":"Choose the trip; each card lists what to send and links to its own page."}]]}],["$","$L35",null,{"trips":[{"id":"bahrain","icon":"route","label":"Bahrain over the causeway","short":"50 km to Manama","answer":"Al Khobar sits closest to the King Fahd Causeway, so Manama is about 50 km (~50 min) door to door. The vehicle's crossing fee is in the fare; every passenger brings their own passport and entry documents. There is no \"drop at the border\" option on the causeway — the car goes through.","send":["Pickup address in Al Khobar","Bahrain address","Date and time","Passengers and nationalities"],"href":"/routes/alkhobar-to-manama","linkLabel":"Al Khobar to Manama private car","waPrefill":"Salam! Al Khobar → Bahrain.\n• From: \n• To (Bahrain address): \n• Date & time: \n• Passengers & luggage: \n(ref: alkhobar-hub)"},{"id":"airport","icon":"plane","label":"DMM Airport ↔ Al Khobar","short":"Flight tracked, meet & greet","answer":"King Fahd International Airport is north-west of the metro; Al Khobar is further from it than Dhahran (50 km), so allow for a proper drive on departure days. We track the flight and the first 15–30 minutes of waiting are free.","send":["Flight number","Hotel or address in Al Khobar","Passengers and large bags"],"href":"/airports/king-fahd-dammam","linkLabel":"DMM airport transfers","waPrefill":"Salam! DMM Airport ↔ Al Khobar.\n• Flight number: \n• Hotel / address: \n• Date & time: \n• Passengers & luggage: \n(ref: alkhobar-hub)"},{"id":"metro","icon":"hotel","label":"Rides in Khobar, Dhahran & Dammam","short":"Corniche, malls, offices","answer":"One pre-booked car between two addresses — a Corniche hotel to an office in Dhahran, dinner in Dammam, or back from a mall at closing time. One fixed fare for the whole car.","send":["Pickup","Drop-off","Date and time","Passengers"],"href":"/locations/dammam","linkLabel":"Rides across the Dammam metro","waPrefill":"Salam! Ride from Al Khobar.\n• From: \n• To: \n• Date & time: \n• Passengers: \n• One-way or return: \n(ref: alkhobar-hub)"},{"id":"private-driver","icon":"clock","label":"Driver by the hour","short":"Half day or full day","answer":"Keep one car and driver for the day — meetings on the Khobar side, a site visit in Dhahran, the airport at the end. The driver waits at each stop.","send":["Date and start time","Hours","Stops","Passengers"],"href":"/locations/dammam/private-driver","linkLabel":"Private driver in Dammam & Al Khobar","waPrefill":"Salam! Private driver from Al Khobar (hourly / full day).\n• Date & start time: \n• Hours needed: \n• Stops: \n• Passengers: \n(ref: dammam-private-driver)"},{"id":"beach","icon":"landmark","label":"Half Moon Bay day","short":"Timed return","answer":"Half Moon Bay is south of Al Khobar along the coast. Book the drive there and a timed return, or keep the car for the day if you are visiting more than one place.","send":["Pickup","Beach or resort name","Date, start and return time","Passengers"],"href":"/locations/dammam/half-moon-bay","linkLabel":"Half Moon Bay transfers","waPrefill":"Salam! Al Khobar → Half Moon Bay.\n• Pickup: \n• Beach / resort: \n• Date & times (there / back): \n• Passengers: \n(ref: alkhobar-hub)"},{"id":"qatar","icon":"route","label":"Doha via Salwa","short":"400 km","answer":"Al Khobar to Doha is about 400 km through the Salwa border (~4 hr). The vehicle's border fees are included; visas are each passenger's own.","send":["Pickup","Doha address","Date and time","Passengers"],"href":"/routes/alkhobar-to-doha","linkLabel":"Al Khobar to Doha private transfer","waPrefill":"Salam! Al Khobar → Doha.\n• From: \n• To (Doha address): \n• Date & time: \n• Passengers & luggage: \n(ref: alkhobar-hub)"},{"id":"riyadh","icon":"route","label":"Riyadh by road","short":"400 km","answer":"Al Khobar to Riyadh is about 400 km (~3 hr 40 min), door to door with stops when you ask.","send":["Pickup","Riyadh address","Date and time","Passengers"],"href":"/routes/alkhobar-to-riyadh","linkLabel":"Al Khobar to Riyadh","waPrefill":"Salam! Al Khobar → Riyadh.\n• From: \n• To: \n• Date & time: \n• Passengers & luggage: \n(ref: alkhobar-hub)"},{"id":"corporate","icon":"briefcase","label":"Companies & visiting teams","short":"Written quote","answer":"Email the trips and dates and the cars come back on one written quote. Corporate invoicing can be arranged through our sister company.","send":["Company","Dates and trips","Passengers per trip","Invoice needed?"],"href":"/services/corporate","linkLabel":"Corporate transportation","waPrefill":"Salam! Corporate transport in Al Khobar.\n• Company: \n• Dates & trips: \n• Passengers: \n(ref: alkhobar-hub)"}],"whatsappLink":"https://wa.me/966539388072"}]]}],"$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f"]}]
