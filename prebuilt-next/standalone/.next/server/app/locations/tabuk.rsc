2d:T558,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I go from Tabuk to Aqaba by private car?","acceptedAnswer":{"@type":"Answer","text":"Yes, about 270 km via Al Durrah near Haql. The vehicle's border fees are included; each passenger brings a passport and visa. Our Jordan partner covers the Jordan side door to door."}},{"@type":"Question","name":"Which crossing do you use for Petra and Amman?","acceptedAnswer":{"@type":"Answer","text":"Halat Ammar–Al Mudawwara, the shortest road from Tabuk to inland Jordan."}},{"@type":"Question","name":"Can you drop us at the border instead?","acceptedAnswer":{"@type":"Answer","text":"Yes, for Jordan — a cheaper option where we drop you at the Saudi side. How you continue across the crossing is your own arrangement."}},{"@type":"Question","name":"How do I get from Tabuk Airport to NEOM?","acceptedAnswer":{"@type":"Answer","text":"Pre-book a private car: about 180 km. We track the flight and meet you at arrivals."}},{"@type":"Question","name":"Is this car rental?","acceptedAnswer":{"@type":"Answer","text":"We do not rent self-drive cars — every booking is a car with a professional driver."}},{"@type":"Question","name":"Can my company be invoiced?","acceptedAnswer":{"@type":"Answer","text":"Yes. Corporate invoicing can be arranged through our sister company."}}]}28:["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2d"}}]
