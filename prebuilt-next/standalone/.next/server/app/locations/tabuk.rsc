27:T4d8,{"@context":"https://schema.org","@type":"ItemList","numberOfItems":9,"itemListElement":[{"@type":"ListItem","position":1,"name":"Tabuk Airport to NEOM","url":"https://taxisaudiarabia.com/routes/tabuk-airport-to-neom"},{"@type":"ListItem","position":2,"name":"Tabuk to Aqaba, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-aqaba"},{"@type":"ListItem","position":3,"name":"Tabuk to Red Sea International Airport","url":"https://taxisaudiarabia.com/routes/tabuk-to-red-sea-airport"},{"@type":"ListItem","position":4,"name":"Madinah to Tabuk","url":"https://taxisaudiarabia.com/routes/madinah-to-tabuk"},{"@type":"ListItem","position":5,"name":"Aqaba, Jordan to Tabuk","url":"https://taxisaudiarabia.com/routes/aqaba-to-tabuk"},{"@type":"ListItem","position":6,"name":"Tabuk to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-amman"},{"@type":"ListItem","position":7,"name":"Amman, Jordan to Tabuk","url":"https://taxisaudiarabia.com/routes/amman-to-tabuk"},{"@type":"ListItem","position":8,"name":"Tabuk to Petra, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-petra"},{"@type":"ListItem","position":9,"name":"Tabuk to Wadi Rum, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-wadi-rum"}]}28:T630,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I get from Tabuk Airport to NEOM?","acceptedAnswer":{"@type":"Answer","text":"We run transfers from Tabuk Regional Airport (TUU) directly to NEOM and NEOM Bay, about 120 km away — the main route used by contractors, investors, and visitors reaching the project."}},{"@type":"Question","name":"Can I cross the border to Jordan from Tabuk?","acceptedAnswer":{"@type":"Answer","text":"Yes, we offer cross-border transfers from Tabuk to the Jordan border near Haql (Al Durrah crossing) and onward toward Aqaba, with Aqaba about 270 km from Tabuk city by road. Valid travel documents are required."}},{"@type":"Question","name":"Is Tabuk a good base for visiting the Red Sea and AlUla?","acceptedAnswer":{"@type":"Answer","text":"Yes — Tabuk is the closest major airport hub to the Red Sea coast (Duba, Haql) and within reach of AlUla, making it a common stop for premium tourism and NEOM-related travel."}},{"@type":"Question","name":"How much is a taxi from Tabuk Airport to the city?","acceptedAnswer":{"@type":"Answer","text":"A taxi from Tabuk Regional Airport (TUU) to the city centre is about 7 km, with meet & greet at arrivals and no surge pricing."}},{"@type":"Question","name":"Is executive transport available in Tabuk 24/7?","acceptedAnswer":{"@type":"Answer","text":"Yes, we provide round-the-clock taxi and executive car service in Tabuk for airport transfers, NEOM business trips, and cross-border journeys — with your fare confirmed on WhatsApp before you book."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Taxi Service in Tabuk\",\"description\":\"Book a taxi or executive chauffeur service in Tabuk for airport transfers, business trips to NEOM, and cross-border journeys to Jordan via the Halat Ammar or Al Durrah crossing. Tabuk is the main air and road gateway to the NEOM giga-project, the Red Sea coast, and AlUla, making it a key hub for contractors, investors, and tourists heading north. Our drivers cover Tabuk Regional Airport (TUU), the historic Old Town and Tabuk Castle, Wadi Disah, Tayma, and the coastal towns of Haql and Duba — all with your fare confirmed before you book, no surge, day or night.\",\"serviceType\":\"Local Taxi & Car Service\",\"url\":\"https://taxisaudiarabia.com/locations/tabuk\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Tabuk\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":28.3998,\"longitude\":36.5715}