2b:["$","div",null,{"className":"section-container max-w-6xl space-y-20 py-20 md:space-y-28 md:py-28","children":[["$","section",null,{"aria-labelledby":"trip-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"Start here"}],["$","h2",null,{"id":"trip-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"Where are you going from Tabuk?"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[#6B7280]","children":"Most Tabuk bookings are Jordan crossings and NEOM arrivals. Each card says what to send."}]]}],["$","$L33",null,{"trips":[{"id":"aqaba","icon":"route","label":"Tabuk → Aqaba","short":"270 km","answer":"About 270 km (~3 hr 50 min). Aqaba is reached via the Al Durrah crossing near Haql. The vehicle's border fees are included; each passenger brings a passport and visa. Our Jordan partner covers the Jordan side door to door.","send":["Pickup in Tabuk","Aqaba address or airport","Date and time","Passengers and nationalities"],"href":"/routes/tabuk-to-aqaba","linkLabel":"Tabuk to Aqaba border transfer","waPrefill":"Salam! Tabuk → Aqaba.\n• Pickup: \n• Aqaba address / airport: \n• Date & time: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"petra","icon":"landmark","label":"Tabuk → Petra or Wadi Rum","short":"275 km / 230 km","answer":"Petra is about 275 km and Wadi Rum about 230 km, both via the Halat Ammar–Al Mudawwara crossing — the shortest road from Tabuk. Transport only; tickets and guides are your own.","send":["Pickup","Petra or Wadi Rum hotel / camp","Date","Passengers"],"href":"/routes/tabuk-to-petra","linkLabel":"Tabuk to Petra transfer","waPrefill":"Salam! Tabuk → Petra / Wadi Rum.\n• Pickup: \n• Hotel / camp: \n• Date: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"amman","icon":"route","label":"Tabuk → Amman","short":"455 km","answer":"About 455 km (~5 hr 35 min) via Halat Ammar. A long day — stops planned in advance.","send":["Pickup","Amman address or airport","Date","Passengers"],"href":"/routes/tabuk-to-amman","linkLabel":"Tabuk to Amman transfer","waPrefill":"Salam! Tabuk → Amman.\n• Pickup: \n• Amman address: \n• Date: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"neom","icon":"plane","label":"TUU Airport → NEOM","short":"180 km","answer":"Straight from the terminal to NEOM: about 180 km. Confirmed points are Sharma, Magna and Oxagon; send other sites first.","send":["Flight number","NEOM destination","Passengers"],"href":"/routes/tabuk-airport-to-neom","linkLabel":"Tabuk Airport to NEOM transfer","waPrefill":"Salam! Tabuk Airport → NEOM.\n• Flight: \n• NEOM destination: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"airport","icon":"plane","label":"TUU Airport ↔ Tabuk city","short":"Meet & greet","answer":"Arrivals and departures between Tabuk Regional Airport and your hotel. We track the flight; 15–30 minutes free waiting.","send":["Flight number","Hotel","Passengers"],"href":"/airports/tabuk-regional","linkLabel":"Tabuk Airport (TUU) transfers","waPrefill":"Salam! Tabuk Airport transfer.\n• Flight: \n• Hotel: \n• Date & time: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"rsi","icon":"route","label":"Red Sea Airport","short":"460 km","answer":"Tabuk to Red Sea International is about 460 km — for resort guests and flights from RSI.","send":["Pickup","Flight or resort","Date","Passengers"],"href":"/routes/tabuk-to-red-sea-airport","linkLabel":"Tabuk to Red Sea Airport","waPrefill":"Salam! Tabuk → Red Sea Airport.\n• Pickup: \n• Flight / resort: \n• Date: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"madinah","icon":"route","label":"Madinah & further south","short":"620 km to Madinah","answer":"Madinah is about 620 km away — door to door with prayer and rest stops.","send":["Pickup","Madinah hotel","Date","Passengers"],"href":"/routes/madinah-to-tabuk","linkLabel":"Madinah ↔ Tabuk","waPrefill":"Salam! Tabuk ↔ Madinah.\n• From: \n• To: \n• Date: \n• Passengers: \n(ref: tabuk-hub)"},{"id":"corporate","icon":"briefcase","label":"Business & delegations","short":"Written quote","answer":"Visiting teams and NEOM contractors staying in Tabuk can have every leg on one written quote. Corporate invoicing can be arranged through our sister company.","send":["Company","Dates","Headcount","Trips"],"href":"/services/business-executive","linkLabel":"Private chauffeur & executive transport","waPrefill":"Salam! Corporate transport in Tabuk.\n• Company: \n• Dates & trips: \n• Headcount: \n(ref: tabuk-hub)"}],"whatsappLink":"https://wa.me/966539388072"}]]}],"$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}]
