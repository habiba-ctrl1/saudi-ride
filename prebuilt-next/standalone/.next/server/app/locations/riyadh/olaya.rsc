28:T435,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How far is Olaya from Riyadh airport?","acceptedAnswer":{"@type":"Answer","text":"Central Riyadh, including Olaya, is about 35 km from King Khalid International Airport (RUH) — ~30 min with clear roads, longer at commuter peaks."}},{"@type":"Question","name":"Do you pick up from hotels near Kingdom Centre and Al Faisaliah Tower?","acceptedAnswer":{"@type":"Answer","text":"Yes. Share the hotel name and the driver comes to the hotel's own entrance, 24 hours a day."}},{"@type":"Question","name":"Is hourly hire worth it for a shopping day in Olaya?","acceptedAnswer":{"@type":"Answer","text":"Usually yes once you have three or more stops — the driver waits and holds your bags, and you never wait for a new car outside a mall."}},{"@type":"Question","name":"Can I book an Olaya to Diriyah return trip?","acceptedAnswer":{"@type":"Answer","text":"Yes. Book the drop-off and agree a fixed return time, or keep the car for the evening if you are not sure when you will leave."}}]}1d:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"@id\":\"https://taxisaudiarabia.com/locations/riyadh/olaya#service\",\"name\":\"Taxi Service in Olaya — Hotels, Kingdom Centre & Al Faisaliah\",\"serviceType\":\"Private transfer service\",\"description\":\"Private transfers in Olaya, Riyadh — hotel pickups near Kingdom Centre and Al Faisaliah, RUH airport runs and meeting days. Fare agreed first, 24/7.\",\"url\":\"https://taxisaudiarabia.com/locations/riyadh/olaya\",\"provider\":{\"@type\":\"Organization\",\"name\":\"Taxi Saudi Arabia\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Riyadh\"},\"availableLanguage\":[\"English\",\"Arabic\"],\"about\":{\"@type\":\"Place\",\"name\":\"Ol