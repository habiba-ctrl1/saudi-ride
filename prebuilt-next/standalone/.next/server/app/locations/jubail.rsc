2a:["$","div",null,{"className":"section-container max-w-6xl space-y-20 py-20 md:space-y-28 md:py-28","children":[["$","section",null,{"aria-labelledby":"trip-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"Start here"}],["$","h2",null,{"id":"trip-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"What kind of Jubail trip is it?"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[#6B7280]","children":"Most Jubail bookings are airport legs and site visits. Pick one — each lists what we need."}]]}],["$","$L33",null,{"trips":[{"id":"airport","icon":"plane","label":"DMM Airport → Jubail","short":"90 km","answer":"About 90 km (~1 hr 5 min) from the terminal to your hotel, camp or site gate. We track the flight; the first 15–30 minutes of waiting are free.","send":["Flight number","Hotel, camp or site","Passengers and equipment"],"href":"/routes/dammam-airport-to-jubail","linkLabel":"DMM Airport to Jubail transfer","waPrefill":"Salam! DMM Airport → Jubail.\n• Flight number: \n• Hotel / camp / site: \n• Date & time: \n• Passengers & equipment: \n(ref: jubail-hub)"},{"id":"departure","icon":"plane","label":"Jubail → DMM Airport","short":"Worked back from the flight","answer":"Pickup time is planned from your flight, with a margin for the drive down the coast.","send":["Pickup","Flight time","Passengers and bags"],"href":"/routes/jubail-to-dammam-airport","linkLabel":"Jubail to DMM Airport","waPrefill":"Salam! Jubail → DMM Airport.\n• Pickup: \n• Flight time: \n• Passengers & bags: \n(ref: jubail-hub)"},{"id":"site","icon":"briefcase","label":"Site and plant visits","short":"Company + gate name","answer":"Send the company, the site and the gate you were given. Entry is arranged by your host; the driver meets you at the agreed point and waits if you book by the hour.","send":["Company and site","Gate","Date and time","Passengers"],"href":"#local","linkLabel":"How site pickups work","waPrefill":"Salam! Jubail site visit.\n• Company / site: \n• Gate: \n• Date & time: \n• Passengers: \n(ref: jubail-hub)"},{"id":"crew","icon":"route","label":"Crews with equipment","short":"Hiace, coaster","answer":"Teams travelling with tools or cases need the right vehicle. Tell us the headcount and what you are carrying and we size the van or coaster.","send":["Headcount","Equipment / luggage","Pickup and site","Dates"],"href":"/services/group-transport","linkLabel":"Group transportation","waPrefill":"Salam! Crew transport in Jubail.\n• Headcount: \n• Equipment / luggage: \n• Pickup & site: \n• Dates: \n(ref: jubail-hub)"},{"id":"private-driver","icon":"clock","label":"Driver for the day","short":"Jubail and back","answer":"A day of site meetings in Jubail from a Dammam or Khobar hotel — keep one car and driver, and the return is already in the booking.","send":["Date and start time","Hours","Sites","Passengers"],"href":"/locations/dammam/private-driver","linkLabel":"Private driver in the Eastern Province","waPrefill":"Salam! Private driver for a Jubail day.\n• Date & start time: \n• Hours needed: \n• Sites: \n• Passengers: \n(ref: dammam-private-driver)"},{"id":"metro","icon":"hotel","label":"To Dammam, Khobar or Dhahran","short":"Hotels and offices","answer":"Single transfers down the coast to a hotel, office or meeting in the Dammam metro.","send":["Pickup","Drop-off","Date and time"],"href":"/locations/dammam","linkLabel":"Dammam & Eastern Province","waPrefill":"Salam! Jubail → Dammam / Khobar.\n• From: \n• To: \n• Date & time: \n• Passengers: \n(ref: jubail-hub)"},{"id":"kuwait","icon":"route","label":"Kuwait by road","short":"375 km","answer":"Jubail to Kuwait City is about 375 km (~3 hr 35 min). The vehicle's border fees are included; entry documents are each passenger's own.","send":["Pickup","Kuwait address","Date and time","Passengers"],"href":"/routes/jubail-to-kuwait","linkLabel":"Jubail to Kuwait City private transfer","waPrefill":"Salam! Jubail → Kuwait.\n• From: \n• To: \n• Date & time: \n• Passengers: \n(ref: jubail-hub)"},{"id":"corporate","icon":"briefcase","label":"Contractor & company bookings","short":"Written quote","answer":"Rotations, site weeks and visiting teams can be quoted in writing for all the trips and dates. Corporate invoicing can be arranged through our sister company.","send":["Company","Dates","Headcount","Sites"],"href":"/services/corporate","linkLabel":"Corporate transportation","waPrefill":"Salam! Corporate transport in Jubail.\n• Company: \n• Dates & trips: \n• Headcount: \n(ref: jubail-hub)"}],"whatsappLink":"https://wa.me/966539388072"}]]}],"$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}]
