26:T749,{"@context":"https://schema.org","@type":"TaxiService","@id":"https://taxisaudiarabia.com/locations/jubail#service","name":"Private taxi, transfers & chauffeur service in Jubail","description":"Pre-booked private transport for Jubail: DMM airport transfers, site and plant visitor pickups (access arranged by the host), crew vans and coasters, hourly drivers and trips to Dammam, Al Khobar and Kuwait, through a vetted partner network.","url":"https://taxisaudiarabia.com/locations/jubail","provider":{"@type":"Organization","name":"Taxi Saudi Arabia","url":"https://taxisaudiarabia.com"},"areaServed":{"@type":"City","name":"Jubail","geo":{"@type":"GeoCoordinates","latitude":27.0046,"longitude":49.646}},"availableLanguage":["English","Arabic"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Jubail transport services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"DMM Airport → Jubail","url":"https://taxisaudiarabia.com/routes/dammam-airport-to-jubail"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Jubail → DMM Airport","url":"https://taxisaudiarabia.com/routes/jubail-to-dammam-airport"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Crews with equipment","url":"https://taxisaudiarabia.com/services/group-transport"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Driver for the day","url":"https://taxisaudiarabia.com/locations/dammam/private-driver"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"To Dammam, Khobar or Dhahran","url":"https://taxisaudiarabia.com/locations/dammam"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Kuwait by road","url":"https://taxisaudiarabia.com/routes/jubail-to-kuwait"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Contractor & company bookings","url":"https://taxisaudiarabia.com/services/corporate"}}]}}27:T666,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How far is Jubail from Dammam airport?","acceptedAnswer":{"@type":"Answer","text":"About 90 km — roughly ~1 hr 5 min. We track your flight and meet you at arrivals, and the fare is agreed before you travel."}},{"@type":"Question","name":"Can you pick up from inside Jubail Industrial City?","acceptedAnswer":{"@type":"Answer","text":"At the gate or point your host gives you. Send the company, site and gate when you book. Entry is arranged by your host, not by us."}},{"@type":"Question","name":"Can you move a crew with tools or equipment?","acceptedAnswer":{"@type":"Answer","text":"Yes, in vans such as the Toyota Hiace or a Coaster through our partner network. Tell us the headcount and what you are carrying so the vehicle fits."}},{"@type":"Question","name":"Can I book a car from Jubail to Kuwait?","acceptedAnswer":{"@type":"Answer","text":"Yes, about 375 km. The vehicle's border fees are included; passengers bring their own entry documents."}},{"@type":"Question","name":"Can my company get a written quote and invoice?","acceptedAnswer":{"@type":"Answer","text":"Yes — email the dates, headcount and sites. Corporate invoicing can be arranged through our sister company."}},{"@type":"Question","name":"Is transport available for night or early shifts?","acceptedAnswer":{"@type":"Answer","text":"Yes, bookings run 24/7. Pre-book early pickups so the car is planned the evening before."}},{"@type":"Question","name":"Can I cancel?","acceptedAnswer":{"@type":"Answer","text":"Yes, free of charge up to 24 hours before pickup."}}]}1b:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$26"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/locations/jubail#webpage\",\"url\":\"https://taxisaudiarabia.com/locations/jubail\",\"speakable\":{\"@type\":\"SpeakableSpecif