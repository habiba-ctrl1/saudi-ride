75:["$","details","Can families travel with luggage?",{"className":"group","open":false,"children":[["$","summary",null,{"className":"flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-[0.95rem] font-semibold text-[#1C1C1C] transition-colors hover:bg-[#F9FAFB] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#16A34A] md:px-6 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"font-semibold","children":"Can families travel with luggage?"}],["$","$L32",null,{"ref":"$undefined","iconNode":"$48:props:children:1:props:children:0:props:children:0:props:children:1:props:iconNode","className":"lucide-chevron-down h-4 w-4 shrink-0 text-[#16A34A] transition-transform duration-200 group-open:rotate-180","aria-hidden":"true"}]]}],["$","p",null,{"className":"px-5 pb-5 text-sm leading-relaxed text-[#4B5563] md:px-6","children":"Yes. A sedan fits one to three people with normal luggage. A GMC or full-size SUV, or a Hyundai Staria, suits families with more luggage. A Hiace van or coaster suits larger groups. Tell us passengers and large bags and we confirm the vehicle when we quote."}]]}]
