27:T43e,{"@context":"https://schema.org","@type":"ItemList","numberOfItems":8,"itemListElement":[{"@type":"ListItem","position":1,"name":"Tabuk to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-amman"},{"@type":"ListItem","position":2,"name":"NEOM to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/neom-to-amman"},{"@type":"ListItem","position":3,"name":"AlUla to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/alula-to-amman"},{"@type":"ListItem","position":4,"name":"Madinah to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/medinah-to-amman"},{"@type":"ListItem","position":5,"name":"Amman, Jordan to Madinah","url":"https://taxisaudiarabia.com/routes/amman-to-madinah"},{"@type":"ListItem","position":6,"name":"Amman, Jordan to Tabuk","url":"https://taxisaudiarabia.com/routes/amman-to-tabuk"},{"@type":"ListItem","position":7,"name":"Amman, Jordan to NEOM","url":"https://taxisaudiarabia.com/routes/amman-to-neom"},{"@type":"ListItem","position":8,"name":"Amman, Jordan to AlUla","url":"https://taxisaudiarabia.com/routes/amman-to-alula"}]}28:T69b,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I book a private car with a driver in Jordan?","acceptedAnswer":{"@type":"Answer","text":"Yes. Through our partner in Jordan we arrange pre-booked private cars with a professional driver, for example Queen Alia International Airport (AMM) to your Amman hotel, or Amman to Petra, Wadi Rum or Aqaba. The fare is fixed and confirmed on WhatsApp before you travel."}},{"@type":"Question","name":"Is this a local Amman taxi service?","acceptedAnswer":{"@type":"Answer","text":"No. These are pre-booked private transfers arranged through our partner in Jordan at a fixed fare agreed in advance, not street-hail taxis."}},{"@type":"Question","name":"How far is Petra from Amman?","acceptedAnswer":{"@type":"Answer","text":"About 230 km by road, according to Visit Jordan, the official Jordan Tourism Board site. Plan around three hours of driving each way, plus time at the site."}},{"@type":"Question","name":"How far is Petra from Aqaba?","acceptedAnswer":{"@type":"Answer","text":"About 125–130 km by road, around two hours, according to Visit Jordan."}},{"@type":"Question","name":"Can you collect me from Queen Alia International Airport?","acceptedAnswer":{"@type":"Answer","text":"Yes. Send your flight number and we plan the pickup around your arrival. Meet & greet is provided at airport arrivals."}},{"@type":"Question","name":"Can I combine a Saudi Arabia to Jordan transfer with Jordan transfers?","acceptedAnswer":{"@type":"Answer","text":"Yes. Book the cross-border leg from Tabuk, NEOM, AlUla or Madinah together with your Jordan transfers and we quote both in one written offer."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Taxi Service in Amman\",\"description\":\"Book a private, pre-booked car in Jordan through our partner in Jordan: Queen Alia International Airport (AMM) to your Amman hotel, Amman to Petra, Wadi Rum or Aqaba, and onward from Aqaba. Combine it with a Saudi–Jordan cross-border leg from Tabuk, NEOM, AlUla or Madinah and receive one written quote for both. These are pre-booked private transfers with a professional driver at a fixed fare agreed before you travel, not street-hail taxis. Share your route, dates and passenger count on WhatsApp.\",\"serviceType\":\"Local Taxi & Car Service\",\"url\":\"https://taxisaudiarabia.com/locations/amman\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Amman\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":31.9454,\"longitude\":35.9284}}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"