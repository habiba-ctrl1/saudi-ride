assName":"text-[#FACC15]","children":"Makkah"}]]}],["$","p",null,{"className":"mt-5 max-w-xl text-base leading-relaxed text-white/85 md:text-lg","children":"Pre-booked private cars for Umrah travellers, families, couples, groups and companies — Jeddah Airport, Madinah, Taif, your Makkah hotel, Ziyarat, or a chauffeur by the hour. One fare, agreed before you book."}],"$L34","$L35"]}]}]]}]
2b:["$","section",null,{"aria-labelledby":"answer-heading","className":"section-container relative z-10 -mt-8 max-w-6xl","children":["$","div",null,{"className":"rounded-[2rem] border border-[#16A34A]/15 bg-white p-6 shadow-[0_30px_70px_-45px_rgba(15,23,42,0.5)] md:p-9","children":[["$","div",null,{"className":"grid gap-6 md:grid-cols-[auto_1fr] md:gap-8","children":[["$","p",null,{"id":"answer-heading","className":"text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A] md:w-32 md:pt-1","children":"The short answer"}],["$","p",null,{"id":"speakable-summary","className":"text-[1.05rem] leading-relaxed text-[#1F2937] md:text-lg","children":["Taxi Saudi Arabia arranges pre-booked private transport in Makkah through a vetted partner network: transfers between Jeddah Airport (JED) and your Makkah hotel (about ",80," km), Makkah–Madinah (",430," km), Makkah–Jeddah (",85," km) and Makkah–Taif (",90," km) trips, hotel pickup and drop-off, Ziyarat transportation and private drivers by the hour. You choose the vehicle, the fare is agreed before booking, and cancellation is free up to 24 hours before pickup."]}]]}],["$","div",null,{"className":"mt-7","children":["$","dl",null,{"className":"grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-[#16A34A]/15 bg-[#16A34A]/15 md:grid-cols-4","children":[["$","div","Makkah → JED Airport",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Makkah → JED Airport"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"80 km · ~1 hr"}]]}],["$","div","Makkah → Madinah",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Makkah → Madinah"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"430 km · ~4 hr"}]]}],["$","div","Makkah → Taif",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Makkah → Taif"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"90 km · ~1 hr 10 min"}]]}],["$","div","Flights",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Flights"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"We track your flight"}]]}],["$","div","Drivers",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Drivers"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"English- & Arabic-speaking"}]]}],["$","div","Cancellation",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Cancellation"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Free up to 24 hours before"}]]}],["$","div","Payment",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Payment"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Cash to the driver or bank transfer"}]]}],["$","div","Companies",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Companies"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Invoicing via our sister company"}]