2d:T659,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I get from Tabuk Airport to NEOM?","acceptedAnswer":{"@type":"Answer","text":"By pre-booked private car: about 180 km (~2 hr 45 min). We track your flight, meet you at arrivals and drive you to the NEOM destination you give us."}},{"@type":"Question","name":"Which places in NEOM can you drive to?","acceptedAnswer":{"@type":"Answer","text":"Our confirmed points are NEOM Bay / Sharma, Magna and Oxagon. For any other NEOM site, send the location and we confirm whether a transfer is possible before quoting; site access is arranged by your host."}},{"@type":"Question","name":"Can I go from NEOM to Aqaba in Jordan?","acceptedAnswer":{"@type":"Answer","text":"Yes, about 235 km via the Al Durrah crossing. The vehicle's border fees are included; passengers bring their own passports and visas. A cheaper option drops you at the Saudi side of the border."}},{"@type":"Question","name":"Is NEOM car rental the same as this?","acceptedAnswer":{"@type":"Answer","text":"We do not rent self-drive cars — every booking is a car with a professional driver. The fare for the car and driver is agreed before you travel."}},{"@type":"Question","name":"Can my company get a written quote?","acceptedAnswer":{"@type":"Answer","text":"Yes — email the dates, people and sites. Corporate invoicing can be arranged through our sister company."}},{"@type":"Question","name":"Is transport available 24/7?","acceptedAnswer":{"@type":"Answer","text":"Yes. Pre-book night and early-morning airport legs so the car is planned in advance."}}]}28:["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2d"}}]
