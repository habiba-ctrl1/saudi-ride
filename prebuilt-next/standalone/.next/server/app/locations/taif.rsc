[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"JED Airport → Taif"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"180 km · ~2 hr 10 min"}]]}],["$","div","Riyadh ↔ Taif",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Riyadh ↔ Taif"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"785 km · ~7 hr 50 min"}]]}],["$","div","Roads up",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Roads up"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Al Hada or Al Sail"}]]}],["$","div","Not offered",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Not offered"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Self-drive car rental"}]]}]]}]}]]}]}]
2b:["$","div",null,{"className":"section-container max-w-6xl space-y-20 py-20 md:space-y-28 md:py-28","children":[["$","section",null,{"aria-labelledby":"trip-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"Start here"}],["$","h2",null,{"id":"trip-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"Which Taif trip is yours?"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[#6B7280]","children":"Most Taif bookings are one of these. Pick yours to see what to send us."}]]}],["$","$L36",null,{"trips":[{"id":"makkah","icon":"route","label":"Makkah ↔ Taif","short":"90 km","answer":"About 90 km (~1 hr 10 min) between your Makkah hotel and Taif, on Al Hada or Al Sail. One-way, or a timed return the same day.","send":["Makkah hotel","Taif address","Date and time","Passengers and bags"],"href":"/routes/makkah-to-taif","linkLabel":"Makkah to Taif private car","waPrefill":"Salam! Makkah ↔ Taif.\n• From: \n• To: \n• Date & time: \n• Passengers & luggage: \n(ref: taif-hub)"},{"id":"jeddah","icon":"route","label":"Jeddah ↔ Taif","short":"170 km","answer":"About 170 km (~2 hr) from a Jeddah hotel or home up to Taif. Non-Muslim passengers are driven on the road that bypasses Makkah — tell us when you book.","send":["Jeddah address","Taif address","Date and time","Passengers and bags"],"href":"/routes/jeddah-to-taif","linkLabel":"Jeddah to Taif private car","waPrefill":"Salam! Jeddah ↔ Taif.\n• From: \n• To: \n• Date & time: \n• Passengers & luggage: \n(ref: taif-hub)"},{"id":"jed","icon":"plane","label":"Jeddah Airport → Taif","short":"Meet & greet","answer":"Land at JED and go straight to Taif, about 180 km. We track your flight; meet & greet at arrivals and 15–30 minutes free waiting.","send":["Flight number","Taif address","Passengers and bags"],"href":"/routes/jeddah-airport-to-taif","linkLabel":"JED to Taif airport pickup","waPrefill":"Salam! Jeddah Airport → Taif.\n• Flight: \n• Taif address: \n• Date: \n• Passengers & luggage: \n(ref: taif-hub)"},{"id":"tif","icon":"plane","label":"Taif Airport (TIF)","short":"Flight tracked","answer":"Arrivals and departures at Taif Regional Airport to Taif hotels, Al Hada, Al Shafa or Makkah. We track your flight; 15–30 minutes free waiting.","send":["Flight number","Destination","Passengers"],"href":"/airports/taif-regional","linkLabel":"Taif airport transfers","waPrefill":"Salam! Taif Airport (TIF) pickup.\n• Flight: \n• Destination: \n• Date: \n• Passengers: \n(ref: taif-hub)"},{"id":"daytrip","icon":"landmark","label":"Day trip to Taif","short":"Timed return","answer":"From Makkah or Jeddah to Al Hada, Al Shafa and the rose farms, then back the same evening. The car waits between stops; the day is quoted as one fare.","send":["Pickup city and hotel","Stops you want","Return time","Passengers"],"href":"/routes/makkah-hotels-to-taif-resorts","linkLabel":"Makkah hotels to Taif resorts","waPrefill":"Salam! Taif day trip.\n• Pickup (Makkah / Jeddah hotel): \n• Stops: \n• Return time: \n• Passengers: \n(ref: taif-hub)"},{"id":"riyadh","icon":"route","label":"Riyadh ↔ Taif","short":"785 km","answer":"About 785 km on Highway 40, roughly ~7 hr 50 min of driving before stops — the classic summer drive for Riyadh families, both ways.","send":["Pickup address","Drop-off","Date","Passengers and bags"],"href":"/routes/riyadh-to-taif","linkLabel":"Riyadh to Taif private car","waPrefill":"Salam! Riyadh ↔ Taif.\n• From: \n• To: \n• Date: \n• Passengers & luggage: \n(ref: taif-hub)"},{"id":"hourly","icon":"clock","label":"Driver for the day","short":"Hours or full day","answer":"One car that stays with you in Taif — Shubra Palace, the souqs, Al Rudaf Park, Al Hada, Al Shafa — with the fare for the day agreed first.","send":["Date and start time","Hours","Stops","Passengers"],"href":"#quote","linkLabel":"Request a driver","waPrefill":"Salam! Driver for the day in Taif.\n• Date & start time: \n• Hours / full day: \n• Stops: \n• Passengers: \n(ref: taif-hub)"},{"id":"corporate","icon":"briefcase","label":"Companies & groups","short":"Written quote","answer":"Delegations, government visits and family groups can be quoted in writing for several cars. Corporate invoicing can be arranged through our sister company.","send":["Company","Dates","Headcount","Trips"],"href":"/services/corporate","linkLabel":"Corporate transportation","waPrefill":"Salam! Corporate / group transport in Taif.\n• Company: \n• Dates & trips: \n• Headcount: \n(ref: taif-hub)"}],"whatsappLink":"https://wa.me/966539388072"}]]}],"$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40"]}]
