44:["$","section",null,{"aria-labelledby":"timing-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"Plan your timing"}],["$","h2",null,{"id":"timing-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"What changes journey times in Jeddah"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[#6B7280]","children":"Drive times shift with the season, the hour and the day of the week. These are the things that move them."}]]}],["$","div",null,{"data-stagger":true,"className":"grid grid-cols-1 gap-px overflow-hidden rounded-3xl border border-[#E5E7EB] bg-[#E5E7EB] sm:grid-cols-2 lg:grid-cols-3","children":[["$","div","Night arrivals at JED",{"className":"bg-white p-6","children":[["$","span",null,{"className":"font-heading text-sm font-bold tabular-nums text-[#16A34A]","children":"01"}],["$","h3",null,{"className":"mt-2 font-heading text-base font-bold","children":"Night arrivals at JED"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Many international flights land late at night or before dawn. Transfers run 24/7 — book ahead so the car is waiting rather than searched for at 3 am."}]]}],["$","div","Umrah peaks and Ramadan",{"className":"bg-white p-6","children":[["$","span",null,{"className":"font-heading text-sm font-bold tabular-nums text-[#16A34A]","children":"02"}],["$","h3",null,{"className":"mt-2 font-heading text-base font-bold","children":"Umrah peaks and Ramadan"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Jeddah–Makkah traffic and airport crowds build sharply in Ramadan and peak Umrah weeks. Leave extra time for departures, and book vans and SUVs early in those weeks."}]]}],["$","div","Corniche evenings",{"className":"bg-white p-6","children":[["$","span",null,{"className":"font-heading text-sm font-bold tabular-nums text-[#16A34A]","children":"03"}],["$","h3",null,{"className":"mt-2 font-heading text-base font-bold","children":"Corniche evenings"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"The waterfront is busiest on Thursday and Friday evenings. A fixed pickup time and point saves circling the promenade."}]]}],["$","div","Old town access",{"className":"bg-white p-6","children":[["$","span",null,{"className":"font-heading text-sm font-bold tabular-nums text-[#16A34A]","children":"04"}],["$","h3",null,{"className":"mt-2 font-heading text-base font-bold","children":"Old town access"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Cars cannot drive through the historic core of Al-Balad. Drop-off and pickup happen at its edge — agree the exact point in advance."}]]}],["$","div","Summer heat",{"className":"bg-white p-6","children":[["$","span",null,{"className":"font-heading text-sm font-bold tabular-nums text-[#16A34A]","children":"05"}],["$","h3",null,{"className":"mt-2 font-heading text-base font-bold","children":"Summer heat"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"From late spring to autumn, plan outdoor sightseeing for early morning and after sunset, with the car close by between stops."}]]}],["$","div","Long drives",{"className":"bg-white p-6","children":[["$","span",null,{"className":"font-heading text-sm font-bold tabular-nums text-[#16A34A]","children":"06"}],["$","h3",null,{"className":"mt-2 font-heading text-base font-bold","children":"Long drives"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Madinah is about ~4 hr of driving and Taif climbs a steep escarpment road. Tell the driver your preferred prayer and rest stops at the start."}]]}]]}]]}]
45:["$","section",null,{"aria-labelledby":"visitor-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"First time in Jeddah?"}],["$","h2",null,{"id":"visitor-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"What international visitors usually ask"}],"$undefined"]}],["$","div",null,{"className":"grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2","children":[["$","div","How do I get from Jeddah airport to Makkah?",{"className":"border-l-2 border-[#16A34A]/25 pl-5","children":[["$","h3",null,{"className":"font-heading text-base font-bold text-[#1C1C1C]","children":"How do I get from Jeddah airport to Makkah?"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"The simplest way is a pre-booked private car from your JED terminal to your Makkah hotel — about 80 km and ~1 hr, with your bags in the same vehicle. The Haramain train from the Terminal 1 station is the alternative if you travel light and are happy to transfer at Makkah station."}]]}],["$","div","Which terminal will I arrive at?",{"className":"border-l-2 border-[#16A34A]/25 pl-5","children":[["$","h3",null,{"className":"font-heading text-base font-bold text-[#1C1C1C]","children":"Which terminal will I arrive at?"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"JED has Terminal 1, the North Terminal and, in pilgrimage season, the Hajj Terminal. Your airline confirms which; send us the flight number and we plan the pickup for that terminal."}]]}],["$","div","Can I go straight from the airport to Madinah?",{"className":"border-l-2 border-[#16A34A]/25 pl-5","children":[["$","h3",null,{"className":"font-heading text-base font-bold text-[#1C1C1C]","children":"Can I go straight from the airport to Madinah?"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Yes. JED Airport to Madinah is about 410 km by road. Many families do this on arrival day rather than stopping in Jeddah — tell us if you want a meal or prayer stop on the way."}]]}],["$","div","What should I book for a day in Jeddah?",{"className":"border-l-2 border-[#16A34A]/25 pl-5","children":[["$","h3",null,{"className":"font-heading text-base font-bold text-[#1C1C1C]","children":"What should I book for a day in Jeddah?"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"If you have three or more stops — Al-Balad, the Corniche, a mall, a restaurant — book a car by the hour. For a single trip, book a one-way transfer and a timed return."}]]}],["$","div","Can I travel with a lot of luggage?",{"className":"border-l-2 border-[#16A34A]/25 pl-5","children":[["$","h3",null,{"className":"font-heading text-base font-bold text-[#1C1C1C]","children":"Can I travel with a lot of luggage?"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Yes. Tell us the number of large cases when you book. Full-size SUVs, vans and coasters are the usual choice for Umrah families with luggage and zamzam."}]]}],["$","div","How do I pay?",{"className":"border-l-2 border-[#16A34A]/25 pl-5","children":[["$","h3",null,{"className":"font-heading text-base font-bold text-[#1C1C1C]","children":"How do I pay?"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#4B5563]","children":"Cash to the driver or bank transfer. An electronic receipt is available on request."}]]}]]}],["$","div",null,{"className":"mt-14 rounded-3xl border border-[#16A34A]/15 bg-[#F0FDF4] p-6 md:p-8","children":[["$","h3",null,{"className":"font-heading text-lg font-bold","children":"From request to ride"}],"$L5f"]}]]}]
