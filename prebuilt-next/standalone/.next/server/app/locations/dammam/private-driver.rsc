2a:["$","section",null,{"className":"section-container relative z-10 -mt-8 max-w-6xl","aria-label":"Summary","children":["$","div",null,{"className":"rounded-[2rem] border border-[#16A34A]/15 bg-white p-6 shadow-[0_30px_70px_-45px_rgba(15,23,42,0.5)] md:p-9","children":[["$","p",null,{"id":"speakable-summary","className":"text-[1.02rem] leading-relaxed text-[#1F2937] md:text-[1.1rem]","children":"A private driver in the Eastern Province is one car and chauffeur for the hours you book, moving with you between Dammam, Al Khobar and Dhahran — a site visit in the morning, a meeting on the Khobar side after lunch, dinner on the Corniche. The driver waits while you are inside, so you never re-book a ride. The 15–30 minutes free-waiting rule is for one-way transfers; on hourly hire, waiting is what the hours are for."}],["$","div",null,{"className":"mt-7","children":["$","dl",null,{"className":"grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-[#16A34A]/15 bg-[#16A34A]/15 md:grid-cols-4","children":[["$","div","Covers",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Covers"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Dammam · Al Khobar · Dhahran"}]]}],["$","div","Typical day",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"Typical day"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"Site visit, meetings, airport leg"}]]}],["$","div","DMM → Dhahran",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"DMM → Dhahran"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children"