2a:["$","section",null,{"aria-labelledby":"answer-heading","className":"section-container relative z-10 -mt-8 max-w-6xl","children":["$","div",null,{"className":"rounded-[2rem] border border-[#16A34A]/15 bg-white p-6 shadow-[0_30px_70px_-45px_rgba(15,23,42,0.5)] md:p-9","children":[["$","div",null,{"className":"grid gap-6 md:grid-cols-[auto_1fr] md:gap-8","children":[["$","p",null,{"id":"answer-heading","className":"text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A] md:w-32 md:pt-1","children":"The short answer"}],["$","p",null,{"id":"speakable-summary","className":"text-[1.05rem] leading-relaxed text-[#1F2937] md:text-lg","children":["Taxi Saudi Arabia arranges pre-booked private transport in Dammam, Al Khobar and Dhahran through a vetted partner network: King Fahd International Airport (DMM) pickups with flight tracking, one-way and return rides inside the metro, private drivers by the hour, Bahrain over the King Fahd Causeway (Dammam to Manama about ",70," km), Doha via Salwa (",400," km) and Riyadh (",410," km). The fare is agreed before booking and cancellation is free up to 24 hours before pickup."]}]]}],["$","div",null,{"className":"mt-7","children":["$","dl",null,{"className":"grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-[#16A34A]/15 bg-[#16A34A]/15 md:grid-cols-4","children":[["$","div","DMM Airport → Dhahran",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"DMM Airport → Dhahran"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","children":"50 km · ~40 min"}]]}],["$","div","DMM Airport → Jubail",{"className":"bg-white p-4 md:p-5","children":[["$","dt",null,{"className":"text-[0.65rem] font-bold uppercase tracking-[0.16em] text-[#15803D]","children":"DMM Airport → Jubail"}],["$","dd",null,{"className":"mt-1.5 text-[0.85rem] font-semibold leading-snug text-[#1C1C1C]","chi