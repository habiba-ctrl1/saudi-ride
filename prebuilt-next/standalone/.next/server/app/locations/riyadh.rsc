61:["$","details","Can I travel from Riyadh to Dammam, Makkah or Jeddah by private car?",{"className":"group","open":false,"children":[["$","summary",null,{"className":"flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-[0.95rem] font-semibold text-[#1C1C1C] transition-colors hover:bg-[#F9FAFB] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#16A34A] md:px-6 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"font-semibold","children":"Can I travel from Riyadh to Dammam, Makkah or Jeddah by private car?"}],["$","$L33",null,{"ref":"$undefined","iconNode":"$44:props:children:1:props:children:0:props:children:0:props:children:1:props:iconNode","className":"lucide-chevron-down h-4 w-4 shrink-0 text-[#16A34A] transition-transform duration-200 group-open:rotate-180","aria-hidden":"true"}]]}],["$","p",null,{"className":"px-5 pb-5 text-sm leading-relaxed text-[#4B5563] md:px-6","children":"Yes, door to door. Riyadh to Dammam is about 410 km (~4 hr), Riyadh to Makkah about 870 km (~8 hr) and Riyadh to Jeddah about 950 km (~9 hr). Rest and prayer stops are made on request."}]]}]
62:["$","details","Can I go from Riyadh to Bahrain, Qatar, the UAE or Kuwait by car?",{"className":"group","open":false,"children":[["$","summary",null,{"className":"flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-[0.95rem] font-semibold text-[#1C1C1C] transition-colors hover:bg-[#F9FAFB] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#16A34A] md:px-6 [&::-webkit-details-marker]:hidden","children":[["$","h3",null,{"className":"font-semibold","children":"Can I go from Riyadh to Bahrain, Qatar, the UAE or Kuwait by car?"}],["$","$L33",null,{"ref":"$undefined","iconNode":"$44:props:children:1:props:children:0:props:children:0:props:children:1:props:iconNode","className":"lucide-chevron-down h-4 w-4 shrink-0 text-[#16A34A] transition-transform duration-200 group-open:rotate-180","aria-hidden":"true"}]]}],["$","p",null,{"className":"px-5 pb-5 text-sm leading-relaxed text-[#4B5563] md:px-6","children":"Yes. Pre-booked cross-border cars run from Riyadh to Manama (about 450 km via the King Fahd Causeway), Doha, Abu Dhabi, Dubai and Kuwait City. Passengers need their own valid passports and any visas required for entry."}]]}]
