2a:["$","div",null,{"className":"section-container max-w-6xl space-y-20 py-20 md:space-y-28 md:py-28","children":[["$","section",null,{"aria-labelledby":"trip-heading","children":[["$","div",null,{"className":"mb-8 md:mb-10 max-w-3xl","children":[["$","p",null,{"className":"mb-3 text-[0.7rem] font-bold uppercase tracking-[0.2em] text-[#16A34A]","children":"Start here"}],["$","h2",null,{"id":"trip-heading","className":"font-heading text-[1.75rem] font-bold leading-tight md:text-[2.25rem] text-[#1C1C1C]","children":"Which Yanbu trip is yours?"}],["$","p",null,{"className":"mt-3 text-[0.95rem] leading-relaxed text-[#6B7280]","children":"Yanbu bookings are mostly the Madinah road, the airport and the Industrial City. Pick one."}]]}],["$","$L33",null,{"trips":[{"id":"madinah","icon":"route","label":"Yanbu ↔ Madinah","short":"240 km","answer":"About 240 km (~2 hr 50 min) — a common road for pilgrims and families. Door to door with prayer and rest stops.","send":["Pickup in Yanbu","Madinah hotel","Date and time","Passengers and bags"],"href":"/routes/madinah-to-yanbu","linkLabel":"Madinah ↔ Yanbu private transfer","waPrefill":"Salam! Yanbu ↔ Madinah.\n• From: \n• To: \n• Date & time: \n• Passengers & luggage: \n(ref: yanbu-hub)"},{"id":"jeddah","icon":"route","label":"Yanbu ↔ Jeddah","short":"330 km","answer":"About 330 km (~3 hr) down the Red Sea coast — to a Jeddah hotel or King Abdulaziz Airport.","send":["Pickup","Jeddah address or airport","Date and time","Passengers"],"href":"/routes/jeddah-to-yanbu","linkLabel":"Jeddah ↔ Yanbu","waPrefill":"Salam! Yanbu ↔ Jeddah.\n• From: \n• To: \n• Date & time: \n• Passengers: \n(ref: yanbu-hub)"},{"id":"makkah","icon":"route","label":"Yanbu ↔ Makkah","short":"400 km","answer":"About 400 km (~3 hr 40 min) for Umrah travellers. Tell us if you want a stop on the way.","send":["Pickup","Makkah hotel","Date","Passengers"],"href":"/routes/makkah-to-yanbu","linkLabel":"Makkah ↔ Yanbu","waPrefill":"Salam! Yanbu ↔ Makkah.\n• From: \n• To: \n• Date: \n• Passengers: \n(ref: yanbu-hub)"},{"id":"airport","icon":"plane","label":"Yanbu Airport pickups","short":"Flight tracked","answer":"Arrivals and departures at Yanbu airport (YNB) to Yanbu Al-Bahr or the Industrial City. We track the flight; 15–30 minutes free waiting.","send":["Flight number","Hotel or site","Passengers"],"href":"#quote","linkLabel":"Request an airport pickup","waPrefill":"Salam! Yanbu Airport pickup.\n• Flight: \n• Hotel / site: \n• Date & time: \n• Passengers: \n(ref: yanbu-hub)"},{"id":"industrial","icon":"briefcase","label":"Industrial City visits","short":"Site and gate name","answer":"Yanbu Al-Bahr and the Industrial City are separate areas — send which one, plus the company and gate for site visits. Access is arranged by your host.","send":["Company and site","Gate","Date and time","Passengers"],"href":"#local","linkLabel":"Yanbu areas explained","waPrefill":"Salam! Yanbu Industrial City visit.\n• Company / site: \n• Gate: \n• Date & time: \n• Passengers: \n(ref: yanbu-hub)"},{"id":"coast","icon":"landmark","label":"Beach & diving days","short":"Timed return","answer":"Drop at the beach or dive centre with a timed return — tell us about equipment so the car has room.","send":["Pickup","Beach / dive centre","Times there and back","Equipment"],"href":"#quote","linkLabel":"Request a beach day","waPrefill":"Salam! Yanbu beach / diving day.\n• Pickup: \n• Beach / dive centre: \n• Times: \n• Equipment: \n(ref: yanbu-hub)"},{"id":"hourly","icon":"clock","label":"Driver for the day","short":"Hours or full day","answer":"One car that waits between meetings, shopping and family visits in Yanbu, with the fare for the day agreed first.","send":["Date","Hours","Stops","Passengers"],"href":"#quote","linkLabel":"Request a driver","waPrefill":"Salam! Driver for the day in Yanbu.\n• Date & start time: \n• Hours: \n• Stops: \n• Passengers: \n(ref: yanbu-hub)"},{"id":"corporate","icon":"briefcase","label":"Companies & crews","short":"Written quote","answer":"Rotations, site weeks and visiting teams can be quoted in writing. Corporate invoicing can be arranged through our sister company.","send":["Company","Dates","Headcount","Sites"],"href":"/services/corporate","linkLabel":"Corporate transportation","waPrefill":"Salam! Corporate transport in Yanbu.\n• Company: \n• Dates & trips: \n• Headcount: \n(ref: yanbu-hub)"}],"whatsappLink":"https://wa.me/966539388072"}]]}],"$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}]
