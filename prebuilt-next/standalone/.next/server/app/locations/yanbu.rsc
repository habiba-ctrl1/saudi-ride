26:T532,{"@context":"https://schema.org","@type":"TaxiService","@id":"https://taxisaudiarabia.com/locations/yanbu#service","name":"Private taxi, transfers & chauffeur service in Yanbu","description":"Pre-booked private cars with drivers in Yanbu: airport pickups, Yanbu Al-Bahr and Industrial City trips, and transfers to Madinah, Jeddah and Makkah, through a vetted partner network.","url":"https://taxisaudiarabia.com/locations/yanbu","provider":{"@type":"Organization","name":"Taxi Saudi Arabia","url":"https://taxisaudiarabia.com"},"areaServed":{"@type":"City","name":"Yanbu","geo":{"@type":"GeoCoordinates","latitude":24.0895,"longitude":38.0618}},"availableLanguage":["English","Arabic"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Yanbu transport services","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Yanbu ↔ Madinah","url":"https://taxisaudiarabia.com/routes/madinah-to-yanbu"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Yanbu ↔ Jeddah","url":"https://taxisaudiarabia.com/routes/jeddah-to-yanbu"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Yanbu ↔ Makkah","url":"https://taxisaudiarabia.com/routes/makkah-to-yanbu"}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Companies & crews","url":"https://taxisaudiarabia.com/services/corporate"}}]}}27:T533,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How far is Yanbu from Madinah by private car?","acceptedAnswer":{"@type":"Answer","text":"About 240 km — roughly ~2 hr 50 min. A private car goes hotel to hotel with prayer and rest stops on request."}},{"@type":"Question","name":"Can I get a car from Yanbu to Jeddah?","acceptedAnswer":{"@type":"Answer","text":"Yes, about 330 km along the Red Sea coast, to a Jeddah address or the airport."}},{"@type":"Question","name":"Do you cover both Yanbu city and the Industrial City?","acceptedAnswer":{"@type":"Answer","text":"Yes. They are separate areas, so tell us which one when you book; for site visits add the company and gate."}},{"@type":"Question","name":"Is this car rental at Yanbu airport?","acceptedAnswer":{"@type":"Answer","text":"We do not rent self-drive cars — every booking is a car with a professional driver. We meet you at arrivals and drive you where you need to go."}},{"@type":"Question","name":"Can my company be invoiced?","acceptedAnswer":{"@type":"Answer","text":"Yes. Corporate invoicing can be arranged through our sister company."}},{"@type":"Question","name":"Is transport available 24/7?","acceptedAnswer":{"@type":"Answer","text":"Yes. Pre-book early and late trips so the car is planned in advance."}}]}1b:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$26"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/locations/yanbu#webpage\",\"url\":\"https://taxisaudiarabia.com/locations/yanbu\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ItemList\",\"numberOfItems\":3,\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Madinah → Yanbu\",\"url\":\"https://taxisaudiarabia.com/routes/madinah-to-yanbu\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Jeddah → Yanbu\",\"url\":\"https://taxisaudiarabia.com/routes/jeddah-to-yanbu\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Makkah → Yanbu\",\"url\":\"https://taxisaudiarabia.com/routes/makkah-to-yanbu\"}]}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}]],"$L28","$L29","$L2a","$L2b"]}]
