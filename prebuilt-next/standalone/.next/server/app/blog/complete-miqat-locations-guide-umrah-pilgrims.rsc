n your ",["$","strong","strong-2",{"children":"route"}],", not your nationality."]}],"\n",["$","p","p-1",{"children":["If you live or are staying ","$L30"," the Miqat boundary — for example in Jeddah — the rules are different again (see the Jeddah section below)."]}],"\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54"]}],"$L55","$L56"]}],"$L57"]}]}]
