37:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Evening"}]," is the most popular time: cooler temperatures, the lit-up old town, and dinner at Bujairi Terrace."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Late morning on a weekday"}]," is quieter if you want photographs or a museum visit without the crowds."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Summer middays"}]," are very hot; plan outdoor walking for the early morning or after dark."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Weekends and event nights"}]," are the busiest — book your car in advance and agree a pickup point."]}],"\n"]}]
