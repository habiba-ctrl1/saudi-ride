2c:["$","div",null,{"className":"section-container mt-10 max-w-6xl md:mt-12","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-14","children":[["$","article",null,{"className":"min-w-0","children":[["$","div",null,{"className":"blog-quick","children":[["$","p",null,{"className":"blog-quick-label","children":[["$","$L26",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5","key":"1gvzjb"}],["path",{"d":"M9 18h6","key":"x1upvd"}],["path",{"d":"M10 22h4","key":"ceow96"}]],"className":"lucide-lightbulb h-4 w-4","aria-hidden":true}]," ","Quick answer"]}],["$","p",null,{"className":"blog-quick-text","children":"Diriyah sits on the north-west edge of Riyadh above Wadi Hanifa, a short drive from Olaya and KAFD. Most visitors go in the late afternoon or evening for At-Turaif and dinner at Bujairi Terrace. A private car is the simplest way: you are dropped at the visitor area and collected at a time you choose, with the fare agreed before booking."}]]}],["$","details",null,{"className":"blog-toc-mobile lg:hidden","children":[["$","summary",null,{"children":[["$","$L26",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 5h13","key":"1pao27"}],["path",{"d":"M13 12h8","key":"h98zly"}],["path",{"d":"M13 19h8","key":"c3s6r1"}],["path",{"d":"M3 10a2 2 0 0 0 2 2h3","key":"1npucw"}],["path",{"d":"M3 5v12a2 2 0 0 0 2 2h3","key":"x1gjn2"}]],"className":"lucide-list-tree h-4 w-4","aria-hidden":true}]," ","In this guide"]}],["$","ol",null,{"children":[["$","li","why-diriyah-is-worth-the-trip",{"children":["$","a",null,{"href":"#why-diriyah-is-worth-the-trip","children":"Why Diriyah is worth the trip"}]}],["$","li","where-diriyah-is-and-how-long-it-takes",{"children":["$","a",null,{"href":"#where-diriyah-is-and-how-long-it-takes","children":"Where Diriyah is, and how long it takes"}]}],["$","li","what-to-see",{"children":["$","a",null,{"href":"#what-to-see","children":"What to see"}]}],["$","li","when-to-go",{"children":["$","a",null,{"href":"#when-to-go","children":"When to go"}]}],["$","li","getting-there-your-options",{"children":["$","a",null,{"href":"#getting-there-your-options","children":"Getting there: your options"}]}],["$","li","making-a-day-of-it",{"children":["$","a",null,{"href":"#making-a-day-of-it","children":"Making a day of it"}]}],["$","li","practical-tips",{"children":["$","a",null,{"href":"#practical-tips","children":"Practical tips"}]}],["$","li","common-questions",{"children":["$","a",null,{"href":"#common-questions","children":"Common questions"}]}]]}]]}],["$","div",null,{"className":"tsa-prose blog-prose prose prose-lg max-w-none","children":[["$","h2","h2-0",{"id":"why-diriyah-is-worth-the-trip","children":"Why Diriyah is worth the trip"}],"\n",["$","p","p-0",{"children":["Diriyah was the seat of the first Saudi state, and its old quarter, ",["$","strong","strong-0",{"children":"At-Turaif"}],", is a UNESCO World Heritage Site — a restored district of mud-brick palaces and walls above Wadi Hanifa. Next to it, ",["$","strong","strong-1",{"children":"Bujairi Terrace"}]," is a restaurant and café quarter with views across to At-Turaif, and it is where most visitors end the evening. Together they are the most popular half-day outing from Riyadh for business visitors with a free evening, families and first-time tourists."]}],"\n",["$","h2","h2-1",{"id":"where-diriyah-is-and-how-long-it-takes","children":"Where Diriyah is, and how long it takes"}],"\n",["$","p","p-1",{"children":["Diriyah is on the ",["$","strong","strong-0",{"children":"north-west edge of Riyadh"}],", a short drive from the main hotel districts of Olaya and KAFD. The journey time depends far more on the time of day than on distance: Riyadh's evening rush and the traffic around popular weekend events can stretch a short drive considerably. If you have a dinner reservation, allow a margin and tell your driver what time you need to arrive."]}],"\n",["$","p","p-2",{"children":["From ",["$","strong","strong-0",{"children":"King Khalid International Airport (RUH)"}]," Diriyah is across the city, so it rarely makes sense as a stop on arrival day unless you land early and have time to spare."]}],"\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47"]}],"$L48","$L49"]}],"$L4a"]}]}]
