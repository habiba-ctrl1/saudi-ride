36:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Your passport"}]," with your entry visa."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"A fingerprint scan"}]," — registering a SIM to your identity with a fingerprint is mandatory in Saudi Arabia. The kiosk staff do it at the counter."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Payment"}]," by card or cash in Saudi riyals."]}],"\n"]}]
37:["$","p","p-3",{"children":"Activation is normally quick, but queues at the kiosks build up when several long-haul flights land together — common at night during the Umrah season."}]
