3b:["$","p","p-5",{"children":["You do not have to buy a SIM at the airport. Operator shops are easy to find in Jeddah, in the hotel districts of Makkah and Madinah, and in Riyadh's malls. The one thing to avoid is arriving with no data ",["$","strong","strong-0",{"children":"and"}]," no pre-arranged way of leaving the airport:"]}]
3c:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"Pre-book your transfer so you know who is collecting you and where."}],"\n",["$","li","li-1",{"children":"Save the booking confirmation and the driver's WhatsApp number offline (a screenshot is enough)."}],"\n",["$","li","li-2",{"children":"Use the airport Wi-Fi to send a quick message on landing."}],"\n"]}]
