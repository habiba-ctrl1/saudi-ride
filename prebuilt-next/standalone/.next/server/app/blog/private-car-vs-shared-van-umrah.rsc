32:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Families of four or more."}]," Splitting into two cars means two drivers, two arrival times and luggage spread between boots. One SUV or van keeps everyone together, and the total is often similar to two sedans."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Older or less mobile relatives."}]," More space to get in and out, room for a folded wheelchair, and a single smooth journey."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Heavy luggage."}]," On the way home especially — dates, gifts and Zamzam add up."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"The Madinah–Makkah leg."}]," Four hours plus the Miqat stop is where comfort matters most. See ",["$","$L25","a-0",{"href":"/blog/madinah-to-makkah-taxi-price-distance-time","children":"Madinah to Makkah by car"}],"."]}],"\n"]}]
