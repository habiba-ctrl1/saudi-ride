3a:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"Book the airport transfer and, if your hotel isn't close to the venue, a daily venue run."}],"\n",["$","li","li-1",{"children":"For meetings away from the venue, an hourly car avoids hunting for a ride at a crowded exit."}],"\n"]}]
