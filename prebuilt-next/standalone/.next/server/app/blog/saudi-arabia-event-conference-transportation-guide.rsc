37:["$","p","p-3",{"children":["Jeddah hosts exhibitions, motor shows and sporting events — for example the Jeddah International Motor Show at the Jeddah Center for Forums and Events, and the Formula E Jeddah E-Prix at the Jeddah Corniche Circuit. King Abdulaziz International Airport (JED) is about 20 km from the city. See ",["$","$L26","a-0",{"href":"/events/jeddah-event-transportation","children":"Jeddah event transportation"}],", the ",["$","$L26","a-1",{"href":"/events/jeddah-international-motor-show-transportation","children":"Jeddah International Motor Show page"}]," and ",["$","$L26","a-2",{"href":"/events/formula-e-jeddah-transportation","children":"Formula E Jeddah"}],"."]}]
