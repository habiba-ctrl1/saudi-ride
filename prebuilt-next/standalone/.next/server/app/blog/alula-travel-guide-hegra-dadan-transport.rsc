rong","strong-0",{"children":"By air"}]}],["$","td","td-1",{"children":"AlUla International Airport (ULH)"}],["$","td","td-2",{"children":"Short domestic flights; airport ~30 km from the resort area"}],["$","td","td-3",{"children":"Check current schedules; on-demand taxis at ULH are limited, so pre-book"}]]}],"$L2f","$L30","$L31"]}]]}]}],"\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a"]}],"$L4b","$L4c"]}],"$L4d"]}]}]
