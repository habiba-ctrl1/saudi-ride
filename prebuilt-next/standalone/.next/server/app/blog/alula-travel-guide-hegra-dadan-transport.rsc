33:["$","p","p-2",{"children":["AlUla International Airport (ULH), officially Prince Abdul Majeed bin Abdulaziz International Airport, is the fastest way in from Riyadh or Jeddah. The terminal is small and calm, but on-demand taxis are limited, so ",["$","strong","strong-0",{"children":"book your transfer before you fly"}]," and share your ",["$","strong","strong-1",{"children":"flight number"}]," — we check it before pickup. The ",["$","$L26","a-0",{"href":"/routes/alula-airport-to-resorts","children":"transfer to the resort area"}]," is about 30 km, around 30 minutes."]}]
34:["$","h3","h3-1",{"id":"by-road-from-madinah","children":"By road from Madinah"}]
35:["$","p","p-3",{"children":"Many visitors combine Madinah and AlUla: a few days in Madinah, then a three-hour drive north. A private car lets you leave when you like, stop for prayer and coffee, and arrive straight at your resort. In the other direction, AlUla to Madinah works well before a flight out of MED."}]
36:["$","h3","h3-2",{"id":"by-road-from-riyadh-or-jeddah","children":"By road from Riyadh or Jeddah"}]
37:["$","p","p-4",{"children":["Both are possible but long. From Riyadh, 1,050 km is a full day in the car; most travellers fly to ULH and use a car on the ground instead. From Jeddah, many break the journey with a night in Madinah. See our ",["$","$L26","a-0",{"href":"/blog/saudi-arabia-intercity-transfer-guide","children":"intercity transfer guide"}]," for planning long drives."]}]
