3c:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Private car with driver (most common):"}]," by the trip, by the hour or for a full day. You go at your own pace, and the car waits at each stop."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Official site shuttles and tours:"}]," Hegra and some other sites run their own transport from their visitor points."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Self-drive:"}]," possible, but you manage navigation and long, unlit roads at night."]}],"\n"]}]
