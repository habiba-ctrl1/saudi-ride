2c:["$","div",null,{"className":"section-container mt-10 max-w-6xl md:mt-12","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-14","children":[["$","article",null,{"className":"min-w-0","children":[["$","div",null,{"className":"blog-quick","children":[["$","p",null,{"className":"blog-quick-label","children":[["$","$L27",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5","key":"1gvzjb"}],["path",{"d":"M9 18h6","key":"x1upvd"}],["path",{"d":"M10 22h4","key":"ceow96"}]],"className":"lucide-lightbulb h-4 w-4","aria-hidden":true}]," ","Quick answer"]}],["$","p",null,{"className":"blog-quick-text","children":"You reach AlUla by flying into AlUla International Airport (ULH), about 30 km from the main resort area, or by road — about 330 km (around 3 hours) from Madinah, 700 km from Jeddah or 1,050 km from Riyadh. Once there, the sites are spread across a wide valley, so most visitors use a private car with a driver to link Hegra tour departures, Dadan, the Old Town and their resort."}]]}],["$","details",null,{"className":"blog-toc-mobile lg:hidden","children":[["$","summary",null,{"children":[["$","$L27",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 5h13","key":"1pao27"}],["path",{"d":"M13 12h8","key":"h98zly"}],["path",{"d":"M13 19h8","key":"c3s6r1"}],["path",{"d":"M3 10a2 2 0 0 0 2 2h3","key":"1npucw"}],["path",{"d":"M3 5v12a2 2 0 0 0 2 2h3","key":"x1gjn2"}]],"className":"lucide-list-tree h-4 w-4","aria-hidden":true}]," ","In this guide"]}],["$","ol",null,{"children":[["$","li","alula-in-brief",{"children":["$","a",null,{"href":"#alula-in-brief","children":"AlUla in brief"}]}],["$","li","getting-to-alula",{"children":["$","a",null,{"href":"#getting-to-alula","children":"Getting to AlUla"}]}],["$","li","getting-around-alula",{"children":["$","a",null,{"href":"#getting-around-alula","children":"Getting around AlUla"}]}],[