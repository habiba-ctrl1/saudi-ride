3d:["$","p","p-6",{"children":"When you book, include: flight numbers (we check them before pickup), hotel names, number of adults and children, children's ages if you need child seats, luggage count, any wheelchair, and whether you need a Miqat stop."}]
3e:["$","h2","h2-6",{"id":"groups-organised-by-an-agency-or-mosque","children":"Groups organised by an agency or mosque"}]
3f:["$","p","p-7",{"children":["For 20, 30 or more pilgrims, several vehicles or coasters can be timed to the same flight and hotel. Send the group list summary and itinerary and we return a written quote for the whole programme. See ",["$","$L26","a-0",{"href":"/services/group-transport","children":"group transport"}],"."]}]
40:["$","h2","h2-7",{"id":"payment-and-changes","children":"Payment and changes"}]
41:["$","p","p-8",{"children":["Each leg has a fixed fare agreed before booking. Pay ",["$","strong","strong-0",{"children":"cash to the driver or by bank transfer"}],"; ",["$","strong","strong-1",{"children":"electronic receipts"}]," are available on request. ",["$","strong","strong-2",{"children":"Free cancellation up to 24 hours before pickup"}]," — useful if flights change."]}]
42:["$","h2","h2-8",{"id":"common-questions","children":"Common questions"}]
43:["$","h3","h3-0",{"id":"which-airport-is-better-for-a-family-umrah-jeddah-or-madinah","children":"Which airport is better for a family Umrah, Jeddah or Madinah?"}]
44:["$","p","p-9",{"children":"Both work. Many families fly into one and out of the other. Madinah first is often gentler with children; Jeddah has more international flights."}]
45:["$","h3","h3-1",{"id":"can-we-keep-the-same-vehicle-for-the-whole-trip","children":"Can we keep the same vehicle for the whole trip?"}]
46:["$","p","p-10",{"children":"We size every leg to your group and can quote all of them together; tell us if keeping the same driver matters to you."}]
47:["$","h3","h3-2",{"id":"do-we-need-a-car-in-makkah-between-umrah-and-departure","children":"Do we need a car in Makkah between Umrah and departure?"}]
48:["$","p","p-11",{"children":"Usually only for Ziyarat and the airport. Most of the time in Makkah is spent between the hotel and the Haram, on foot."}]
