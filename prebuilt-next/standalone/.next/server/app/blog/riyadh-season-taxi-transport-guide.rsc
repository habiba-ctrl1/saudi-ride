32:["$","p","p-2",{"children":["Because Boulevard World and Boulevard City share an approach and parking, the roads around them are the busiest on event nights. See ",["$","$L26","a-0",{"href":"/locations/riyadh/boulevard","children":"Boulevard drop-offs and late pickups"}],"."]}]
