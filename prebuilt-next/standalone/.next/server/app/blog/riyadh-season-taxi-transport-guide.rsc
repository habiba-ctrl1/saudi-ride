34:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Traffic peaks twice"}]," — on the way in, around opening and show times, and on the way out, when big events end together."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Parking fills early"}]," at the most popular zones."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"App prices and wait times rise"}]," right when everyone is trying to leave."]}],"\n"]}]
35:["$","p","p-3",{"children":["A pre-booked car fixes the two things that matter: ",["$","strong","strong-0",{"children":"where"}]," you will be dropped off and collected, and ",["$","strong","strong-1",{"children":"when"}],". The fare is agreed before booking and doesn't change with demand on the night."]}]
36:["$","h2","h2-3",{"id":"flying-in-for-the-season","children":"Flying in for the Season"}]
37:["$","p","p-4",{"children":[["$","$L26","a-0",{"href":"/routes/riyadh-airport-to-city","children":"RUH to central Riyadh"}]," is about 35 km — around 30 minutes off-peak. Many visitors land, check in, and head to a zone the same evening. If that's your plan, book the airport transfer and the evening car together, and leave a margin for immigration and check-in. Share your ",["$","strong","strong-0",{"children":"flight number"}]," when you book and we check it before pickup. More in our ",["$","$L26","a-1",{"href":"/blog/riyadh-airport-ruh-taxi-guide","children":"RUH arrival guide"}],"."]}]
38:["$","h2","h2-4",{"id":"families-and-groups","children":"Families and groups"}]
39:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"One van instead of two cars"}]," keeps everyone together and means one pickup to coordinate when the evening ends — especially useful with tired children."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Strollers and bags"}]," fit in an SUV or van boot without folding everything down."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Groups of 10 or more"}]," can book a minibus or coaster. See ",["$","$L26","a-0",{"href":"/fleet","children":"vehicle classes"}],"."]}],"\n"]}]
3a:["$","h2","h2-5",{"id":"making-a-night-of-it","children":"Making a night of it"}]
3b:["$","p","p-5",{"children":["With an ",["$","$L26","a-0",{"href":"/locations/riyadh/private-driver","children":"hourly private driver"}],", the car waits while you move between zones or go on to dinner — no need to book a new ride every time you change location. Many visitors combine a Season zone with an evening in ",["$","$L26","a-1",{"href":"/blog/riyadh-to-diriyah-visitor-transport-guide","children":"Diriyah"}],"; both are busiest on weekend evenings, so allow time between them."]}]
3c:["$","h2","h2-6",{"id":"practical-tips","children":"Practical tips"}]
3d:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Agree a pickup point and time"}]," before you go in — and stick close to it; phones can be hard to hear in a crowd."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Leave a few minutes before a headline show ends"}],", or wait until the first rush clears."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Screenshot your booking and the driver's number"}]," in case your battery or signal runs low."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Dress for the evening chill"}]," later in the season — Riyadh nights in winter can be cool."]}],"\n"]}]
