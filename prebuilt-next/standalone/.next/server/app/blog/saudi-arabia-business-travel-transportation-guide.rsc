3e:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Executive sedan"}]," (Toyota Camry, Genesis G80 class) — one or two executives."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Luxury sedan"}]," (Mercedes S-Class, BMW 7 Series) — senior executives, client hosting, VIP guests."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Full-size SUV"}]," (GMC Yukon XL, Cadillac Escalade) — small teams, or when you want more space and presence."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Van or coaster"}]," — teams and delegations."]}],"\n"]}]
