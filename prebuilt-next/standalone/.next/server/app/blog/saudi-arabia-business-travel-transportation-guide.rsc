30:["$","p","p-0",{"children":["Saudi business cities are built around cars. Riyadh in particular is large, its business districts — ",["$","strong","strong-0",{"children":"KAFD"}],", ",["$","strong","strong-1",{"children":"Olaya"}],", the ",["$","strong","strong-2",{"children":"Diplomatic Quarter"}],", ",["$","strong","strong-3",{"children":"Al Murabba"}]," — are far apart, and weekday commuter peaks on the main roads are heavy. In summer, walking even a few hundred metres between buildings in a suit is unpleasant. Executives who try to improvise with street taxis or app rides between meetings tend to lose time at pickup points and arrive flustered."]}]
31:["$","h2","h2-2",{"id":"arriving","children":"Arriving"}]
32:["$","h3","h3-0",{"id":"riyadh-ruh","children":"Riyadh (RUH)"}]
33:["$","p","p-1",{"children":["Central Riyadh is about 35 km from King Khalid International Airport and KAFD about 40 km — around 30–35 minutes off-peak, much longer at rush hour. If you're going straight to a meeting, book the airport transfer with hours added so the same car takes you on. See the ",["$","$L26","a-0",{"href":"/blog/riyadh-airport-ruh-taxi-guide","children":"RUH arrival guide"}],"."]}]
34:["$","h3","h3-1",{"id":"jeddah-jed","children":"Jeddah (JED)"}]
35:["$","p","p-2",{"children":["The commercial capital of the west coast. The city is about 20 km from the airport. Business districts and hotels are spread along the Corniche and the main north–south roads, so give exact addresses. ",["$","$L26","a-0",{"href":"/routes/jeddah-airport-to-kaec","children":"King Abdullah Economic City"}]," is about 100 km from the airport."]}]
36:["$","h3","h3-2",{"id":"dammam-dmm","children":"Dammam (DMM)"}]
37:["$","p","p-3",{"children":["Gateway to the energy industry: Dhahran is about 25 km from the airport, Jubail about 90 km. Industrial sites have controlled gates — share the gate name and host contact. See our ",["$","$L26","a-0",{"href":"/blog/eastern-province-corporate-visitor-transport-guide","children":"Eastern Province guide"}],"."]}]
38:["$","p","p-4",{"children":["Whichever airport: share your ",["$","strong","strong-0",{"children":"flight number"}]," when you book — we check it before pickup."]}]
39:["$","h2","h2-3",{"id":"meeting-days-per-trip-or-by-the-hour","children":"Meeting days: per trip or by the hour?"}]
3a:["$","p","p-5",{"children":"If you have one meeting, book a per-trip transfer there and back. If you have three or more stops, book by the hour or for the day:"}]
3b:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"the driver waits outside each building, so you walk straight out to the car;"}],"\n",["$","li","li-1",{"children":"changes to the schedule are handled with one phone call;"}],"\n",["$","li","li-2",{"children":"you can leave a laptop bag or samples in the car between meetings."}],"\n"]}]
3c:["$","p","p-6",{"children":["See ",["$","$L26","a-0",{"href":"/blog/private-driver-cost-saudi-arabia","children":"private driver pricing explained"}]," and the ",["$","$L26","a-1",{"href":"/locations/riyadh/private-driver","children":"Riyadh private driver page"}],"."]}]
