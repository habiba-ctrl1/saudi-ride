38:["$","p","p-3",{"children":["Book the ",["$","$L26","a-0",{"href":"/airports/king-khalid-riyadh","children":"airport transfer"}]," with your ",["$","strong","strong-0",{"children":"flight number"}]," — we check it before pickup. Many delegates go straight from RUH to registration; if so, tell us so luggage space and timing are planned."]}]
39:["$","h3","h3-1",{"id":"hotel-to-venue-the-morning-wave","children":"Hotel to venue — the morning wave"}]
3a:["$","p","p-4",{"children":["Everyone wants to arrive at opening time, so roads to the big venues are busiest then. For ",["$","strong","strong-0",{"children":"RECC in Malham"}],", leave a generous margin from Olaya or KAFD hotels. For ",["$","strong","strong-1",{"children":"RICEC"}],", the metro is a real alternative for a light-travelling delegate."]}]
3b:["$","h3","h3-2",{"id":"during-the-day","children":"During the day"}]
3c:["$","p","p-5",{"children":["If you have meetings away from the venue — in ",["$","$L26","a-0",{"href":"/locations/riyadh/kafd","children":"KAFD"}]," or ",["$","$L26","a-1",{"href":"/locations/riyadh/olaya","children":"Olaya"}]," — an ",["$","strong","strong-0",{"children":"hourly car"}]," that waits is usually simpler than booking separate rides from a crowded venue exit."]}]
3d:["$","h3","h3-3",{"id":"evening-functions","children":"Evening functions"}]
3e:["$","p","p-6",{"children":"Dinners and receptions are often in hotels or in Diriyah. Book the evening car in advance; at the end of a show day, everybody leaves at once."}]
3f:["$","h2","h2-4",{"id":"for-companies-exhibitors-and-organisers","children":"For companies, exhibitors and organisers"}]
40:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Exhibitor stand crews"}]," need early arrivals for build-up and late departures after breakdown, often with equipment — vans or a separate luggage vehicle."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Speakers and VIP guests"}]," need precise timing around their session and a discreet, premium vehicle."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Delegations"}]," arriving on the same flight can be met by several cars or a coaster."]}],"\n"]}]
41:["$","p","p-7",{"children":["For more than a handful of people, ask for a ",["$","strong","strong-0",{"children":"written quote by email"}]," — we can quote the whole event, not ride by ride. Company invoices are available on request; corporate invoicing can be arranged through our sister company. See ",["$","$L26","a-0",{"href":"/events/corporate-event-transportation-saudi-arabia","children":"corporate event transportation"}],"."]}]
