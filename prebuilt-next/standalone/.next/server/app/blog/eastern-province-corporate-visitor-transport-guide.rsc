2a:["$","div",null,{"className":"section-container mt-10 max-w-6xl md:mt-12","children":["$","div",null,{"className":"grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-14","children":[["$","article",null,{"className":"min-w-0","children":[["$","div",null,{"className":"blog-quick","children":[["$","p",null,{"className":"blog-quick-label","children":[["$","$L27",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5","key":"1gvzjb"}],["path",{"d":"M9 18h6","key":"x1upvd"}],["path",{"d":"M10 22h4","key":"ceow96"}]],"className":"lucide-lightbulb h-4 w-4","aria-hidden":true}]," ","Quick answer"]}],["$","p",null,{"className":"blog-quick-text","children":"Most business visitors to the Eastern Province land at King Fahd International Airport (DMM), about 25 km from Dhahran, and then move between Dammam, Al Khobar, Dhahran and Jubail (about 90 km from the airport). A pre-booked car per trip suits a simple visit; for several site visits a day or a multi-day project, an hourly or day booking — quoted in writing for companies — is usually simpler."}]]}],["$","details",null,{"className":"blog-toc-mobile lg:hidden","children":[["$","summary",null,{"children":[["$","$L27",null,{"ref":"$undefined","iconNode":[["path",{"d":"M8 5h13","key":"1pao27"}],["path",{"d":"M13 12h8","key":"h98zly"}],["path",{"d":"M13 19h8","key":"c3s6r1"}],["path",{"d":"M3 10a2 2 0 0 0 2 2h3","key":"1npucw"}],["path",{"d":"M3 5v12a2 2 0 0 0 2 2h3","key":"x1gjn2"}]],"className":"lucide-list-tree h-4 w-4","aria-hidden":true}]," ","In this guide"]}],["$","ol",null,{"children":[["$","li","one-region-several-cities",{"children":["$","a",null,{"href":"#one-region-several-cities","children":"One region, several cities"}]}],["$","li","key-distances",{"children":["$","a",null,{"href":"#key-distances","children":"Key distances"}]}],["$","li","arriving-at-king-fahd-international-airport-dmm",{"children":["$","a",null,{"h