2d:["$","tr","tr-6",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Decisions"}]}],["$","td","td-1",{"children":"Often made after several meetings, sometimes by someone senior who wasn't in the first one"}]]}]
2e:["$","h2","h2-1",{"id":"meetings-and-greetings","children":"Meetings and greetings"}]
2f:["$","h3","h3-0",{"id":"relationships-first","children":"Relationships first"}]
30:["$","p","p-0",{"children":["The first meeting is often about getting to know each other. Expect Arabic coffee (",["$","em","em-0",{"children":"qahwa"}],"), dates or tea, and conversation about your journey, your family in general terms and your impressions of the Kingdom. Rushing straight to the slides can come across as cold. Accept the coffee; when you've had enough, a slight shake of the cup when handing it back is the traditional signal."]}]
31:["$","h3","h3-1",{"id":"handshakes","children":"Handshakes"}]
32:["$","p","p-1",{"children":["Shake hands with your right hand. In mixed-gender meetings, wait for your Saudi counterpart to offer a hand; if they don't, a nod or a hand on the heart is a polite alternative. Use titles — ",["$","em","em-0",{"children":"Dr."}],", ",["$","em","em-1",{"children":"Eng."}],", ",["$","em","em-2",{"children":"Sheikh"}]," — until you are invited to do otherwise."]}]
33:["$","h3","h3-2",{"id":"punctuality-and-patience","children":"Punctuality and patience"}]
34:["$","p","p-2",{"children":"Arrive on time; it reflects on you. Do not be surprised if the meeting starts late, if phones are answered, or if people come and go. Allow buffers in your day rather than stacking meetings back to back."}]
35:["$","h3","h3-3",{"id":"business-cards-and-materials","children":"Business cards and materials"}]
36:["$","p","p-3",{"children":["Bring business cards. Material in both ",["$","strong","strong-0",{"children":"English and Arabic"}]," is appreciated, though not essential in most international settings."]}]
37:["$","h2","h2-2",{"id":"dress","children":"Dress"}]
38:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Men:"}]," a business suit is standard for visitors. Many Saudi colleagues will wear the ",["$","em","em-0",{"children":"thobe"}]," and ",["$","em","em-1",{"children":"ghutra"}]," or ",["$","em","em-2",{"children":"shemagh"}],"."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Women:"}]," the abaya is no longer required for foreign women, but modest business dress — loose-fitting, with covered shoulders and knees — is expected. Headscarves are not required for non-Muslim women. Some women visitors carry a light abaya or scarf for government buildings or more traditional settings."]}],"\n"]}]
39:["$","h2","h2-3",{"id":"the-working-week-and-the-calendar","children":"The working week and the calendar"}]
3a:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":["The ",["$","strong","strong-0",{"children":"weekend is Friday and Saturday"}],"; Friday midday is the main congregational prayer."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Prayer times"}]," move through the year; many offices pause at prayer, so a 30-minute gap in a schedule may simply be prayer."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Ramadan"}]," shortens working hours and shifts much activity into the evening. Meetings happen, but schedules change — plan around it."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Major conference periods"}]," in Riyadh book out hotels and cars early; see our ",["$","$L26","a-0",{"href":"/blog/riyadh-business-events-executive-transfer-guide","children":"Riyadh conference venues guide"}],"."]}],"\n"]}]
3b:["$","h2","h2-4",{"id":"hospitality-and-dinners","children":"Hospitality and dinners"}]
3c:["$","p","p-4",{"children":"Invitations to lunch, dinner or a majlis are part of building trust. Accept when you can. Alcohol is not served. Food is usually generous; trying a little of everything is polite. Business may not be discussed at all — that is fine."}]
3d:["$","h2","h2-5",{"id":"topics-to-approach-carefully","children":"Topics to approach carefully"}]
3e:["$","p","p-5",{"children":"Keep politics and religion out of small talk unless your host raises them, avoid criticising local customs, and steer clear of jokes that rely on cultural references. Asking about Saudi Arabia's development, sport or travel inside the Kingdom is usually welcome."}]
3f:["$","h2","h2-6",{"id":"getting-between-meetings","children":"Getting between meetings"}]
40:["$","p","p-6",{"children":"Riyadh is spread out, distances between districts are long, and summer heat makes walking between buildings impractical. A few planning points:"}]
41:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Allow for traffic."}]," A meeting in KAFD and another in the Diplomatic Quarter are not \"around the corner\" at rush hour."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Book a car that waits."}]," For a day of several meetings, an ",["$","$L26","a-0",{"href":"/locations/riyadh/private-driver","children":"hourly private driver"}]," means the same car is outside each building when you finish."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Know the entrance."}]," Large business districts and ministries have several gates and entrances — give the driver the building name and entrance where you can."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Expenses."}]," Ask for an electronic receipt, or a company invoice for corporate bookings."]}],"\n"]}]
42:["$","p","p-7",{"children":["For the full transport picture — airports, cities, hourly hire and corporate bookings — see our ",["$","$L26","a-0",{"href":"/blog/saudi-arabia-business-travel-transportation-guide","children":"business travel transportation guide"}],"."]}]
43:["$","h2","h2-7",{"id":"common-questions","children":"Common questions"}]
44:["$","h3","h3-4",{"id":"do-i-need-to-wear-a-suit-in-summer","children":"Do I need to wear a suit in summer?"}]
45:["$","p","p-8",{"children":"For first meetings, yes. Buildings and cars are air-conditioned; the main challenge is walking outside, which is why most visitors use a car door to door."}]
46:["$","h3","h3-5",{"id":"can-women-attend-meetings-alone","children":"Can women attend meetings alone?"}]
47:["$","p","p-9",{"children":"Yes. Women regularly attend business meetings in Saudi Arabia, and travel to and from them by private car is routine."}]
