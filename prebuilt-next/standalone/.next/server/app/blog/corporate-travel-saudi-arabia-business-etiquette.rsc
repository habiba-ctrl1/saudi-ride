-3 text-sm leading-relaxed text-[#64748B]","children":"Ground transport for business trips to Riyadh, Jeddah and the Eastern Province: airport arrivals, hotel-to-meeting days, hourly drivers, intercity trips, events and company bookings with invoices."}],["$","div",null,{"className":"mt-auto flex items-center justify-between gap-3 pt-5 text-xs font-medium text-[#64748B]","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5","children":[["$","$L27",null,{"ref":"$undefined","iconNode":"$28:props:children:3:props:children:3:props:children:0:props:iconNode","className":"lucide-clock h-3.5 w-3.5 text-[#16A34A]","aria-hidden":true}],"5 min read"," · ","2 October 2026"]}],["$","span",null,{"className":"inline-flex items-center gap-1 font-semibold text-[#15803D]","aria-hidden":true,"children":["Read guide"," ",["$","$L27",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"m12 5 7 7-7 7","key":"xquz4c"}]],"className":"lucide-arrow-right h-3.5 w-3.5 rtl:-scale-x-100"}]]}]]}]]}]]}],["$","article","/blog/riyadh-business-events-executive-transfer-guide",{"className":"group relative flex h-full flex-col overflow-hidden rounded-2xl border border-[#0F172A]/[0.07] bg-white transition-[box-shadow,border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-[#16A34A]/30 hover:shadow-[0_18px_40px_-24px_rgba(15,23,42,0.35)]","children":[["$","div",null,{"className":"relative aspect-[16/10] overflow-hidden bg-[#F1F5F2]","children":[["$","$L2c",null,{"src":"/blog/riyadh-business-events-executive-transfer-guide.webp","alt":"Chauffeur in a suit holding open the rear door of a black sedan outside a glass office building","fill":true,"priority":false,"sizes":"(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw","className":"object-cover transition-transform duration-500 group-hover:scale-[1.03]"}],["$","span",null,{"className":"absolute start-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[0.68rem] font-bold t