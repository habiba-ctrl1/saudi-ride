 for everyone"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Timing"}]}],["$","td","td-1",{"children":"Be punctual yourself; be patient if meetings start late or are interrupted"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Prayer"}]}],["$","td","td-1",{"children":"Meetings pause or are scheduled around prayer times"}]]}],"$L2d"]}]]}]}],"\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49"]}],"$L4a","$L4b"]}],"$L4c"]}]}]
