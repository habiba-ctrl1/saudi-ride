30:["$","p","p-3",{"children":["About ",["$","strong","strong-0",{"children":"410 km by road"}],", roughly ",["$","strong","strong-1",{"children":"4 hours of driving"}]," on Highway 40, which runs east from Riyadh towards the Eastern Province. Typical points on the way are the Al Kharj junction, rest areas about midway and the Al Hofuf turn-off. See the ",["$","$L25","a-0",{"href":"/distance/riyadh-to-dammam","children":"Riyadh to Dammam distance guide"}]," for the full route."]}]
31:["$","h2","h2-2",{"id":"taxi-train-or-flight-a-direct-comparison","children":"Taxi, train or flight? A direct comparison"}]
32:["$","div","table-0",{"className":"blog-table not-prose","children":["$","table",null,{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{}],["$","th","th-1",{"children":"Private car"}],["$","th","th-2",{"children":"SAR train"}],["$","th","th-3",{"children":"Flight"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Door to door"}]}],["$","td","td-1",{"children":"Yes — your address to your address"}],["$","td","td-2",{"children":"No — station to station, then onward transport"}],["$","td","td-3",{"children":"No — airport to airport, then onward transport"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Time on the way"}]}],["$","td","td-1",{"children":"About 4 hours"}],["$","td","td-2",{"children":"Roughly 4 to 4.5 hours (check the current timetable)"}],["$","td","td-3",{"children":"Short in the air, but check-in, security and transfers add time"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Luggage"}]}],["$","td","td-1",{"children":"One vehicle, no handling"}],["$","td","td-2",{"children":"Carried on and off by you"}],["$","td","td-3",{"children":"Subject to airline limits"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Group or family"}]}],["$","td","td-1",{"children":"One fare for the whole group"}],["$","td","td-2",{"children":"A ticket per person"}],["$","td","td-3",{"children":"A ticket per person"}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Departure time"}]}],["$","td","td-1",{"children":"Your choice"}],["$","td","td-2",{"children":"Fixed timetable"}],["$","td","td-3",{"children":"Fixed timetable"}]]}],["$","tr","tr-5",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Price"}]