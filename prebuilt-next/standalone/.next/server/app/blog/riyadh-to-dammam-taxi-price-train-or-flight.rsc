g period changes the quote."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Direction and return"}]," — one way, or a same-day return."]}],"\n"]}],"\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46"]}],"$L47","$L48"]}],"$L49"]}]}]
