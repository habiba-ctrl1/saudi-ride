33:["$","p","p-4",{"children":["The train is operated by ",["$","strong","strong-0",{"children":"Saudi Arabia Railways (SAR)"}]," on the Riyadh–Dammam line, with stations at Riyadh, Hofuf, Abqaiq and Dammam. Reported journey times have varied between about 3 hours 40 minutes for an express service and around 4 to 4.5 hours for standard services, so ",["$","strong","strong-1",{"children":"check the current schedule and fares on the SAR website or app"}]," before relying on any figure. We do not quote train or airline prices."]}]
34:["$","h2","h2-3",{"id":"which-option-suits-which-traveller","children":"Which option suits which traveller?"}]
35:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"One traveller, light luggage, no fixed address at the other end"}]," — the train or a flight is usually cheaper per person."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"A family or group"}]," — one private car is simpler than several tickets plus a taxi at each end."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Heavy luggage, samples or equipment"}]," — a car avoids carrying bags through a station or an airport."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Business trips with a meeting soon after arrival"}]," — a car lets you leave when you choose and work on the way; a flight only wins if the timing lines up."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Going on to Al Khobar, Dhahran, Jubail or Bahrain"}]," — one car avoids a station or airport change in Dammam. For Bahrain, see ",["$","$L25","a-0",{"href":"/routes/dammam-to-manama","children":"Dammam to Bahrain"}],"."]}],"\n"]}]
36:["$","p","p-5",{"children":"The honest trade-off: if you are one person with a bag and you are happy to take a second taxi at the other end, the train or a flight will usually cost less. A private car costs more per person for a solo traveller and less per person as the group grows."}]
37:["$","h2","h2-4",{"id":"what-a-private-car-adds","children":"What a private car adds"}]
38:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"A fixed fare agreed in advance"}]," — compare it with train or flight prices before deciding."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Pickup at your door"}]," — home, hotel, office, or Riyadh's King Khalid International Airport."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Drop-off anywhere in Dammam, Al Khobar or at Dammam Airport (DMM)"}]," — see ",["$","$L25","a-0",{"href":"/airports/king-fahd-dammam","children":"Dammam Airport transfers"}],"."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Flexible timing and stops"}]," — a prayer, food or Al Hofuf stop is planned into the quote."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Payment"}]," — cash to the driver or bank transfer; an electronic receipt on request. Companies can request an invoice. ",["$","strong","strong-1",{"children":"Free cancellation up to 24 hours before pickup."}]]}],"\n"]}]
39:["$","p","p-6",{"children":"For a corporate booking, send the company name, the number of travellers and the dates, and ask for a written quote."}]
