42:["$","p","p-10",{"children":["Yes. Give us the exact drop-off — central Dammam, Al Khobar, a hotel, a compound or Dammam Airport. See ",["$","$L25","a-0",{"href":"/routes/riyadh-to-alkhobar","children":"Riyadh to Al Khobar"}]," for that variant."]}]
