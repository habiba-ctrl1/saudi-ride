2e:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"A family or group"}]," would need several air tickets, and travelling together by car is simpler."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Luggage is heavy"}]," — relocations, long stays, trade samples or equipment."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"They want door to door"}]," — no airport check-in at either end, and no transfers to and from airports."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"There are stops on the way"}],", such as Dammam, Al Khobar or Abu Dhabi."]}],"\n"]}]
2f:["$","h2","h2-2",{"id":"the-border-crossing","children":"The border crossing"}]
30:["$","p","p-1",{"children":["You cross from Saudi Arabia into the UAE at ",["$","strong","strong-0",{"children":"Al Batha"}],", entering the UAE at ",["$","strong","strong-1",{"children":"Ghuwaifat"}],"."]}]
31:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Documents are your responsibility."}]," Every passenger needs a valid passport and the right UAE entry permission for their nationality, and the right to exit Saudi Arabia (residents: check your exit/re-entry status). Check the official UAE and Saudi requirements before you book; rules change and depend on nationality."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Time at the border varies"}]," with the time of day, weekends and public holidays. Leave room in your plans rather than booking a tight dinner reservation in Dubai."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"The driver supports the crossing"}]," — knowing where to stop and what each counter is for — but cannot obtain visas or entry permissions for you."]}],"\n"]}]
32:["$","p","p-2",{"children":"Tell us every passenger's nationality when you book, so we can flag anything that might affect the crossing before the day."}]
33:["$","h2","h2-3",{"id":"choosing-the-vehicle","children":"Choosing the vehicle"}]
34:["$","p","p-3",{"children":["For a 9-hour drive, comfort and luggage space matter. Families and groups usually take a ",["$","strong","strong-0",{"children":"full-size SUV"}]," (GMC Yukon XL class, up to 7 passengers) or a ",["$","strong","strong-1",{"children":"van"}],"; executives travelling alone or in pairs often prefer an ",["$","strong","strong-2",{"children":"executive sedan"}]," or ",["$","strong","strong-3",{"children":"luxury"}]," car to work in the back. Compare options on our ",["$","$L25","a-0",{"href":"/fleet","children":"vehicle classes page"}],"."]}]
35:["$","h2","h2-4",{"id":"making-the-day-easier","children":"Making the day easier"}]
36:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Leave early."}]," A morning start puts the border crossing in daylight and gets you to Dubai in the evening."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Plan one or two proper stops"}]," for prayer, food and stretching — the driver will suggest service stations along the way."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Keep documents in your hand luggage"}],", not in a suitcase in the boot."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Download offline maps and documents"}],"; mobile coverage can drop on long stretches."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Share your Dubai address precisely"}]," — hotel name and area, or a pin for a private address."]}],"\n"]}]
37:["$","h2","h2-5",{"id":"splitting-the-trip","children":"Splitting the trip"}]
38:["$","p","p-4",{"children":["Some travellers break the journey in the Eastern Province — a night in Dammam or Al Khobar — or stop in Abu Dhabi. If that is your plan, tell us when you book so the quote reflects the route. For the UAE capital as your destination, see ",["$","$L25","a-0",{"href":"/routes/riyadh-to-abudhabi","children":"Riyadh to Abu Dhabi"}],"."]}]
39:["$","h2","h2-6",{"id":"how-the-fare-works","children":"How the fare works"}]
3a:["$","p","p-5",{"children":["The fare is one fixed price for the trip you describe — vehicle, route, stops — agreed before booking. Pay ",["$","strong","strong-0",{"children":"cash to the driver or by bank transfer"}],"; an ",["$","strong","strong-1",{"children":"electronic receipt"}]," is available on request, and companies can request an invoice. ",["$","strong","strong-2",{"children":"Free cancellation up to 24 hours before pickup."}]]}]
3b:["$","h2","h2-7",{"id":"common-questions","children":"Common questions"}]
3c:["$","h3","h3-0",{"id":"how-long-does-riyadh-to-dubai-take-by-car","children":"How long does Riyadh to Dubai take by car?"}]
3d:["$","p","p-6",{"children":"About 9 hours of driving for roughly 990 km, plus time at the border. Plan for a full day."}]
3e:["$","h3","h3-1",{"id":"do-i-need-a-visa-for-the-uae","children":"Do I need a visa for the UAE?"}]
