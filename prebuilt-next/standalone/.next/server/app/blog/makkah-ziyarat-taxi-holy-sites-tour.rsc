38:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Dress modestly and comfortably"}],"; good shoes if you plan to climb."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Carry water"}],", even in winter."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Respect the sites"}]," — they are places of history and reflection; follow any local guidance on prayer and conduct."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Families:"}]," an SUV or van gives everyone a window seat and space for a stroller. See ",["$","$L25","a-0",{"href":"/fleet","children":"vehicle classes"}],"."]}],"\n"]}]
