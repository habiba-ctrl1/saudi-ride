44:["$","ul","ul-4",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Family with children or older relatives, or more than one large case each:"}]," private transfer."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Arriving late at night:"}]," private transfer — no timetables."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Solo or a couple, light bags, daytime arrival:"}]," the train is hard to beat; add a short car at the Madinah end."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Group of 10 or more:"}]," a private minibus or coaster keeps everyone together."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"Tight budget, flexible time:"}]," coach."]}],"\n"]}]
