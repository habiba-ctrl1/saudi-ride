3d:["$","ul","ul-3",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Madinah station is not at the Haram."}]," You need a taxi or transfer from the station to your hotel — with your luggage."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Timetables."}]," You travel at set times, and you need to get from the arrivals hall to the station and wait for your train. Check the official Haramain railway timetable and booking channels for current times and fares."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Luggage limits"}]," apply — significant for Umrah travellers with large suitcases."]}],"\n"]}]
