46:["$","ul","ul-5",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Umrah order of travel."}]," If you are going to Madinah first, you do not need Ihram on arrival; you will enter it at Abyar Ali when you later go to Makkah. See our ",["$","$L26","a-0",{"href":"/blog/complete-miqat-locations-guide-umrah-pilgrims","children":"Miqat guide"}],"."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"SIM and data."}]," Buy a SIM at JED or have an eSIM ready — useful for messaging your driver and checking train times. See ",["$","$L26","a-0",{"href":"/blog/buying-sim-cards-jeddah-airport-stc-mobily-zain","children":"SIM cards at Jeddah Airport"}],"."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Hotel drop-off."}]," Around Masjid an-Nabawi, cars set down at the nearest permitted point; the final stretch is on foot."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Rest stops."}]," On the road, the driver will stop for prayer and refreshments on request."]}],"\n"]}]
47:["$","h2","h2-7",{"id":"how-the-private-transfer-fare-works","children":"How the private transfer fare works"}]
48:["$","p","p-9",{"children":["One fixed fare for the trip, agreed before booking, based on the vehicle and any stops — not on time of day or demand. Pay ",["$","strong","strong-0",{"children":"cash to the driver or by bank transfer"}],"; an ",["$","strong","strong-1",{"children":"electronic receipt"}]," is available on request. ",["$","strong","strong-2",{"children":"Free cancellation up to 24 hours before pickup."}]," Starting from Jeddah city rather than the airport? See ",["$","$L26","a-0",{"href":"/routes/jeddah-to-madinah","children":"Jeddah to Madinah"}]," (about 420 km)."]}]
49:["$","h2","h2-8",{"id":"common-questions","children":"Common questions"}]
4a:["$","h3","h3-0",{"id":"how-far-is-jeddah-airport-from-madinah","children":"How far is Jeddah Airport from Madinah?"}]
4b:["$","p","p-10",{"children":"About 410 km by road — around 4 hours by car in normal traffic."}]
4c:["$","h3","h3-1",{"id":"is-there-a-train-from-jeddah-airport-to-madinah","children":"Is there a train from Jeddah Airport to Madinah?"}]
4d:["$","p","p-11",{"children":"Yes. The Haramain railway has a station at King Abdulaziz International Airport, with services to Madinah in around 2 to 2.5 hours. You will still need a car from Madinah station to your hotel."}]
4e:["$","h3","h3-2",{"id":"which-is-cheaper-train-or-private-car","children":"Which is cheaper, train or private car?"}]
4f:["$","p","p-12",{"children":"For one or two people, the train is usually cheaper. For a family or group, one private vehicle priced per trip can be close to — or less than — several train tickets plus taxis at the Madinah end."}]
