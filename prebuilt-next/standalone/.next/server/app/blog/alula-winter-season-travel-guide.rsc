40:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Pack layers."}]," Desert nights in December and January can be cold, even after a warm day."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Start early."}]," Light is best and crowds thinner in the morning."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"Dark roads."}]," Sites like Elephant Rock are outside town; driving back after sunset is easier with a local driver than self-drive."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"Share your resort name precisely"}]," when booking — some are deep in the canyons."]}],"\n"]}]
