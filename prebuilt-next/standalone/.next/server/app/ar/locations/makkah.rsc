1b:T493,{"@context":"https://schema.org","@type":"ItemList","numberOfItems":8,"itemListElement":[{"@type":"ListItem","position":1,"name":"مطار جدة ← مكة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-airport-to-makkah"},{"@type":"ListItem","position":2,"name":"مكة ← مطار جدة","url":"https://taxisaudiarabia.com/ar/routes/makkah-to-jeddah-airport"},{"@type":"ListItem","position":3,"name":"مكة ← المدينة المنورة","url":"https://taxisaudiarabia.com/ar/routes/makkah-to-madinah"},{"@type":"ListItem","position":4,"name":"المدينة المنورة ← مكة","url":"https://taxisaudiarabia.com/ar/routes/madinah-to-makkah"},{"@type":"ListItem","position":5,"name":"جدة ← مكة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-to-makkah"},{"@type":"ListItem","position":6,"name":"مكة ← جدة","url":"https://taxisaudiarabia.com/ar/routes/makkah-to-jeddah"},{"@type":"ListItem","position":7,"name":"مكة ← الطائف","url":"https://taxisaudiarabia.com/ar/routes/makkah-to-taif"},{"@type":"ListItem","position":8,"name":"مكة ← الرياض","url":"https://taxisaudiarabia.com/routes/makkah-to-riyadh"}]}1c:T12b1,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"كيف أحجز تاكسي خاص في مكة؟","acceptedAnswer":{"@type":"Answer","text":"أرسل نقطة الاستلام والوجهة والتاريخ وعدد الركاب والحقائب عبر النموذج أو واتساب. نرد عليك بالمركبة وسعر واحد ثابت قبل تأكيد أي حجز — بلا عدّاد ولا زيادة وقت الذروة."}},{"@type":"Question","name":"هل يمكنني حجز نقل خاص من مطار جدة إلى مكة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. المسافة من مطار جدة (JED) إلى مكة نحو 80 كم وتستغرق ساعة تقريباً. يستقبلك السائق بعد استلام الأمتعة، ونتابع رحلتك، والانتظار من 15 إلى 30 دقيقة مجاني بعد الهبوط."}},{"@type":"Question","name":"هل يمكن السفر بسيارة خاصة من مكة إلى المدينة المنورة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. المسافة نحو 430 كم وتستغرق 4 ساعات تقريباً من القيادة. تنقلك سيارة خاصة من فندقك إلى فندقك مع توقفات الصلاة والراحة عند الطلب، ويمكن حجز العودة معها."}},{"@type":"Question","name":"هل يمكن الاستلام من فندقي في مكة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. أعطنا اسم الفندق ويأتي السائق إلى مدخله. وقرب المسجد الحرام قد تنتظرك السيارة عند أقرب نقطة مسموحة وقت الصلاة، ويخبرك السائق بمكانها."}},{"@type":"Question","name":"هل تتوفر سيارة لزيارات مكة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. تنقلك السيارة بين المواقع التي تختارها، مثل جبل النور وجبل ثور ومنى ومزدلفة وعرفات، وتنتظرك عند كل محطة. الخدمة نقل فقط ولا تتضمن إرشاداً دينياً."}},{"@type":"Question","name":"هل أستطيع استئجار سيارة مع سائق بالساعة في مكة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. احجز سيارة وسائقاً لعدد ساعات أو ليوم كامل، وتنتظرك السيارة بين المحطات. أرسل التاريخ ووقت البدء وعدد الساعات ونؤكد السعر قبل الحجز."}},{"@type":"Question","name":"أي مركبة أختار لعائلتي؟","acceptedAnswer":{"@type":"Answer","text":"السيدان تناسب من واحد إلى ثلاثة أشخاص بحقائب عادية. وتناسب جي إم سي أو الدفع الرباعي الكبير أو هيونداي ستاريا العائلات مع حقائب أكثر. أما فان هايس أو الكوستر فللمجموعات الأكبر. نؤكد المركبة حسب عدد الركاب والحقائب."}},{"@type":"Question","name":"هل تتوفر جي إم سي أو هيونداي ستاريا؟","acceptedAnswer":{"@type":"Answer","text":"الفئتان ضمن المركبات المتاحة عبر شبكة شركائنا، وتُؤكد توفرهما حسب تاريخ رحلتك ومسارها وعدد الركاب عند إرسال عرض السعر."}},{"@type":"Question","name":"هل يمكن ترتيب حافلة كبيرة لمجموعة؟","acceptedAnswer":{"@type":"Answer","text":"تُرتب الكوسترات والحافلات الأكبر عند الطلب عبر شبكة شركائنا. أرسل عدد أفراد المجموعة والتواريخ والمسارات ونؤكد المتاح."}},{"@type":"Question","name":"هل تقدمون نقلاً للشركات في مكة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. أرسل بيانات شركتك وقائمة الرحلات بالبريد لنرد بعرض سعر مكتوب. يمكن ترتيب فواتير الشركات عبر شركتنا الشقيقة."}},{"@type":"Question","name":"هل أحتاج إلى التوقف عند الميقات؟","acceptedAnswer":{"@type":"Answer","text":"هذا يتوقف على مكان قدومك وظروفك الشرعية الخاصة، ولا نقدّم فتوى في ذلك. إن كان في خطتك توقف عند ميقات فأخبرنا عند الحجز ونرتبه لك."}},{"@type":"Question","name":"هل يمكنني إلغاء الحجز؟","acceptedAnswer":{"@type":"Answer","text":"نعم. الإلغاء مجاني حتى 24 ساعة قبل موعد الاستلام، ويمكن تعديل الوقت أو العنوان عبر واتساب."}}]}f:["$","$1","c",{"children":[["$","div",null,{"dir":"rtl","lang":"ar","className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"@id\":\"https://taxisaudiarabia.com/ar/locations/makkah#service\",\"name\":\"تاكسي ونقل خاص وسيارة مع سائق في مكة المكرمة\",\"inLanguage\":\"ar\",\"description\":\"نقل خاص بحجز مسبق في مكة: من مطار جدة وإليه، ومكة–المدينة ومكة–جدة ومكة–الطائف، ونقل الفنادق، وزيارات مكة، وسيارة مع سائق بالساعة، عبر شبكة شركاء. السعر يُتفق عليه قبل الحجز.\",\"url\":\"https://taxisaudiarabia.com/ar/locations/makkah\",\"provider\":{\"@type\":\"Organization\",\"name\":\"تاكسي السعودية\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"مكة المكرمة\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":21.3891,\"longitude\":39.8579}},\"availableLanguage\":[\"Arabic\",\"English\"]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/ar/locations/makkah#webpage\",\"url\":\"https://taxisaudiarabia.com/ar/locations/makkah\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}]],"$L1d","$L1e","$L1f","$L20","$L21"]}],null,"$L22"]}]
