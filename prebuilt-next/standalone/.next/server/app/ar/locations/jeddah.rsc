1b:T4e7,{"@context":"https://schema.org","@type":"ItemList","numberOfItems":8,"itemListElement":[{"@type":"ListItem","position":1,"name":"مطار جدة ← مكة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-airport-to-makkah"},{"@type":"ListItem","position":2,"name":"جدة ← مكة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-to-makkah"},{"@type":"ListItem","position":3,"name":"مكة ← مطار جدة","url":"https://taxisaudiarabia.com/ar/routes/makkah-to-jeddah-airport"},{"@type":"ListItem","position":4,"name":"مطار جدة ← المدينة المنورة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-airport-to-madinah"},{"@type":"ListItem","position":5,"name":"جدة ← المدينة المنورة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-to-madinah"},{"@type":"ListItem","position":6,"name":"المدينة المنورة ← مطار جدة","url":"https://taxisaudiarabia.com/ar/routes/madinah-to-jeddah-airport"},{"@type":"ListItem","position":7,"name":"مطار جدة ← وسط جدة","url":"https://taxisaudiarabia.com/ar/routes/jeddah-airport-to-jeddah-city"},{"@type":"ListItem","position":8,"name":"جدة ← الطائف","url":"https://taxisaudiarabia.com/ar/routes/jeddah-to-taif"}]}1c:Tfc5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"كيف أحجز تاكسي خاص من مطار جدة؟","acceptedAnswer":{"@type":"Answer","text":"أرسل رقم الرحلة ووجهتك وعدد الركاب والحقائب عبر النموذج أو واتساب. نرد عليك بالمركبة وسعر واحد ثابت قبل تأكيد أي حجز. يستقبلك السائق بعد استلام الأمتعة، ونتابع رحلتك إن تأخرت."}},{"@type":"Question","name":"هل أستطيع السفر مباشرة من مطار جدة إلى مكة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. المسافة من مطار الملك عبدالعزيز الدولي إلى مكة نحو 80 كم وتستغرق ساعة تقريباً. تنقلك سيارة خاصة من الصالة إلى فندقك، وقرب الحرم قد تنتظرك عند أقرب نقطة مسموحة وقت الصلاة."}},{"@type":"Question","name":"كم المسافة من مطار جدة إلى المدينة المنورة؟","acceptedAnswer":{"@type":"Answer","text":"نحو 410 كم وتستغرق 3 ساعات و50 دقيقة تقريباً بالسيارة مع توقفات الصلاة والراحة عند الطلب. تنقلك سيارة واحدة من المطار إلى فندقك في المدينة، ويمكن حجز العودة معها."}},{"@type":"Question","name":"أي مركبة تناسب عائلة معها حقائب كثيرة؟","acceptedAnswer":{"@type":"Answer","text":"السيدان تناسب من واحد إلى ثلاثة أشخاص بحقائب عادية. وتناسب سيارات الدفع الرباعي الكبيرة أو الفان العائلي العائلات مع حقائب أكثر، أما الفان الكبير والكوستر فللمجموعات الأكبر. نؤكد المركبة حسب عدد الركاب والحقائب عند عرض السعر."}},{"@type":"Question","name":"كيف أرتب رحلة عودة إلى المطار؟","acceptedAnswer":{"@type":"Answer","text":"أرسل موعد إقلاعك وعنوان الاستلام في جدة أو مكة أو المدينة، ونحسب موعد الانطلاق من وقت رحلتك مع مراعاة المسافة والازدحام. ويمكن حجز الذهاب والعودة في طلب واحد."}},{"@type":"Question","name":"هل أستطيع استئجار سيارة مع سائق بالساعة في جدة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. احجز سيارة وسائقاً لعدد ساعات أو ليوم كامل، وتنتظرك السيارة بين المحطات. أرسل التاريخ ووقت البدء وعدد الساعات ونؤكد السعر قبل الحجز."}},{"@type":"Question","name":"هل تقدمون نقلاً للشركات في جدة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. أرسل بيانات شركتك وقائمة الرحلات بالبريد لنرد بعرض سعر مكتوب. يمكن ترتيب فواتير الشركات عبر شركتنا الشقيقة."}},{"@type":"Question","name":"هل تتوفر سيارات لمجموعات وحافلات؟","acceptedAnswer":{"@type":"Answer","text":"تُرتب الفانات والكوسترات والحافلات الأكبر عند الطلب عبر شبكة شركائنا. أرسل عدد أفراد المجموعة والتواريخ والمسارات ونؤكد المتاح."}},{"@type":"Question","name":"هل يمكنني إلغاء الحجز؟","acceptedAnswer":{"@type":"Answer","text":"نعم. الإلغاء مجاني حتى 24 ساعة قبل موعد الاستلام، ويمكن تعديل الوقت أو العنوان عبر واتساب."}},{"@type":"Question","name":"كيف أدفع؟","acceptedAnswer":{"@type":"Answer","text":"الدفع نقداً للسائق أو بتحويل بنكي، ويمكن إصدار إيصال إلكتروني عند الطلب."}}]}f:["$","$1","c",{"children":[["$","div",null,{"dir":"rtl","lang":"ar","className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"@id\":\"https://taxisaudiarabia.com/ar/locations/jeddah#service\",\"name\":\"تاكسي ونقل خاص وسيارة مع سائق في جدة\",\"inLanguage\":\"ar\",\"description\":\"نقل خاص بحجز مسبق في جدة: من مطار الملك عبدالعزيز وإليه، وجدة–مكة وجدة–المدينة وجدة–الطائف، ونقل الفنادق، وسيارة مع سائق بالساعة، عبر شبكة شركاء. السعر يُتفق عليه قبل الحجز.\",\"url\":\"https://taxisaudiarabia.com/ar/locations/jeddah\",\"provider\":{\"@type\":\"Organization\",\"name\":\"تاكسي السعودية\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"جدة\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":21.5433,\"longitude\":39.1728}},\"availableLanguage\":[\"Arabic\",\"English\"]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/ar/locations/jeddah#webpage\",\"url\":\"https://taxisaudiarabia.com/ar/locations/jeddah\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}]],"$L1d","$L1e","$L1f","$L20","$L21"]}],null,"$L22"]}]
