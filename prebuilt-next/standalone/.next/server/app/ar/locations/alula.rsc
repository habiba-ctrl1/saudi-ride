1b:T676,{"@context":"https://schema.org","@type":"ItemList","numberOfItems":12,"itemListElement":[{"@type":"ListItem","position":1,"name":"AlUla إلى Madinah","url":"https://taxisaudiarabia.com/ar/routes/alula-to-madinah"},{"@type":"ListItem","position":2,"name":"Madinah إلى AlUla","url":"https://taxisaudiarabia.com/ar/routes/madinah-to-alula"},{"@type":"ListItem","position":3,"name":"AlUla إلى Riyadh","url":"https://taxisaudiarabia.com/ar/routes/alula-to-riyadh"},{"@type":"ListItem","position":4,"name":"Riyadh إلى AlUla","url":"https://taxisaudiarabia.com/ar/routes/riyadh-to-alula"},{"@type":"ListItem","position":5,"name":"AlUla إلى Jeddah","url":"https://taxisaudiarabia.com/ar/routes/alula-to-jeddah"},{"@type":"ListItem","position":6,"name":"Jeddah إلى AlUla","url":"https://taxisaudiarabia.com/ar/routes/jeddah-to-alula"},{"@type":"ListItem","position":7,"name":"AlUla إلى NEOM","url":"https://taxisaudiarabia.com/ar/routes/alula-to-neom"},{"@type":"ListItem","position":8,"name":"NEOM إلى AlUla","url":"https://taxisaudiarabia.com/ar/routes/neom-to-alula"},{"@type":"ListItem","position":9,"name":"AlUla إلى AMAALA","url":"https://taxisaudiarabia.com/ar/routes/alula-to-amaala"},{"@type":"ListItem","position":10,"name":"AMAALA إلى AlUla","url":"https://taxisaudiarabia.com/ar/routes/amaala-to-alula"},{"@type":"ListItem","position":11,"name":"AlUla إلى Red Sea International Airport","url":"https://taxisaudiarabia.com/ar/routes/alula-to-red-sea-airport"},{"@type":"ListItem","position":12,"name":"Red Sea International Airport إلى AlUla","url":"https://taxisaudiarabia.com/ar/routes/red-sea-airport-to-alula"}]}1c:T1724,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"هل السائق الخاص مفيد في العلا؟","acceptedAnswer":{"@type":"Answer","text":"نعم إذا كانت لديك أكثر من محطتين. مواقع العلا متباعدة في الوادي والسيارات عند الطلب محدودة، فيبقى معك سائق واحد طوال اليوم ينتظر عند كل محطة ويحمل أمتعتك."}},{"@type":"Question","name":"كيف أصل من مطار العلا إلى فندقي؟","acceptedAnswer":{"@type":"Answer","text":"احجز سيارة خاصة من مطار العلا الدولي (ULH). المسافة نحو 30 كم وتستغرق نحو 30 دقيقة إلى منطقة المنتجعات. نتابع رحلتك، والانتظار بعد الهبوط مجاني من 15 إلى 30 دقيقة."}},{"@type":"Question","name":"هل يوجد استقبال في مطار العلا؟","acceptedAnswer":{"@type":"Answer","text":"نعم، الاستقبال متوفر في صالة الوصول. أرسل رقم رحلتك عند الحجز ونتابعها، وتصلك بيانات السائق على واتساب قبل الموعد."}},{"@type":"Question","name":"هل يمكن ترتيب النقل قبل وصولي؟","acceptedAnswer":{"@type":"Answer","text":"نعم، وهذا هو المعتاد. أرسل رقم الرحلة والفندق وعدد الركاب عبر النموذج أو واتساب، ويُتفق على السعر قبل الحجز."}},{"@type":"Question","name":"كيف أزور عدة معالم في يوم واحد؟","acceptedAnswer":{"@type":"Answer","text":"احجز سائقاً خاصاً بالساعة أو ليوم كامل واذكر الأماكن. الحِجر ودادان وجبل عكمة تُزار عبر تجارب «تجربة العلا»، فاحجز مواعيدها أولاً ونحن نخطط أوقات الطريق حولها."}},{"@type":"Question","name":"هل تأخذونني إلى الحِجر؟","acceptedAnswer":{"@type":"Answer","text":"نعم، إلى مركز زوّار الحِجر حيث تلتقي جولات «تجربة العلا». تحجز الجولة معهم ونرتب نحن السيارة إلى المركز والعودة بحسب موعدك. نقدم النقل فقط وليس الجولة."}},{"@type":"Question","name":"كيف أعود بعد حفل في مرايا؟","acceptedAnswer":{"@type":"Answer","text":"اتفق مسبقاً على موعد ونقطة الاستقبال، فاستقبال مرتب مسبقاً أسهل بكثير من البحث عن سيارة وسط الزحام."}},{"@type":"Question","name":"هل يمكنني السفر من العلا إلى مدينة سعودية أخرى؟","acceptedAnswer":{"@type":"Answer","text":"نعم. المدينة المنورة نحو 330 كم والرياض نحو 1,050 كم وجدة نحو 700 كم بالطريق، كل منها بسيارة خاصة وسعر ثابت يُتفق عليه قبل الحجز."}},{"@type":"Question","name":"هل يمكن الانتقال من منتجعات البحر الأحمر إلى العلا؟","acceptedAnswer":{"@type":"Answer","text":"نعم. مطار البحر الأحمر الدولي والعلا وجهتان منفصلتان تبعدان نحو 260 كم بالطريق (قرابة 4 ساعات و25 دقيقة). ننظم النقل الخاص من المطار أو من منتجع على الساحل إلى فندقك في العلا والعكس. اعتبرها مرحلة مخططة من رحلتك."}},{"@type":"Question","name":"هل جزيرة شورى أو أمالا جزء من العلا؟","acceptedAnswer":{"@type":"Answer","text":"لا. جزيرة شورى وأمالا على ساحل البحر الأحمر والعلا في الداخل؛ وجهات منفصلة. يجمع بينها المسافرون ولذلك يفيد النقل الخاص بين الوجهتين."}},{"@type":"Question","name":"هل يمكن السفر من العلا إلى نيوم أو أمالا؟","acceptedAnswer":{"@type":"Answer","text":"نعم. نيوم نحو 400 كم من العلا بالطريق (قرابة 6 ساعات و45 دقيقة إلى منطقة مطار خليج نيوم)، وأمالا نحو 295 كم كتقدير تخطيطي. كلاهما وجهة منفصلة، فنعاملهما كنقل مخطط بسعر يُتفق عليه قبل الحجز. بعض مواقع نيوم تتطلب تصريح دخول تتولاه أنت مسبقاً."}},{"@type":"Question","name":"ماذا أرسل عند طلب عرض السعر؟","acceptedAnswer":{"@type":"Answer","text":"الاستقبال والوجهة والتاريخ والوقت وعدد الركاب والحقائب الكبيرة، ورقم الرحلة لرحلات المطار، والأماكن التي تريدها ليوم مع سائق. تُختار المركبة معك."}},{"@type":"Question","name":"هل تناسب العائلات ذات الأمتعة الكثيرة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. أخبرنا بعدد الحقائب الكبيرة وأعمار الأطفال لنختار سيارة دفع رباعي كبيرة أو فاناً ليسافر الجميع معاً."}},{"@type":"Question","name":"ما طرق الدفع وهل تصدرون فواتير للشركات؟","acceptedAnswer":{"@type":"Answer","text":"نقداً للسائق أو بتحويل بنكي مع إيصال إلكتروني عند الطلب. يمكن ترتيب فواتير الشركات عبر شركتنا الشقيقة."}},{"@type":"Question","name":"هل يمكن الإلغاء أو التعديل؟","acceptedAnswer":{"@type":"Answer","text":"الإلغاء مجاني حتى 24 ساعة قبل موعد الاستقبال، ويمكن تعديل الوقت أو العنوان عبر واتساب."}}]}f:["$","$1","c",{"children":[["$","div",null,{"dir":"rtl","lang":"ar","className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TaxiService\",\"@id\":\"https://taxisaudiarabia.com/ar/locations/alula#service\",\"name\":\"النقل الخاص وخدمة السائق في العلا\",\"inLanguage\":\"ar\",\"description\":\"نقل خاص بحجز مسبق من مطار العلا الدولي (ULH) وتوصيل الفنادق وسائق خاص ليوم سياحي متعدد المحطات ورحلات بين المدن والبحر الأحمر عبر شبكة شركاء من السائقين المحترفين. السعر يُتفق عليه قبل الحجز.\",\"url\":\"https://taxisaudiarabia.com/ar/locations/alula\",\"provider\":{\"@type\":\"Organization\",\"name\":\"تاكسي السعودية\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"العلا\",\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":26.6084,\"longitude\":37.9153}},\"availableLanguage\":[\"Arabic\",\"English\"]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/ar/locations/alula#webpage\",\"url\":\"https://taxisaudiarabia.com/ar/locations/alula\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}]],"$L1d","$L1e","$L1f","$L20","$L21","$L22"]}],null,"$L23"]}]
