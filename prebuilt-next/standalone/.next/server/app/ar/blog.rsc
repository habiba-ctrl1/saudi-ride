1d:["$","section",null,{"className":"section-container max-w-7xl","aria-labelledby":"all-guides","children":[["$","h2",null,{"id":"all-guides","className":"mb-5 font-heading text-xl font-bold","children":["كل الأدلة"," ",["$","span",null,{"className":"text-base font-medium text-[#94A3B8]","children":["(",35,")"]}]]}],["$","$L28",null,{"posts":[{"href":"/ar/blog/alula-travel-guide-hegra-dadan-transport","title":"دليل السفر إلى العُلا: الحِجر ودادان والبلدة القديمة وكيف تصل إليها","excerpt":"الوصول إلى العُلا جواً (ULH) أو براً من المدينة أو الرياض أو جدة، والتنقل بين الحِجر ودادان والبلدة القديمة والمنتجعات، ومتى يكون السائق الخاص منطقياً.","categoryKey":"AlUla & Tourism","categoryLabel":"العُلا والسياحة","image":"/blog/alula-travel-guide-hegra-dadan-transport.webp","alt":"سيارة SUV داكنة على رمال الصحراء أمام واجهة مقبرة منحوتة في جرف من الحجر الرملي","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/alula-winter-season-travel-guide","title":"العُلا في الشتاء: متى تذهب، وكم تبقى، وكيف ترتّب تنقلاتك الخاصة","excerpt":"التخطيط لزيارة العُلا بين أكتوبر ومارس: أفضل الأشهر، وكم يوماً تحتاج، وبرامج يومية مقترحة، والحجز المبكر لعطلات نهاية الأسبوع المزدحمة، وترتيب التوصيل والسائق.","categoryKey":"AlUla & Tourism","categoryLabel":"العُلا والسياحة","image":"/blog/alula-winter-season-travel-guide.webp","alt":"سيارة SUV سوداء على مسار صحراوي بين تكوينات صخرية رملية تحت سماء صافية","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/best-time-visit-makkah-crowds-weather-umrah","title":"أفضل وقت لزيارة مكة للعمرة: مقارنة بين الزحام والطقس والمواسم","excerpt":"متى تؤدي العمرة؟ مقارنة بين رمضان، والأشهر الباردة، والأسابيع الهادئة بعد الحج، والصيف الحار — الزحام والحرارة والأسعار، وماذا يعني كل موسم للتنقل.","categoryKey":"Umrah","categoryLabel":"العمرة","image":"/blog/best-time-visit-makkah-crowds-weather-umrah.webp","alt":"حشود المعتمرين حول الكعبة في صحن المسجد الحرام وبرج الساعة في الخلف","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/buying-sim-cards-jeddah-airport-stc-mobily-zain","title":"شراء شريحة جوال في مطار جدة: STC أم موبايلي أم زين؟","excerpt":"STC أم موبايلي أم زين؟ كيف تشتري شريحة زائر في مطار جدة، وما المستندات المطلوبة، وبدائل الشريحة الإلكترونية، وكيف تبقى متصلاً في الطريق إلى مكة.","categoryKey":"Travel Tips","categoryLabel":"نصائح السفر","image":"/blog/buying-sim-cards-jeddah-airport-stc-mobily-zain.webp","alt":"أكشاك بيع شرائح الجوال لشركات الاتصالات في صالة الوصول بالمطار","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/car-breakdown-saudi-highway-guide","title":"تعطلت سيارتك على طريق سريع في السعودية؟ 7 خطوات للسلامة وطلب السطحة","excerpt":"ماذا تفعل إذا تعطلت سيارتك على طريق سريع في السعودية: الوقوف الآمن، والمثلث العاكس، والأرقام الصحيحة للاتصال، وإرسال موقعك، والاتفاق على سعر السطحة قبل إرسالها.","categoryKey":"Car Recovery","categoryLabel":"سحب السيارات","image":"/blog/car-breakdown-saudi-highway-guide.webp","alt":"سيارة سيدان بيضاء متوقفة على كتف طريق سريع ومثلث تحذير أحمر خلفها","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/car-towing-cost-saudi-arabia-2026","title":"كم تكلفة سحب السيارة في السعودية؟ دليل أسعار السطحة 2026","excerpt":"كيف تُحسب أسعار السطحة في السعودية: السحب داخل المدينة، وخدمات الطريق كاشتراك البطارية وتغيير الإطار، ونقل السيارات بين المدن، وما يغيّر السعر، وكيف تتجنب المبالغة.","categoryKey":"Car Recovery","categoryLabel":"سحب السيارات","image":"/blog/car-towing-cost-saudi-arabia-2026.webp","alt":"سطحة تحمل سيارة سيدان بجانب شاحنة سحب بخطاف وسلسلة تجرّ سيارة أخرى","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/car-transport-between-saudi-cities","title":"نقل السيارات بين الرياض وجدة والدمام بالسطحة: الدليل الكامل 2026","excerpt":"تحتاج نقل سيارة إلى مدينة أخرى؟ كيف يعمل نقل السيارات بين المدن بالسطحة، والمسارات والمسافات، ومن يستخدمه، وخطوات الحجز، وما تجهّزه، ومقارنته بقيادة السيارة بنفسك.","categoryKey":"Car Recovery","categoryLabel":"سحب السيارات","image":"/blog/car-transport-between-saudi-cities.webp","alt":"سطحة تحمل سيارة بيضاء على طريق سريع وأفق مدينة خلفها","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/complete-miqat-locations-guide-umrah-pilgrims","title":"مواقيت العمرة: أين تُحرم إذا وصلت جواً أو براً؟","excerpt":"المواقيت الخمسة، وأيّها يمرّ عليه طريقك، وماذا تفعل إذا وصلت إلى جدة بالطائرة، وكيف ترتّب التوقف عند الميقات في رحلة خاصة من المدينة أو الطائف أو الرياض.","categoryKey":"Umrah","categoryLabel":"العمرة","image":"/blog/complete-miqat-locations-guide-umrah-pilgrims.webp","alt":"معتمرون بملابس الإحرام البيضاء يجلسون للصلاة في ساحة مسجد عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"6 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/corporate-travel-saudi-arabia-business-etiquette","title":"آداب العمل في السعودية: دليل عملي لاستقبال التنفيذيين الزائرين وتجهيزهم","excerpt":"الاجتماعات والتحية واللباس وأسبوع العمل وأوقات الصلاة والضيافة في بيئة العمل السعودية — دليل عملي لمن يستقبل وفداً أجنبياً أو يجهّز تنفيذيين للزيارة، مع التخطيط للتنقل بين الاجتماعات.","categoryKey":"Business Travel","categoryLabel":"سفر الأعمال","image":"/blog/corporate-travel-saudi-arabia-business-etiquette.webp","alt":"رجلا أعمال ببدلات رسمية يتصافحان في بهو مكتب مشرق وأفق المدينة خلفهما","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/eastern-province-corporate-visitor-transport-guide","title":"سفر الأعمال إلى المنطقة الشرقية: دليل التنقل في الدمام والخبر والظهران والجبيل","excerpt":"زيارة المنطقة الشرقية للعمل: التوصيل من مطار الملك فهد (DMM)، والتنقل بين الدمام والخبر والظهران والجبيل، ودخول المواقع، والمشاريع متعددة الأيام، ورحلات البحرين.","categoryKey":"Business Travel","categoryLabel":"سفر الأعمال","image":"/blog/eastern-province-corporate-visitor-transport-guide.webp","alt":"سيارة سيدان سوداء على طريق سريع ومنشأة صناعية مضاءة في الأفق عند الغسق","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/flatbed-vs-hook-towing-automatic-cars","title":"السطحة أم السحب بالخطاف: أيهما آمن لسيارتك الأوتوماتيك؟","excerpt":"لماذا قد يتلف السحب بالخطاف قير السيارة الأوتوماتيكية والدفع الرباعي والهايبرد، وكيف تحميها السطحة، ومتى يكون الخطاف مقبولاً، وماذا يعني ذلك للضمان والتأمين.","categoryKey":"Car Recovery","categoryLabel":"سحب السيارات","image":"/blog/flatbed-vs-hook-towing-automatic-cars.webp","alt":"سيارة سيدان بيضاء تُسحب بالونش إلى سطح شاحنة سطحة في شارع داخل المدينة","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/how-to-choose-private-chauffeur-company-saudi-arabia","title":"كيف تختار شركة ليموزين وسائق خاص في السعودية: قائمة تحقق للعميل","excerpt":"عشرة أسئلة تسألها قبل حجز سائق خاص أو ليموزين في السعودية — السعر، والسيارة، والسائقون، والتأخير، والإلغاء، والفواتير — والعلامات التي تستدعي الحذر.","categoryKey":"Travel Tips","categoryLabel":"نصائح السفر","image":"/services/business-executive-hero.webp","alt":"رجل أعمال بالشماغ يعمل على حاسب محمول في المقعد الخلفي لسيارة، وأفق المدينة في الخارج","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/jeddah-taxi-fares-cost-guide","title":"أسعار التاكسي في جدة 2026: كم تكلّف الرحلة الخاصة وما الذي يغيّر السعر؟","excerpt":"كيف تُحسب أسعار التاكسي والتوصيل الخاص في جدة — من المطار إلى المدينة، ومن جدة إلى مكة والمدينة والطائف — مع المسافات الحقيقية وما يغيّر السعر وكيف تحصل على سعر ثابت.","categoryKey":"Pricing","categoryLabel":"الأسعار","image":"/blog/jeddah-taxi-fares-cost-guide.webp","alt":"لوحة قيادة سيارة فيها شاشة الأجرة وأوراق نقدية بالريال السعودي، ونخيل خارج الزجاج الأمامي","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/jeddah-to-madinah-taxi-guide-fares","title":"من مطار جدة إلى المدينة المنورة: التوصيل الخاص أم قطار الحرمين أم خيارات أخرى؟","excerpt":"الطرق من مطار جدة (JED) إلى المدينة: توصيل خاص (نحو 410 كم وقرابة 4 ساعات من الباب إلى الباب)، وقطار الحرمين من محطة المطار، والحافلات والطيران — مقارنة منصفة.","categoryKey":"Routes","categoryLabel":"المسارات","image":"/blog/jeddah-to-madinah-taxi-guide-fares.webp","alt":"سيارة سيدان سوداء على طريق صحراوي متعدد المسارات مع لوحات إرشادية وتلال عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/madinah-taxi-fares-cost-guide","title":"أسعار التاكسي في المدينة المنورة 2026: المطار ومكة والمزارات والعُلا","excerpt":"كيف تُحسب أسعار المشاوير الخاصة في المدينة — من مطار المدينة إلى فنادق الحرم، ومن المدينة إلى مكة مع التوقف عند الميقات، وجولات المزارات، والعُلا — مع المسافات ونصائح الحجز.","categoryKey":"Pricing","categoryLabel":"الأسعار","image":"/blog/madinah-taxi-fares-cost-guide.webp","alt":"راكب يناول أوراقاً نقدية لسائق بزي رسمي داخل سيارة","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/madinah-to-makkah-taxi-price-distance-time","title":"من المدينة إلى مكة بالسيارة: المسافة والمدة والتوقف عند الميقات والأسعار","excerpt":"من المدينة إلى مكة بسيارة خاصة: نحو 430 كم وقرابة 4 ساعات مع التوقف عند ميقات أبيار علي. اختيار السيارة، وتوقيت الوصول للعمرة، والقطار كبديل، وكيف يُحسب السعر.","categoryKey":"Routes","categoryLabel":"المسارات","image":"/blog/madinah-to-makkah-taxi-price-distance-time.webp","alt":"فان ركاب أبيض على طريق صحراوي بين تلال صخرية عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/makkah-taxi-fares-cost-guide","title":"أسعار التاكسي في مكة 2026: إلى مطار جدة والمدينة والطائف","excerpt":"كيف تُحسب أسعار المشاوير الخاصة من مكة — إلى مطار جدة والمدينة والطائف والمزارات — مع المسافات، وواقع الاستلام من الفنادق قرب الحرم، وما يغيّر السعر.","categoryKey":"Pricing","categoryLabel":"الأسعار","image":"/blog/makkah-taxi-fares-cost-guide.webp","alt":"أوراق نقدية بالريال السعودي وجوال يعرض خريطة على المقعد الخلفي لسيارة","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/makkah-ziyarat-taxi-holy-sites-tour","title":"مزارات مكة بسيارة خاصة: المواقع وترتيب الجولة والمدة","excerpt":"التخطيط لجولة مزارات مكة: جبل النور، وجبل ثور، ومنى، ومزدلفة، وعرفات، ومسجد عائشة — ترتيب منطقي للجولة، والتوقيت، واللباس، وكيف تعمل الجولة بسيارة خاصة.","categoryKey":"Umrah","categoryLabel":"العمرة","image":"/blog/makkah-ziyarat-taxi-holy-sites-tour.webp","alt":"منظر جوي لجبال مكة والمدينة حول المسجد الحرام وبرج الساعة","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/neom-the-line-visiting-saudi-arabia-city-of-future","title":"السفر إلى نيوم ومنطقة تبوك: المطارات والمسافات البرية والتوصيل","excerpt":"كيف يصل زوار الأعمال والمسافرون إلى منطقة نيوم في منطقة تبوك: الطيران إلى مطار تبوك (TUU)، والمسافات البرية من جدة والرياض، ودخول المواقع، واختيار السيارة.","categoryKey":"City Guides","categoryLabel":"أدلة المدن","image":"/blog/neom-the-line-visiting-saudi-arabia-city-of-future.webp","alt":"منطقة تطوير ساحلية ومرسى على مياه فيروزية أسفل جبال صحراوية عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/private-car-vs-shared-van-umrah","title":"سيارة خاصة أم فان عائلي أم حافلة مشتركة للعمرة: أيّها تختار؟","excerpt":"مقارنة وسائل التنقل في العمرة: سيدان خاصة، أو SUV أو فان خاص لمجموعتك، أو حافلات وخدمات نقل مشتركة. التكلفة للفرد، والراحة، والتوقف عند الميقات، والأمتعة، والتوقيت.","categoryKey":"Umrah","categoryLabel":"العمرة","image":"/services/umrah-transport-hero.webp","alt":"عائلة تحمّل الحقائب في سيارة SUV سوداء في ساحة أسفل برج ساعة شاهق عند الغسق","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/private-driver-cost-saudi-arabia","title":"كم تكلفة السائق الخاص في السعودية؟ الحجز بالساعة وباليوم وبالرحلة","excerpt":"كيف تُحسب تكلفة السائق الخاص في السعودية — بالرحلة أو بالساعة أو لليوم الكامل — وما الذي يغيّر السعر، وكيف تحصل على سعر ثابت لخطتك.","categoryKey":"Pricing","categoryLabel":"الأسعار","image":"/services/vip-luxury-hero.webp","alt":"سائق يفتح الباب الخلفي لسيارة سيدان تنفيذية سوداء أمام مدخل فندق مضاء ليلاً","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"5 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/riyadh-airport-ruh-taxi-guide","title":"دليل الوصول إلى مطار الرياض (RUH): التاكسي والتوصيل الخاص والمترو إلى المدينة والفنادق","excerpt":"الوصول إلى مطار الملك خالد الدولي: الصالات، والمقارنة بين التوصيل الخاص وموقف التاكسي والتطبيقات والمترو، ومدة الطريق إلى العليا والمركز المالي والحي الدبلوماسي، وتوقيت المغادرة.","categoryKey":"Airport Transfers","categoryLabel":"توصيل المطارات","image":"/blog/riyadh-airport-ruh-taxi-guide.webp","alt":"سيارات عند رصيف مبنى مطار حديث بمظلة سقف شبكية","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/riyadh-business-events-executive-transfer-guide","title":"أماكن المؤتمرات في الرياض: دليل النقل التنفيذي إلى RECC وRICEC وKAICC وRFECC","excerpt":"أين تُقام أكبر المعارض والمؤتمرات في الرياض — مركز الرياض للمعارض والمؤتمرات في ملهم، وRICEC، وKAICC، وRFECC — وكيف تخطط للتوصيل التنفيذي والسيارات بالساعة وتنقلات الوفود حولها.","categoryKey":"Events & Conferences","categoryLabel":"الفعاليات والمؤتمرات","image":"/blog/riyadh-business-events-executive-transfer-guide.webp","alt":"سائق ببدلة يفتح الباب الخلفي لسيارة سيدان سوداء أمام مبنى مكاتب زجاجي","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/riyadh-season-taxi-transport-guide","title":"موسم الرياض 2026: دليل التنقل من المطار والفندق إلى مناطق الفعاليات","excerpt":"التنقل في موسم الرياض 2026 (من 21 أكتوبر): منطقتا بوليفارد وورلد وبوليفارد سيتي في حطين، والنزول والعودة المتأخرة، والعائلات والمجموعات، والحجز المسبق في ليالي الفعاليات.","categoryKey":"Events & Conferences","categoryLabel":"الفعاليات والمؤتمرات","image":"/blog/riyadh-season-taxi-transport-guide.webp","alt":"سيارة سيدان سوداء متوقفة أمام شارع ترفيهي مزدحم ومضاء ليلاً","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/riyadh-to-diriyah-visitor-transport-guide","title":"من الرياض إلى الدرعية: دليل الزيارة والتنقل إلى حي الطريف ومطل البجيري","excerpt":"كيف تذهب من الرياض إلى الدرعية — حي الطريف، ومطل البجيري، وأفضل وقت للزيارة، وأين ينزلك السائق، ولماذا تكون السيارة الخاصة بموعد عودة محدد الخيار الأسهل.","categoryKey":"City Guides","categoryLabel":"أدلة المدن","image":"/services/heritage-tours-hero.webp","alt":"سيارة SUV سوداء على طريق محاط بالنخيل أمام بلدة طينية مرممة عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/riyadh-to-dubai-taxi-gcc-road-trip","title":"من الرياض إلى دبي براً: المسافة وعبور الحدود ودليل السيارة الخاصة","excerpt":"من الرياض إلى دبي بسيارة خاصة: نحو 990 كم وقرابة 9 ساعات مع منفذ البطحاء–الغويفات. ماذا تتضمن الرحلة، والمستندات، ومتى تتفوق على الطيران، وطريقة الحجز.","categoryKey":"Routes","categoryLabel":"المسارات","image":"/blog/riyadh-to-dubai-taxi-gcc-road-trip.webp","alt":"سيارة SUV سوداء على طريق سريع تقترب من أفق مدينة فيه برج شاهق عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"3 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/saudi-arabia-business-travel-transportation-guide","title":"دليل التنقل لرحلات العمل في السعودية للتنفيذيين القادمين من الخارج","excerpt":"التنقل في رحلات العمل إلى الرياض وجدة والمنطقة الشرقية: الاستقبال في المطار، أيام الاجتماعات من الفندق، السائق بالساعة، الرحلات بين المدن، الفعاليات، وحجوزات الشركات مع الفواتير.","categoryKey":"Business Travel","categoryLabel":"سفر الأعمال","image":"/services/corporate-hero.webp","alt":"سائقان بجانب سيارة سيدان سوداء في حي أعمال بأبراج زجاجية","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"5 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/saudi-arabia-event-conference-transportation-guide","title":"دليل التنقل في الفعاليات والمؤتمرات بالسعودية للزوار من الخارج","excerpt":"التخطيط للتنقل في معرض أو مؤتمر أو فعالية بالرياض أو جدة: من المطار إلى الفندق، ومن الفندق إلى المكان، والتنقلات اليومية، والمجموعات وكبار الضيوف، والحجز المبكر، وطلب عرض سعر للشركات.","categoryKey":"Events & Conferences","categoryLabel":"الفعاليات والمؤتمرات","image":"/gallery/event-fleet-lineup-sedan-suv-van-coaster-riyadh.webp","alt":"سيارة سيدان وسيارات SUV وفان وحافلة كوستر مصطفة أمام مدخل مركز معارض","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/saudi-arabia-family-group-transport-guide","title":"دليل السائق الخاص والتنقل للعائلات والمجموعات في السعودية","excerpt":"كيف تختار السيارة المناسبة لعائلتك أو مجموعتك في السعودية — سيدان أو SUV أو فان أو ميني باص أو كوستر — مع قواعد الأمتعة، والأطفال، وكبار السن، ونصائح المطار والسفر بين المدن، وطريقة طلب السعر.","categoryKey":"Travel Tips","categoryLabel":"نصائح السفر","image":"/gallery/umrah-family.webp","alt":"عائلة مع عربة أمتعة تلتقي بسائق بجانب سيارة داخل صالة مطار","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/saudi-arabia-intercity-transfer-guide","title":"دليل التنقل بين المدن في السعودية: الرياض وجدة ومكة والمدينة والعُلا","excerpt":"التخطيط لتوصيل خاص بين المدن السعودية: المسافات ومدة القيادة لأهم المسارات، السيارة أم القطار أم الطائرة، ما يؤثر على مدة الرحلة، واختيار السيارة والأمتعة والعائلات، وطريقة الحجز.","categoryKey":"Routes","categoryLabel":"المسارات","image":"/services/intercity-hero.webp","alt":"سيارة SUV سوداء على طريق صحراوي بجانب خط سكة حديد عند الغروب","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"5 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/saudi-riyal-cash-cards-guide-pilgrims","title":"دليل الريال السعودي للزوار والمعتمرين: النقد والبطاقات ومدى والصراف الآلي","excerpt":"التعامل بالمال في السعودية: سعر الريال الثابت مقابل الدولار، وأين تعمل البطاقات والدفع بالجوال، ومتى تحتاج النقد، والصراف الآلي، ونصائح الصرف، والدفع مقابل التنقل.","categoryKey":"Travel Tips","categoryLabel":"نصائح السفر","image":"/blog/saudi-riyal-cash-cards-guide-pilgrims.webp","alt":"أوراق نقدية بالريال السعودي وبطاقة دفع على طاولة خشبية","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"},{"href":"/ar/blog/taxi-cost-saudi-arabia-price-guide","title":"كم تكلفة التاكسي في السعودية؟ مقارنة بين تاكسي العدّاد والتطبيقات والتوصيل بسعر ثابت","excerpt":"تاكسي بالعدّاد أم تطبيق نقل أم توصيل محجوز مسبقاً؟ كيف يُسعَّر كلٌّ منها في السعودية، وما الذي يرفع السعر، وأيّها يناسب رحلات المطار والمدينة وبين المدن.","categoryKey":"Pricing","categoryLabel":"الأسعار","image":"/blog/taxi-cost-saudi-arabia-price-guide.webp","alt":"أوراق نقدية وعملات معدنية بالريال السعودي على صينية لوحة قيادة سيارة مع ظهور المقود","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/umrah-season-autumn-winter-family-group-transport","title":"العمرة في الخريف والشتاء: خطة تنقل للعائلات والمجموعات","excerpt":"التخطيط للعمرة بين أكتوبر ومارس مع العائلة أو المجموعة: مطارات الوصول، وترتيب المدن، وأحجام السيارات، والتوقف عند الميقات، وأيام المزارات، وحجز كل الرحلات معاً.","categoryKey":"Umrah","categoryLabel":"العمرة","image":"/blog/umrah-season-autumn-winter-family-group-transport.webp","alt":"عائلة تحمّل حقائب في فان أبيض عند رصيف مطار تحت مظلة كبيرة","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/vip-airport-meet-greet-saudi-arabia","title":"خدمة الاستقبال في المطارات السعودية: ماذا تتوقع في جدة والرياض والمدينة والدمام؟","excerpt":"كيف يعمل الاستقبال المحجوز مسبقاً في مطارات السعودية — ما ترسله عند الحجز، وكيف يجدك السائق، وماذا يحدث إن تأخرت رحلتك، وما الذي يضيفه استقبال كبار الضيوف.","categoryKey":"Airport Transfers","categoryLabel":"توصيل المطارات","image":"/blog/vip-airport-meet-greet-saudi-arabia.webp","alt":"سائق ببدلة داكنة يحمل بطاقة باسم الراكب في صالة وصول بالمطار","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"4 دقائق قراءة","featured":"$undefined"},{"href":"/ar/blog/what-is-a-satha-flatbed-tow-truck","title":"ما هي السطحة؟ دليل سطحات نقل وسحب السيارات في السعودية","excerpt":"السطحة شاحنة بسطح مستوٍ تُحمَّل عليه السيارة بالكامل. كيف تعمل، ومتى تحتاجها، والفرق بينها وبين السحب بالخطاف، وكيف تطلبها بسرعة وبسعر متفق عليه مسبقاً.","categoryKey":"Car Recovery","categoryLabel":"سحب السيارات","image":"/blog/what-is-a-satha-flatbed-tow-truck.webp","alt":"سطحة تحمل سيارة SUV بيضاء على طريق صحراوي تحت لوحات إرشادية إلى مكة والطائف","dateLabel":"٢ أكتوبر ٢٠٢٦","readLabel":"2 دقيقة قراءة","featured":"$undefined"}],"categories":[{"key":"Airport Transfers","label":"توصيل المطارات","count":2},{"key":"Routes","label":"المسارات","count":4},{"key":"City Guides","label":"أدلة المدن","count":2},{"key":"Business Travel","label":"سفر الأعمال","count":3},{"key":"Umrah","label":"العمرة","count":5},{"key":"AlUla & Tourism","label":"العُلا والسياحة","count":2},{"key":"Events & Conferences","label":"الفعاليات والمؤتمرات","count":3},{"key":"Travel Tips","label":"نصائح السفر","count":4},{"key":"Pricing","label":"الأسعار","count":5},{"key":"Car Recovery","label":"سحب السيارات","count":5}],"allLabel":"الكل","readLabel":"اقرأ الدليل","emptyLabel":"لا توجد أدلة في هذا التصنيف بعد."}]]}]
