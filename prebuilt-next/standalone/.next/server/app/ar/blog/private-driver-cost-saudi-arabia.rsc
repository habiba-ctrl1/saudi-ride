32:["$","p","p-2",{"children":["العامل الأكبر. عبر شبكة شركائنا يمكنك حجز ",["$","strong","strong-0",{"children":"سيدان تنفيذية"}]," (فئة تويوتا كامري وفورد تورس وجينيسيس G80)، أو ",["$","strong","strong-1",{"children":"SUV كبيرة"}]," (جي إم سي يوكن XL، كاديلاك إسكاليد)، أو ",["$","strong","strong-2",{"children":"فان"}]," (هيونداي ستاريا)، أو سيارة ",["$","strong","strong-3",{"children":"فاخرة"}]," (مرسيدس الفئة S، بي إم دبليو الفئة السابعة)، أو ",["$","strong","strong-4",{"children":"ميني باص / كوستر"}]," للمجموعات. السيارات الأكبر والأفخم أغلى بالساعة وبالرحلة. اطّلع على ",["$","$L25","a-0",{"href":"/fleet","children":"فئات السيارات وسعتها"}]," قبل الاختيار — فدفع ثمن SUV بينما تكفيك سيدان أكثر أسباب زيادة التكلفة شيوعاً."]}]
33:["$","h3","h3-1",{"id":"الساعات-والمسافة","children":"الساعات والمسافة"}]
34:["$","p","p-3",{"children":"الحجز بالساعة يعتمد أساساً على الوقت، لكن المسافة تُحسب أيضاً: يوم داخل الرياض يختلف عن يوم فيه مشوار إلى الدرعية والعودة، أو رحلة من جدة إلى مكة. أخبرنا بالمسار التقريبي لا بعدد الساعات فقط."}]
35:["$","h3","h3-2",{"id":"المدينة-والتوقيت","children":"المدينة والتوقيت"}]
36:["$","p","p-4",{"children":"طريقة التسعير واحدة في كل المدن، لكن التوفر يختلف — فمكة والمدينة في رمضان، أو الرياض أثناء المعارض الكبرى وموسم الرياض، أكثر ازدحاماً من يوم عادي. كلما حجزت مبكراً في تلك الفترات، اتسعت خياراتك. والرحلات في آخر الليل أو الفجر إلى المطار طبيعية وتُحجز كأي وقت آخر."}]
37:["$","h3","h3-3",{"id":"ما-الذي-لا-يغيره","children":"ما الذي لا يغيّره"}]
38:["$","p","p-5",{"children":["الزحام والطلب لا يغيّران السعر بعد الاتفاق عليه. ",["$","strong","strong-0",{"children":"لا عدّاد ولا زيادة وقت الذروة"}]," — السعر الذي تؤكده قبل الحجز هو سعر الرحلة التي وصفتها."]}]
39:["$","h2","h2-2",{"id":"ما-الذي-يشمله-السعر-وما-الذي-توضحه-مسبقا","children":"ما الذي يشمله السعر — وما الذي توضّحه مسبقاً"}]
3a:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"السائق والسيارة طوال المدة المحجوزة."}]," في الحجز بالساعة أو لليوم ينتظرك السائق بين المحطات، وهذا الانتظار هو ما تدفع مقابله."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"الوقود"}]," جزء من السعر للرحلة التي وصفتها."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"التغييرات في اليوم نفسه"}]," — مدينة إضافية لم تُخطّط، أو تجاوز الساعات المحجوزة بكثير — تحتاج اتفاقاً معنا لأنها تغيّر الرحلة."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"الدفع"}]," نقداً للسائق أو بتحويل بنكي، و",["$","strong","strong-1",{"children":"الإيصالات الإلكترونية"}]," متاحة عند الطلب. وللحجوزات باسم الشركات يمكن إصدار فاتورة للشركة عند الطلب."]}],"\n",["$","li","li-4",{"children":[["$","strong","strong-0",{"children":"الإلغاء"}]," مجاني حتى 24 ساعة قبل الموعد."]}],"\n"]}]
3b:["$","h2","h2-3",{"id":"استخدامات-شائعة-وأي-طريقة-تناسبها","children":"استخدامات شائعة وأي طريقة تناسبها"}]
3c:["$","h3","h3-4",{"id":"يوم-اجتماعات-في-الرياض","children":"يوم اجتماعات في الرياض"}]
3d:["$","p","p-6",{"children":["العليا صباحاً، والمركز المالي ظهراً، والحي الدبلوماسي عصراً، ثم العشاء. بالحجز رحلةً رحلة ستنسّق أربع أو خمس عمليات استلام؛ وبالحجز بالساعة يكون السائق نفسه أمام كل مبنى حين تخرج. ويختار أغلب زوار الأعمال ",["$","$L25","a-0",{"href":"/locations/riyadh/private-driver","children":"سيدان تنفيذية أو SUV بالساعة"}],"."]}]
3e:["$","h3","h3-5",{"id":"المزارات-في-مكة-أو-المدينة","children":"المزارات في مكة أو المدينة"}]
3f:["$","p","p-7",{"children":["المواقع التاريخية متباعدة والتوقف عند كل منها قصير، لذلك تكون ساعات قليلة بسيارة وسائق واحد هي الطريقة المعتادة — انظر ",["$","$L25","a-0",{"href":"/ar/services/makkah-ziyarat","children":"مزارات مكة"}]," و",["$","$L25","a-1",{"href":"/services/madinah-ziyarat","children":"مزارات المدينة"}],"."]}]
40:["$","h3","h3-6",{"id":"الوصول-من-المطار-ثم-مواعيد-بعد-الظهر","children":"الوصول من المطار ثم مواعيد بعد الظهر"}]
41:["$","p","p-8",{"children":"احجز التوصيل من المطار بالرحلة وأضف ساعات على الحجز نفسه، بدلاً من ترتيب سيارة ثانية بعد تسجيل الدخول في الفندق."}]
42:["$","h3","h3-7",{"id":"رحلة-عائلية-خارج-المدينة","children":"رحلة عائلية خارج المدينة"}]
43:["$","p","p-9",{"children":"الدرعية من الرياض، أو الطائف من مكة، أو البلد والكورنيش في جدة. الحجز ليوم كامل بفان أو SUV يُبقي الجميع معاً ويترك مساحة لأكياس التسوق."}]
44:["$","h2","h2-4",{"id":"سائق-خاص-أم-تطبيقات-النقل","children":"سائق خاص أم تطبيقات النقل؟"}]
45:["$","p","p-10",{"children":"تطبيقات النقل مناسبة للمشاوير القصيرة المنفردة إذا كان لديك إنترنت ولا أمتعة معك. لكنها أقل ملاءمة للأيام متعددة المحطات: تعيد الطلب لكل مشوار، وتتغير السيارة والسائق كل مرة، وقد ترتفع الأسعار وقت الذروة. السائق الخاص المحجوز مسبقاً أغلى من أرخص مشوار بالتطبيق، لكنه يمنحك سعراً واحداً متفقاً عليه، وسيارة تنتظرك، وسائقاً يعرف خطة يومك — ولهذا يختاره رجال الأعمال والعائلات مع الأطفال ومن يزور المملكة أول مرة."}]
46:["$","h2","h2-5",{"id":"كيف-تحصل-على-سعر-دقيق","children":"كيف تحصل على سعر دقيق؟"}]
47:["$","p","p-11",{"children":["أرسل لنا أربعة أشياء: ",["$","strong","strong-0",{"children":"المدينة، التاريخ ووقت البداية، قائمة تقريبية بالمحطات، وعدد الركاب والحقائب."}]," ونرد عليك بفئة السيارة المناسبة وسعر ثابت لتلك الخطة. وإن تغيّرت الخطة قبل الموعد، أخبرنا ويُحدَّث العرض قبل السفر."]}]
48:["$","h2","h2-6",{"id":"أسئلة-شائعة","children":"أسئلة شائعة"}]
49:["$","h3","h3-8",{"id":"هل-يوجد-حد-أدنى-للحجز-بالساعة","children":"هل يوجد حد أدنى للحجز بالساعة؟"}]
4a:["$","p","p-12",{"children":"غالباً نعم — للحجز بالساعة حد أدنى من الساعات. اسأل عند الحجز ونؤكده لك بحسب المدينة والسيارة."}]
4b:["$","h3","h3-9",{"id":"هل-يمكن-حجز-سائق-لعدة-أيام","children":"هل يمكن حجز سائق لعدة أيام؟"}]
