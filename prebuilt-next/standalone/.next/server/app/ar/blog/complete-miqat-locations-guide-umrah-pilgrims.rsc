36:["$","h2","h2-2",{"id":"ذو-الحليفة-أبيار-علي-ميقات-المدينة","children":"ذو الحليفة (أبيار علي) — ميقات المدينة"}]
37:["$","p","p-3",{"children":["ذو الحليفة ميقات كل من يسافر ",["$","strong","strong-0",{"children":"من المدينة المنورة إلى مكة"}],"، وهو أبعد المواقيت عن مكة. يقع المسجد على الطرف الجنوبي للمدينة، على بُعد مسافة قصيرة بالسيارة من المنطقة المركزية حول المسجد النبوي، وفيه مرافق واسعة للاغتسال وتبديل الملابس."]}]
38:["$","p","p-4",{"children":["وهو الميقات الذي يمرّ عليه أغلب المعتمرين القادمين من الخارج براً، لأن كثيراً من البرامج تبدأ بالمدينة ثم مكة. فإن سافرت بسيارة خاصة، تُحرم في فندقك أو في المسجد، وتصلّي هناك وتنوي، ثم تواصل جنوباً على طريق الهجرة. و",["$","$L25","a-0",{"href":"/ar/routes/madinah-to-makkah","children":"التوصيل من المدينة إلى مكة"}]," نحو 430 كم، أي قرابة 4 ساعات قيادة، يُضاف إليها وقت التوقف عند الميقات."]}]
39:["$","p","p-5",{"children":"وإن اخترت قطار الحرمين من المدينة، فيلزمك أن تكون محرماً قبل أن يتجاوز القطار الميقات، ولذلك يُحرم أكثر المعتمرين في الفندق أو يتوقفون عند أبيار علي في طريقهم إلى المحطة."}]
3a:["$","h2","h2-3",{"id":"الجحفة-قرب-رابغ","children":"الجحفة — قرب رابغ"}]
3b:["$","p","p-6",{"children":"الجحفة، قرب مدينة رابغ شمال جدة، ميقات الطريق الشمالي الغربي — وكانت تاريخياً ميقات أهل الشام ومصر وشمال أفريقيا، وهي اليوم ميقات من يقود جنوباً على طريق الساحل. ويقصدها أيضاً بعض من يصل إلى جدة دون إحرام (انظر أدناه)، ولهذا تُطلب أحياناً رحلة «ذهاب وعودة» من جدة."}]
3c:["$","h2","h2-4",{"id":"قرن-المنازل-السيل-الكبير-ووادي-محرم","children":"قرن المنازل — السيل الكبير ووادي محرم"}]
3d:["$","p","p-7",{"children":["قرن المنازل ميقات القادم براً ",["$","strong","strong-0",{"children":"من الطائف والرياض والشرق"}],". وله مسجدان، كلٌّ على طريق من الطريقين النازلين إلى مكة:"]}]
3e:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"السيل الكبير"}]," على طريق السيل، وهو الطريق الذي يسلكه معظم القادمين من الرياض ودول الخليج."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"وادي محرم"}]," على طريق الهدا الجبلي من الطائف."]}],"\n"]}]
3f:["$","p","p-8",{"children":["فإن سافرت ",["$","$L25","a-0",{"href":"/ar/routes/riyadh-to-makkah","children":"من الرياض إلى مكة بسيارة خاصة"}]," — نحو 870 كم وقرابة 8 ساعات — فالميقات يأتي قرب نهاية رحلة طويلة جداً، فرتّب ملابس الإحرام والتوقف قبل الانطلاق. أما من الطائف فالميقات قريب من بداية النزول."]}]
40:["$","h2","h2-5",{"id":"يلملم-وذات-عرق","children":"يلملم وذات عرق"}]
41:["$","p","p-9",{"children":[["$","strong","strong-0",{"children":"يلملم"}]," (السعدية) ميقات طريق الجنوب على الساحل، ومنه القادمون من اليمن وجنوب المملكة. و",["$","strong","strong-1",{"children":"ذات عرق"}]," ميقات طريق الشمال الشرقي. وقلّ أن يمرّ بهما الزائر الدولي براً، لكنهما مهمّان لمن يقود من تلك الجهات."]}]
42:["$","h2","h2-6",{"id":"إذا-وصلت-إلى-جدة-بالطائرة","children":"إذا وصلت إلى جدة بالطائرة"}]
43:["$","p","p-10",{"children":["هذا أكثر سؤال يطرحه من يعتمر أول مرة. ",["$","strong","strong-0",{"children":"جدة داخل حدود المواقيت"}],"، فإذا سافرت إلى جدة بنية العمرة، ستعبر طائرتك خط الميقات قبل الهبوط، فيلزمك أن تُحرم — أو على الأقل أن تنوي — قبل تلك النقطة."]}]
44:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"تُعلن أغلب شركات الطيران المتجهة إلى جدة عن اقتراب الميقات. البس الإحرام قبل الصعود أو أثناء الرحلة، وانوِ عند الإعلان."}],"\n",["$","li","li-1",{"children":"يفضّل كثيرون لبس الإحرام في مطار المغادرة، لأن دورات مياه الطائرة ضيقة ومزدحمة."}],"\n",["$","li","li-2",{"children":["بعد الهبوط تتجه مباشرة ",["$","$L25","a-0",{"href":"/ar/routes/jeddah-airport-to-makkah","children":"من مطار جدة إلى مكة"}]," — نحو 80 كم وقرابة ساعة — وأنت محرم."]}],"\n"]}]
45:["$","h3","h3-0",{"id":"إن-وصلت-إلى-جدة-دون-إحرام","children":"إن وصلت إلى جدة دون إحرام"}]
46:["$","p","p-11",{"children":["للعلماء أقوال في حكم من جاوز الميقات جواً دون إحرام، ",["$","strong","strong-0",{"children":"فاسأل عالماً تثق به قبل السفر"}],". ومن الاحتياط الشائع أن يخرج المعتمر إلى أحد المواقيت — غالباً الجحفة قرب رابغ — فيُحرم منه ثم يتجه إلى مكة. وهذا يحوّل رحلة المطار التي تستغرق ساعة إلى رحلة أطول بكثير، فإن عرفت مسبقاً أنك ستفعل ذلك، فاحجزها رحلة واحدة مع توقف بدلاً من رحلتين منفصلتين."]}]
47:["$","h3","h3-1",{"id":"المقيم-في-جدة","children":"المقيم في جدة"}]
48:["$","p","p-12",{"children":"من كان مقيماً داخل حدود المواقيت — كسكان جدة — يُحرم في الغالب من مكانه. أما الزائر الذي جاء لعمل في جدة ثم قرّر أداء العمرة، فليسأل عن الحكم الذي ينطبق على حالته."}]
49:["$","h2","h2-7",{"id":"ترتيب-التوقف-عند-الميقات-في-رحلة-خاصة","children":"ترتيب التوقف عند الميقات في رحلة خاصة"}]
4a:["$","p","p-13",{"children":"السيارة الخاصة أكثر الخيارات مرونة مع الميقات، لأن التوقف يصبح جزءاً من رحلتك لا شيئاً تحشره بين مواعيد ثابتة:"}]
4b:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"أخبرنا عند الحجز"}]," أنك تحتاج التوقف عند الميقات، وكم تقريباً من الوقت — الاغتسال وتبديل الملابس وركعتان تأخذ عادة 20–40 دقيقة، وأكثر للعائلات مع الأطفال."]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"ضع الإحرام في حقيبة اليد"}],"، مع منشفة صغيرة وصابون بلا رائحة ونعال، لا في حقيبة كبيرة في صندوق السيارة."]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"انتبه للوقت."}]," الوصول إلى مكة ليلاً بعد رحلة طويلة وتوقف عند الميقات أمر شائع؛ اختر موعد انطلاق يُبقي لك طاقة للطواف والسعي."]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"العائلات وكبار السن"}]," يفضّلون غالباً ",["$","$L25","a-0",{"href":"/fleet","children":"سيارة SUV كبيرة أو فان"}]," لرحلة المدينة–مكة، حتى يستطيع الجميع التبديل والراحة دون إنزال الحقائب."]}],"\n"]}]
