3b:["$","$L47",null,{"data":{"routeId":"riyadh_kuwait_airport","code":"KWI","destinationLabel":"مطار الكويت الدولي (KWI)، الكويت","heading":"من الرياض إلى مطار الكويت الدولي (KWI)","answer":"يمكنك طلب سيارة خاصة من عنوانك في الرياض إلى مطار الكويت الدولي (KWI). تسير الرحلة على مسار الرياض – مدينة الكويت: حوالي 650 كم ونحو 6 ساعات و30 دقيقة قيادة، يضاف إليها وقت الحدود، إلى ساحل الخليج عند الخفجي ثم العبور من النويصيب، وتنتهي عند المطار بدل عنوان في المدينة. نؤكد قبل قبول الحجز تصاريح السيارة وإجراءات الحدود ونقطة النزول النهائية.","distinctions":[{"name":"مدينة الكويت","desc":"فنادق ومكاتب ومنازل في وسط المدينة أو السالمية أو حولي. اختر هذا إذا كنت ستقيم في الكويت."},{"name":"مطار الكويت الدولي (KWI)","desc":"نزول عند المطار لرحلة جوية. يُحدد وقت الاستلام في الرياض من موعد إقلاعك مضافًا إليه الحدود، لا من عنوان فندق."},{"name":"الفحيحيل والأحمدي","desc":"بلدتان جنوب المدينة تمر بهما أولًا، إن كانت وجهتك فيهما لا المطار."}],"askFor":["عنوان الاستلام في الرياض وتاريخ السفر","موعد رحلتك في مطار الكويت الدولي إن كنت مسافرًا منه","الصالة أو نقطة النزول المفضلة في المطار (لا نفترض صالة معينة)","عدد الركاب والأمتعة وحجمها، وذهاب فقط أو ذهاب وعودة"],"tradeOff":{"heading":"سيارة خاصة إلى KWI أم الطيران من الرياض؟","body":["الطريق إلى الكويت يوم طويل، ووقت الحدود يتفاوت. إذا كان عليك اللحاق برحلة محددة في KWI فاترك هامشًا واسعًا وأخبرنا بالموعد النهائي لنقول لك بصدق إن كان التوقيت ممكنًا.","السيارة أنسب للعائلات والمجموعات وأصحاب الأمتعة الكثيرة، أو حين تبدأ خططك في الكويت من عنوان لا من المطار. أما لمسافر وحيد بحقيبة صغيرة ورحلة بموعد ثابت فتحقق من خيارات الطيران أولًا."]},"entryNote":"يحتاج كل راكب إلى حق دخول الكويت، ويحتاج المقيمون في السعودية عادةً إلى تأشيرة خروج وعودة سارية. تحقق من المتطلبات الحالية من المصادر الرسمية قبل السفر — تاكسي السعودية لا تصدر التأشيرات ولا تتولى إجراءات الجوازات.","cta":"اطلب نقلًا خاصًا إلى مطار الكويت","faqs":[{"question":"هل يمكنكم توصيلي من الرياض إلى مطار الكويت الدولي (KWI)؟","answer":"نعم عند الطلب. تقلك سيارة خاصة من الرياض إلى المطار عبر منفذ الخفجي – النويصيب. نؤكد معك تصاريح السيارة وإجراءات الحدود والتوفر والسعر قبل الحجز."},{"question":"ما الفرق بين الرياض إلى مدينة الكويت والرياض إلى KWI؟","answer":"الطريق والمنفذ واحدان. مدينة الكويت تعني عنوان فندق أو مكتب أو منزل، أما KWI فنزول لرحلة جوية، فيُحدد استلام الرياض بالرجوع من موعد إقلاعك. أعطنا الصالة أو نقطة النزول المفضلة عند طلب السعر."},{"question":"هل يمكن أن يحل هذا محل رحلة جوية ملغاة؟","answer":"لا نستطيع وعدك بذلك. النقل البري يعتمد على التوفر والمسار والسلامة وظروف الحدود وحقك في دخول الكويت. تحقق من حالة رحلتك لدى شركة الطيران ومن إشعارات المطار الرسمية، ثم اسألنا إن كان النقل البري ممكنًا."}],"waText":"السلام عليكم، أرغب بعرض سعر لنقل خاص إلى المطار.\n\n• المسار: من الرياض إلى مطار الكويت الدولي (KWI)، الكويت\n• عنوان الاستلام: \n• تاريخ السفر: \n• وقت الاستلام: \n• عدد الركاب: \n• الأمتعة (العدد والحجم التقريبي): \n• نوع السيارة (سيدان / SUV / فان): \n• نوع الرحلة (ذهاب / ذهاب وعودة): \n• موعد الرحلة الجوية والصالة أو نقطة النزول المفضلة: \n• متطلبات إضافية: \n\nأرجو تأكيد توفر السيارة والسعر الإجمالي وجدوى الرحلة وأي متطلبات حدودية قبل الحجز."},"path":"/ar/routes/riyadh-to-kuwait","quoteAnchor":"#route-quote","locale":"ar"}]
