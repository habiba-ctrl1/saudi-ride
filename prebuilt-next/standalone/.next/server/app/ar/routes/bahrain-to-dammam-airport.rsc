1b:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] pb-28 text-[#1C1C1C] lg:pb-16","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"نقل خاص البحرين إلى مطار الدمام (الملك فهد الدولي)\",\"description\":\"التاكسي من البحرين إلى مطار الدمام سيارة خاصة محجوزة مسبقًا مع سائق من عنوانك في البحرين عبر جسر الملك فهد إلى مطار الملك فهد الدولي. المسافة حوالي 105 كم ونحو ساعة و20 دقيقة قيادة إضافة إلى وقت الحدود، لذلك نحدد موعد الانطلاق بهامش كافٍ قبل إنهاء إجراءات السفر. رسوم الجسر مشمولة.\",\"serviceType\":\"نقل خاص عبر الحدود\",\"url\":\"https://taxisaudiarabia.com/ar/routes/bahrain-to-dammam-airport\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Saudi Arabia\"},{\"@type\":\"Place\",\"name\":\"Bahrain\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"متى أنطلق من البحرين لرحلة من مطار الدمام؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"احسب من موعد إنهاء الإجراءات: نحو ساعة و20 دقيقة قيادة، ووقت الجسر المتغير، وهامش أمان. أخبرنا بموعد رحلتك ونقترح وقت الانطلاق.\"}},{\"@type\":\"Question\",\"name\":\"من أين تستلمونني في البحرين؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"من أي مكان في الجزيرة — المنامة والسيف والجفير والمحرق والرفاع وغيرها.\"}},{\"@type\":\"Question\",\"name\":\"هل رسوم الجسر مشمولة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، رسوم جسر الملك فهد للسيارة مشمولة في السعر الثابت.\"}},{\"@type\":\"Question\",\"name\":\"ما الوثائق المطلوبة لدخول السعودية؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"جواز أو هوية مقبولة وحق دخول السعودية لكل راكب. تحقق من المصادر الرسمية قبل السفر.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"