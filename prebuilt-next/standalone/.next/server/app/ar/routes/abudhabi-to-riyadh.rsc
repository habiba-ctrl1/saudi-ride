1b:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] pb-28 text-[#1C1C1C] lg:pb-16","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"نقل خاص أبوظبي، الإمارات إلى الرياض\",\"description\":\"السيارة الخاصة مع سائق من أبوظبي إلى الرياض حوالي 850 كم ونحو 8 ساعات قيادة، يضاف إليها وقت الحدود. يستلمك السائق من أي مكان في أبوظبي، ويسلك طريق E11 غربًا إلى منفذ الغويفات – البطحاء ثم يكمل إلى عنوانك في الرياض. رسوم عبور السيارة مشمولة في السعر الثابت.\",\"serviceType\":\"نقل خاص عبر الحدود\",\"url\":\"https://taxisaudiarabia.com/ar/routes/abudhabi-to-riyadh\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Saudi Arabia\"},{\"@type\":\"Place\",\"name\":\"UAE\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"كم تستغرق الرحلة من أبوظبي إلى الرياض؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نحو 8 ساعات قيادة لمسافة حوالي 850 كم عبر منفذ الغويفات – البطحاء، يضاف إليها وقت الحدود والاستراحات.\"}},{\"@type\":\"Question\",\"name\":\"هل تستلمون من أي مكان في أبوظبي؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، من الكورنيش والسعديات وجزيرة ياس ومدينة خليفة أو أي عنوان في المدينة.\"}},{\"@type\":\"Question\",\"name\":\"هل رسوم العبور مشمولة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، رسوم عبور السيارة مشمولة في السعر الثابت.\"}},{\"@type\":\"Question\",\"name\":\"ما الوثائق المطلوبة لدخول السعودية؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"جواز أو هوية مقبولة وحق دخول السعودية لكل راكب. تحقق من المصادر الرسمية قبل السفر — لا نصدر التأشيرات.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"