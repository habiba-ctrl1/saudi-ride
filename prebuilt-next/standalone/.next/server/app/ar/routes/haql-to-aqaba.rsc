1b:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] pb-28 text-[#1C1C1C] lg:pb-16","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"نقل خاص حقل إلى العقبة، الأردن\",\"description\":\"النقل الخاص من حقل إلى العقبة حوالي 40 كم ونحو 35 دقيقة قيادة، يضاف إليها وقت منفذ الدرة بين المدينتين، وهو أقصر طريق بري بين السعودية والأردن. يستلمك السائق في حقل ويوصلك إلى فندقك أو عنوانك في العقبة، ورسوم عبور السيارة مشمولة في السعر الثابت.\",\"serviceType\":\"نقل خاص عبر الحدود\",\"url\":\"https://taxisaudiarabia.com/ar/routes/haql-to-aqaba\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Saudi Arabia\"},{\"@type\":\"Place\",\"name\":\"Jordan\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"كم المسافة من حقل إلى العقبة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"حوالي 40 كم بالطريق، أي نحو 35 دقيقة قيادة، يضاف إليها وقت منفذ الدرة بين حقل والعقبة.\"}},{\"@type\":\"Question\",\"name\":\"هل توصلونني من حقل حتى داخل العقبة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، الخدمة من الباب إلى الباب: يستلمك السائق في حقل ويوصلك إلى عنوانك في العقبة عبر منفذ الدرة.\"}},{\"@type\":\"Question\",\"name\":\"هل يوجد خيار أرخص؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، التوصيل إلى الجانب السعودي من منفذ الدرة بسعر أقل، وترتب مواصلاتك داخل الأردن بنفسك.\"}},{\"@type\":\"Question\",\"name\":\"هل رسوم العبور مشمولة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، رسوم عبور السيارة مشمولة في السعر الثابت، ورسوم التأشيرة الشخصية على الراكب.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"http