1b:["$","div",null,{"dir":"rtl","className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","lang":"ar","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"تاكسي من المدينة المنورة إلى مكة المكرمة\",\"description\":\"أكمل رحلة العمرة بنقل مريح بين المدينتين المقدستين.\",\"serviceType\":\"Taxi Service\",\"url\":\"https://taxisaudiarabia.com/ar/routes/madinah-to-makkah\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"المدينة المنورة\"},{\"@type\":\"Place\",\"name\":\"مكة المكرمة\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"كم المسافة بين المدينة ومكة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"من المدينة المنورة إلى مكة حوالي 430 كم — نحو 4.5 إلى 5 ساعات عبر طريق الحرمين، حسب حركة المرور والاستراحات.\"}},{\"@type\":\"Question\",\"name\":\"كم سعر التاكسي من المدينة إلى مكة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"السعر يُؤكد عبر واتساب لسيارة سيدان. للعائلات والأمتعة ننصح بسيارة دفع رباعي أو فان، ويُؤكد السعر قبل الحجز والرسوم مشمولة.\"}},{\"@type\":\"Question\",\"name\":\"هل أحتاج للإحرام في الطريق من المدينة إلى مكة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، إن كنت تنوي العمرة تدخل في الإحرام عند ميقات ذي الحليفة (آبار علي) قرب المدينة. يتوقف السائق هناك لتُحرم قبل متابعة الرحلة إلى مكة.\"}},{\"@type\":\"Question\",\"name\":\"هل تشمل الرحلة استراحات للصلاة والراحة؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نعم، مع التاكسي الخاص يشمل السائق توقفات للصلاة والطعام والراحة في الرحلة الطويلة بين الحرمين.\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/ar/routes/madinah-to-makkah#webpage\",\"url\":\"https://taxisaudiarabia.com/ar/routes/madinah-to-makkah\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}]],[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"الرئيسية\",\"item\":\"https://taxisaudiarabia.com/ar\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"الرحلات\",\"item\":\"https://taxisaudiarabia.com/routes\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"تاكسي من المدينة المنورة إلى مكة المكرمة\",\"item\":\"https://taxisaudiarabia.com/ar/routes/madinah-to-makkah\"}]}"}}]],["$","nav",null,{"aria-label":"Breadcrumb","className":"section-container max-w-7xl pt-24 pb-2 ","children":["$","ol",null,{"className":"flex min-w-0 flex-wrap items-center gap-x-1 gap-y-1 text-[0.8rem] text-[#64748B]","children":[["$","li","/ar",{"className":"flex min-w-0 items-center gap-1","children":[["$","$L25",null,{"href":"/ar","className":"inline-flex items-center gap-1 rounded-full px-1.5 py-1 font-medium transition-colors hover:bg-[#16A34A]/[0.06] hover:text-[#15803D]","children":[["$","$L26",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8","key":"5wwlr5"}],["path",{"d":"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z","key":"r6nss1"}]],"className":"lucide-house h-3.5 w-3.5","aria-hidden":true}],"الرئيسية"]}],["$","$L26",null,{"ref":"$undefined","iconNode":[["path",{"d":"m9 18 6-6-6-6","key":"mthhwq"}]],"className":"lucide-chevron-right rtl:-scale-x-100 h-3.5 w-3.5 shrink-0 text-[#94A3B8]","aria-hidden":true}]]}],"$L27","$L28"]}]}]],"$L29",false,"$L2a","$L2b","$undefined",false,"$undefined","$undefined",false,"$L2c",false,"$L2d",false,"$L2e","$L2f"]}]
