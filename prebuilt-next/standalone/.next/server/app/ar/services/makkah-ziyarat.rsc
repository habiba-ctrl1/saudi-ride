1b:Td44,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"كيف أحجز تاكسي زيارات في مكة؟","acceptedAnswer":{"@type":"Answer","text":"أرسل فندقك وتاريخ الزيارة وعدد الركاب، ونصف يوم تريد أم يوماً كاملاً، عبر النموذج أو واتساب. نرد بالمركبة وسعر واحد ثابت قبل أي حجز."}},{"@type":"Question","name":"ما المواقع التي تزورها السيارة؟","acceptedAnswer":{"@type":"Answer","text":"تشمل أكثر الطلبات جبل النور (غار حراء) وجبل ثور ومنى ومزدلفة وعرفات مع جبل الرحمة وجنة المعلاة. أنت تختار المواقع، والسيارة تنقلك وتنتظرك."}},{"@type":"Question","name":"كم تستغرق جولة زيارات مكة بالسيارة؟","acceptedAnswer":{"@type":"Answer","text":"يكفي غالباً نصف يوم لأهم المواقع. ويختلف الوقت عند كل محطة بحسبك — فصعود جبل النور مشياً يحتاج وقتاً أطول بكثير من وقفة تصوير. واليوم الكامل يمنحك وتيرة أهدأ."}},{"@type":"Question","name":"هل يناسب كبار السن والأطفال؟","acceptedAnswer":{"@type":"Answer","text":"نعم. أخبرنا بمن سيسافر لنختار مركبة سهلة الصعود ونخطط لانتظار أطول. وبعض المواقع فيها درجات أو صعود، فحدّد المحطات التي سينزلون عندها فعلاً."}},{"@type":"Question","name":"هل يشرح السائق المواقع أو يقدم إرشاداً دينياً؟","acceptedAnswer":{"@type":"Answer","text":"لا. الخدمة نقل: السيارة والسائق ووقت الانتظار. لا نقدّم إرشاداً دينياً أو مرشداً سياحياً، ويمكنك اصطحاب مرشدك أو كتيبك."}},{"@type":"Question","name":"هل يمكن الاستلام من فندقي؟","acceptedAnswer":{"@type":"Answer","text":"نعم، من فنادق العزيزية وأجياد وحول الحرم وبقية أحياء مكة. وقرب الحرم قد تلتقيك السيارة عند أقرب نقطة مسموحة، ويخبرك السائق بمكانها."}},{"@type":"Question","name":"أي مركبة أختار لعائلتي أو مجموعتي؟","acceptedAnswer":{"@type":"Answer","text":"السيدان من واحد إلى ثلاثة أشخاص. وجي إم سي أو دفع رباعي كبير أو هيونداي ستاريا للعائلات. وفان هايس أو كوستر للمجموعات الأكبر، والحافلات الأكبر عند الطلب. نؤكد المركبة حسب العدد."}},{"@type":"Question","name":"هل هي رحلة خاصة أم حافلة مشتركة؟","acceptedAnswer":{"@type":"Answer","text":"خاصة. السيارة لمجموعتك وحدها وليست جولة حافلة مشتركة، والسعر يُتفق عليه قبل الحجز."}},{"@type":"Question","name":"هل يمكنني الإلغاء أو التعديل؟","acceptedAnswer":{"@type":"Answer","text":"نعم. الإلغاء مجاني حتى 24 ساعة قبل الموعد، ويمكن تغيير الوقت أو الفندق عبر واتساب."}}]}f:["$","$1","c",{"children":[["$","div",null,{"dir":"rtl","lang":"ar","className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://taxisaudiarabia.com/ar/services/makkah-ziyarat#service\",\"inLanguage\":\"ar\",\"name\":\"تاكسي زيارات مكة\",\"serviceType\":\"نقل الزيارات\",\"description\":\"سيارة وسائق خاص بين جبل النور وجبل ثور ومنى ومزدلفة وعرفات وجنة المعلاة مع انتظار عند كل محطة. خدمة نقل فقط عبر شبكة شركاء.\",\"url\":\"https://taxisaudiarabia.com/ar/services/makkah-ziyarat\",\"provider\":{\"@type\":\"Organization\",\"name\":\"تاكسي السعودية\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"مكة المكرمة\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/ar/services/makkah-ziyarat#webpage\",\"url\":\"https://taxisaudiarabia.com/ar/services/makkah-ziyarat\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}]],"$L1c","$L1d","$L1e"]}],null,"$L1f"]}]
