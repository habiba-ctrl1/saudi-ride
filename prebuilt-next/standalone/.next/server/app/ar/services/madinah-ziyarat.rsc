1a:Tc95,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"ما أشهر مزارات المدينة المنورة التي تصلها السيارة؟","acceptedAnswer":{"@type":"Answer","text":"أكثر ما يُطلب: مسجد قباء، ومسجد القبلتين، ومنطقة المساجد السبعة عند الخندق، وجبل أحد ومقبرة الشهداء. تختار المحطات وترتيبها، والسائق ينتظرك عند كل واحدة."}},{"@type":"Question","name":"كم تستغرق جولة المزارات بالسيارة؟","acceptedAnswer":{"@type":"Answer","text":"غالباً يكفي نصف يوم للمواقع الأربعة، لأنها قريبة من المسجد النبوي (نحو 5 إلى 9 كم). لكن المدة تتغير بحسب وقتك عند كل موقع ومواقيت الصلاة والازدحام، فأخبرنا بوتيرتك ومن معك."}},{"@type":"Question","name":"هل يرافقنا مرشد أو يشرح السائق المواقع؟","acceptedAnswer":{"@type":"Answer","text":"لا. نرتب السيارة والسائق ووقت الانتظار فقط، ولا نقدم مرشداً ولا فتاوى أو إرشاداً دينياً. يمكنك اصطحاب مرشدك أو كتيبك."}},{"@type":"Question","name":"هل تستلموننا من فندق في المنطقة المركزية؟","acceptedAnswer":{"@type":"Answer","text":"نعم. قرب المسجد النبوي تكون الحركة مقيدة، فيلتقيك السائق عند أقرب نقطة مسموحة لفندقك. أرسل اسم الفندق بالضبط."}},{"@type":"Question","name":"هل الجولة مناسبة لكبار السن والأطفال؟","acceptedAnswer":{"@type":"Answer","text":"نعم. أخبرنا بمن معك لنقترح دفعاً رباعياً أو فاناً أسهل في الركوب، ونخطط لانتظار أطول ونقرب السيارة قدر المسموح. ترتيبات الدخول داخل المواقع نفسها تحددها الجهات المختصة."}},{"@type":"Question","name":"هل يمكن إضافة بدر أو ذي الحليفة؟","acceptedAnswer":{"@type":"Answer","text":"ذو الحليفة (آبار علي) على طريق مكة، فاطلبه ضمن رحلتك من المدينة إلى مكة. أما بدر فرحلة مستقلة لنصف يوم. وأما الإحرام من الميقات فسؤال شرعي لا نفتي فيه."}},{"@type":"Question","name":"كم سعر سيارة المزارات؟","acceptedAnswer":{"@type":"Answer","text":"يعتمد على نوع السيارة وعدد الساعات، لذلك لا ننشر قائمة ثابتة. أرسل المحطات وعدد الركاب، ونؤكد لك سعراً ثابتاً واحداً عبر واتساب قبل الحجز، بلا عداد."}},{"@type":"Question","name":"هل يمكن الإلغاء أو تغيير الخطة؟","acceptedAnswer":{"@type":"Answer","text":"نعم. الإلغاء مجاني حتى 24 ساعة قبل الموعد، ويمكنك تعديل المحطات أو الوقت أو الفندق عبر واتساب."}}]}f:["$","$1","c",{"children":[["$","div",null,{"dir":"rtl","lang":"ar","className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://taxisaudiarabia.com/ar/services/madinah-ziyarat#service\",\"inLanguage\":\"ar\",\"name\":\"مزارات المدينة المنورة بالسيارة\",\"serviceType\":\"نقل الزيارات\",\"description\":\"سيارة خاصة مع سائق بين مسجد قباء ومسجد القبلتين والمساجد السبعة وجبل أحد، مع انتظار عند كل موقع. خدمة نقل فقط عبر شبكة شركاء.\",\"url\":\"https://taxisaudiarabia.com/ar/services/madinah-ziyarat\",\"provider\":{\"@type\":\"Organization\",\"name\":\"تاكسي السعودية\",\"url\":\"https://taxisaudiarabia.com\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"المدينة المنورة\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/ar/services/madinah-ziyarat#webpage\",\"url\":\"https://taxisaudiarabia.com/ar/services/madinah-ziyarat\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1a"}}]],"$L1b","$L1c","$L1d"]}],null,"$L1e"]}]
