2c:["$","section",null,{"className":"section-container max-w-4xl py-16 border-t border-[#C9A84C]/10","children":[["$","h2",null,{"className":"font-heading text-2xl md:text-3xl font-bold mb-10 text-center","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","I'm flying in internationally for Black Hat MEA — can you meet me at the airport?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"I'm flying in internationally for Black Hat MEA — can you meet me at the airport?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. Share your flight number, date and time when you book — we check it before pickup and meet you inside Riyadh Airport (RUH) arrivals, 24/7 including late arrivals, then take you directly to your hotel or the venue in Malham."}]]}],["$","div","Where is Black Hat MEA held and how far is it?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Where is Black Hat MEA held and how far is it?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"At the Riyadh Exhibition & Convention Centre in Malham, north-west of Riyadh — about a 30–45 minute drive from the airport and central hotels. Because it's outside the city, a pre-booked car is far more reliable than hailing one at the venue."}]]}],["$","div","Can you coordinate transport for our whole team?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Can you coordinate transport for our whole team?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. Send your headcount and hotels on WhatsApp and we assign vans or a coaster under a single contact, with daily runs to and from Malham timed around the agenda."}]]}],["$","div","Will the fare change during the busy event days?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Will the fare change during the busy event days?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"No. We confirm a fixed fare before you book and hold it for the event — no surge pricing even when everyone is heading to or from the venue at the same time."}]]}]]}]]}]
