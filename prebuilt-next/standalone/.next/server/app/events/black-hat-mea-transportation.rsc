27:T575,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"I'm flying in internationally for Black Hat MEA — can you meet me at the airport?","acceptedAnswer":{"@type":"Answer","text":"Yes. Share your flight number, date and time when you book — we check it before pickup and meet you inside Riyadh Airport (RUH) arrivals, 24/7 including late arrivals, then take you directly to your hotel or the venue in Malham."}},{"@type":"Question","name":"Where is Black Hat MEA held and how far is it?","acceptedAnswer":{"@type":"Answer","text":"At the Riyadh Exhibition & Convention Centre in Malham, north-west of Riyadh — about a 30–45 minute drive from the airport and central hotels. Because it's outside the city, a pre-booked car is far more reliable than hailing one at the venue."}},{"@type":"Question","name":"Can you coordinate transport for our whole team?","acceptedAnswer":{"@type":"Answer","text":"Yes. Send your headcount and hotels on WhatsApp and we assign vans or a coaster under a single contact, with daily runs to and from Malham timed around the agenda."}},{"@type":"Question","name":"Will the fare change during the busy event days?","acceptedAnswer":{"@type":"Answer","text":"No. We confirm a fixed fare before you book and hold it for the event — no surge pricing even when everyone is heading to or from the venue at the same time."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Black Hat MEA — Event Transportation in Riyadh\",\"description\":\"Private transport for Black Hat MEA in Riyadh — airport transfers to the Riyadh Exhibition & Convention Centre (Malham), daily standby, group and VIP chauffeur for delegates and exhibitors. Fare on WhatsApp.\",\"serviceType\":\"Event Transportation\",\"url\":\"https://taxisaudiarabia.com/events/black-hat-mea-transportation\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Riyadh\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/events/black-hat-mea-transportation#webpage\",\"name\":\"Black Hat MEA Transportation Riyadh | Delegate & Venue Transfers\",\"url\":\"https://taxisaudiarabia.com/events/black-hat-mea-transportation\",\"primaryImageOfPage\":{\"@type\":\"ImageObject\",\"url\":\"https://taxisaudiarabia.com/gallery/event-group-exhibition-riyadh.webp\"},\"about\":{\"@type\":\"Event\",\"name\":\"Black Hat MEA\",\"startDate\":\"2026-12-01\",\"endDate\":\"2026-12-03\",\"eventAttendanceMode\":\"https://schema.org/OfflineEventAttendanceMode\",\"location\":{\"@type\":\"Place\",\"name\":\"Riyadh Exhibition & Convention Centre, Malham\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Riyadh\",\"addressCountry\":\"SA\"}},\"organizer\":{\"@type\":\"Organization\",\"name\":\"Tahaluf\"},\"sameAs\":[\"https://blackhatmea.com\"]}}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/events/black-hat-mea-transportation#webpage\",\"url\":\"https://taxisaudiarabia.com/events/black-hat-mea-transportation\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}]],"$L28","$L29","$undefined","$L2a",false,"$undefined","$L2b","$undefined","$undefined","$undefined","$undefined","$L2c","$L2d"]}]
