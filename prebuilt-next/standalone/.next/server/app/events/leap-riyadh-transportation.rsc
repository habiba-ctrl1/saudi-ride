30:["$","section",null,{"className":"section-container max-w-4xl py-16 border-t border-[#C9A84C]/10","children":[["$","h2",null,{"className":"font-heading text-2xl md:text-3xl font-bold mb-10 text-center","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","How far is LEAP's venue from Riyadh Airport and the city?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"How far is LEAP's venue from Riyadh Airport and the city?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"The Riyadh Exhibition & Convention Centre is in Malham, north-west of Riyadh — roughly a 30–45 minute drive from King Khalid Airport (RUH) and from the central hotel districts, depending on event traffic. Because it's out of town, booking ahead avoids the end-of-day ride shortage."}]]}],["$","div","Is it hard to get a ride when LEAP closes for the day?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Is it hard to get a ride when LEAP closes for the day?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes — that's the main pain point. With hundreds of thousands leaving Malham within a short window, app-based cars get scarce and expensive. A pre-booked car or daily standby means your driver is waiting, at a fixed fare agreed in advance."}]]}],["$","div","Can you move an exhibitor team with equipment?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Can you move an exhibitor team with equipment?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. Ask for an SUV or van and we allow room for demo units, sample cases, and marketing materials, plus early-morning build-up and late breakdown runs so your stand crew reaches the halls on schedule."}]]}],["$","div","Do you cover hotel-to-venue runs for a group?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Do you cover hotel-to-venue runs for a group?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. Tell us your hotel and group size on WhatsApp and we run daily loops between your hotel and Malham with the right-sized vehicle, timed to the sessions you want to attend."}]]}],["$","div","Can I book a private transfer from Riyadh Airport to LEAP in Malham?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Can I book a private transfer from Riyadh Airport to LEAP in Malham?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. We run private airport transfers from King Khalid Airport (RUH) straight to the Riyadh Exhibition & Convention Centre in Malham — we track your flight, meet you at arrivals, and take you directly to the venue, so you skip the taxi queue on a busy LEAP arrivals day. Fare confirmed on WhatsApp before you travel."}]]}],["$","div","Can you provide daily transportation between my Riyadh hotel and LEAP?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Can you provide daily transportation between my Riyadh hotel and LEAP?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. Book a car on daily standby and it runs your morning drop to Malham and evening pickup for the length of LEAP — a fixed daily arrangement for individuals or small teams, so you never hunt for a ride at a remote venue. Send your hotel, dates, and passenger count on WhatsApp for a quote."}]]}],"$L3e","$L3f","$L40"]}]]}]
