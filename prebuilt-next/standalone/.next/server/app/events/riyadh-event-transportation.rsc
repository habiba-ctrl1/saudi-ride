31:["$","section",null,{"className":"section-container max-w-4xl py-16 border-t border-[#C9A84C]/10","children":[["$","h2",null,{"className":"font-heading text-2xl md:text-3xl font-bold mb-10 text-center","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","Which Riyadh event venues do you cover?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Which Riyadh event venues do you cover?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"All of them — the Riyadh Exhibition & Convention Centre (RECC) in Malham, King Abdulaziz International Conference Centre (KAICC), Riyadh Front / ROSHN Front, The Arena, and hotel ballrooms across the DQ, Olaya, and King Fahd Road districts. Tell us your venue on WhatsApp and we plan the run."}]]}],["$","div","Can I book one car for the whole event?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Can I book one car for the whole event?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. An hourly or full-day chauffeur stays on standby so you move between the venue, meetings, and your hotel without waiting for a ride each time — useful when sessions run late or your schedule shifts."}]]}],["$","div","Do you handle arrivals across different flights and hotels?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Do you handle arrivals across different flights and hotels?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. We coordinate multiple pickups from Riyadh Airport (RUH) and several hotels under one point of contact, so a whole team lands and reaches the venue together even on different flights."}]]}],["$","div","How is the fare confirmed?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"How is the fare confirmed?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Send your dates, venue, vehicle type, and passenger count on WhatsApp. We confirm a fixed fare before you book — no surge and no hidden fees, even during peak event weeks."}]]}],["$","div","How much does event transportation in Riyadh cost?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"How much does event transportation in Riyadh cost?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"The fare depends on the vehicle, the number of movements each day, and whether you need a car on daily standby. We confirm a fixed price in writing on WhatsApp before you book — no meter, no surge. Send your event, venue, dates, and passenger count for a clear quote."}]]}],["$","div","Should I book a car per trip or a chauffeur on standby?",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-sm mb-2","children":"Should I book a car per trip or a chauffeur on standby?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"As a rough guide, once you have more than about three movements in a day, a chauffeur on daily standby usually costs less than booking separate trips — and the car is always waiting, so you're never delayed between sessions. For one or two transfers a day, per-trip booking is simpler. Tell us your schedule and we'll advise honestly."}]]}],"$L4c","$L4d","$L4e"]}]]}]
