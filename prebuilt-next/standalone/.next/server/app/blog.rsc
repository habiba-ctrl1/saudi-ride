1c:["$","section",null,{"className":"section-container max-w-7xl","aria-labelledby":"all-guides","children":[["$","h2",null,{"id":"all-guides","className":"mb-5 font-heading text-xl font-bold","children":["All guides"," ",["$","span",null,{"className":"text-base font-medium text-[#94A3B8]","children":["(",37,")"]}]]}],["$","$L29",null,{"posts":[{"href":"/blog/riyadh-to-abu-dhabi-by-road","title":"Riyadh to Abu Dhabi by Road: Distance, Border and What the Drive Involves","excerpt":"Riyadh to Abu Dhabi by road is about 850 km, roughly 8 hours plus the Al Batha–Ghuwaifat border. Route, documents, drive vs fly and planning tips.","categoryKey":"Routes","categoryLabel":"Routes","image":"/cross-border/abu-dhabi-corniche.webp","alt":"Aerial view of a coastal city skyline with high-rise towers beside a long sandy beach and turquoise water","dateLabel":"8 November 2026","readLabel":"5 min read","featured":"$undefined"},{"href":"/blog/riyadh-to-dammam-taxi-price-train-or-flight","title":"Riyadh to Dammam Taxi Price, Train or Flight: How to Choose","excerpt":"Riyadh to Dammam is about 410 km, roughly 4 hours by car. How a fixed taxi quote works and how the SAR train and a flight compare.","categoryKey":"Routes","categoryLabel":"Routes","image":"/gallery/highway-travel.webp","alt":"Black SUV driving on a multi-lane desert highway at sunset","dateLabel":"8 November 2026","readLabel":"5 min read","featured":"$undefined"},{"href":"/blog/jeddah-taxi-fares-cost-guide","title":"Jeddah Taxi Fares 2026: What a Private Ride Costs and What Changes the Price","excerpt":"How taxi and private-transfer fares work in Jeddah — airport to city, Jeddah to Makkah, Madinah and Taif — with real distances, what moves the price, and how to get a fixed fare.","categoryKey":"Pricing","categoryLabel":"Pricing","image":"/blog/jeddah-taxi-fares-cost-guide.webp","alt":"Car dashboard with a fare display and Saudi riyal banknotes, palm trees outside the windscreen","dateLabel":"2 October 2026","readLabel":"5 min read","featured":"$undefined"},{"href":"/blog/madinah-taxi-fares-cost-guide","title":"Madinah Taxi Fares 2026: Airport, Makkah, Ziyarat & AlUla Trips Explained","excerpt":"How private ride fares work in Madinah — Madinah Airport (MED) to the Haram hotels, Madinah to Makkah with a Miqat stop, Ziyarat tours and AlUla — with distances and booking tips.","categoryKey":"Pricing","categoryLabel":"Pricing","image":"/blog/madinah-taxi-fares-cost-guide.webp","alt":"Passenger handing banknotes to a uniformed driver inside a car","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/makkah-taxi-fares-cost-guide","title":"Makkah Taxi Fares 2026: Costs to Jeddah Airport, Madinah & Taif Explained","excerpt":"How private ride fares work from Makkah — to Jeddah Airport, Madinah, Taif and the Ziyarat sites — with distances, hotel pickup realities near the Haram and what changes the price.","categoryKey":"Pricing","categoryLabel":"Pricing","image":"/blog/makkah-taxi-fares-cost-guide.webp","alt":"Saudi riyal banknotes and a phone showing a map on the back seat of a car","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/saudi-arabia-business-travel-transportation-guide","title":"Saudi Arabia Business Travel Transportation Guide for International Executives","excerpt":"Ground transport for business trips to Riyadh, Jeddah and the Eastern Province: airport arrivals, hotel-to-meeting days, hourly drivers, intercity trips, events and company bookings with invoices.","categoryKey":"Business Travel","categoryLabel":"Business Travel","image":"/services/corporate-hero.webp","alt":"Two chauffeurs beside a black sedan in a business district of glass towers","dateLabel":"2 October 2026","readLabel":"5 min read","featured":"$undefined"},{"href":"/blog/saudi-arabia-event-conference-transportation-guide","title":"Saudi Arabia Event & Conference Transportation Guide for International Visitors","excerpt":"Planning ground transport for an exhibition, conference or event in Riyadh or Jeddah: airport to hotel, hotel to venue, daily movements, groups and VIPs, booking early and requesting a corporate quote.","categoryKey":"Events & Conferences","categoryLabel":"Events & Conferences","image":"/gallery/event-fleet-lineup-sedan-suv-van-coaster-riyadh.webp","alt":"Sedan, SUVs, a van and a coaster lined up outside an exhibition centre entrance","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/saudi-arabia-family-group-transport-guide","title":"Saudi Arabia Chauffeur & Private Ride Guide for Families and Groups","excerpt":"Choosing the right vehicle for a family or group in Saudi Arabia — sedan, SUV, van, minibus or coaster — with luggage rules of thumb, children, older travellers, airport and intercity tips, and how to get a quote.","categoryKey":"Travel Tips","categoryLabel":"Travel Tips","image":"/gallery/umrah-family.webp","alt":"Family with a luggage trolley meeting a driver beside a car in an airport terminal","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/saudi-arabia-intercity-transfer-guide","title":"Saudi Arabia Intercity Transfer Guide: Riyadh, Jeddah, Makkah, Madinah & AlUla","excerpt":"Planning a private transfer between Saudi cities: distances and drive times for the main routes, car vs train vs plane, what affects journey time, vehicles, luggage, families and how booking works.","categoryKey":"Routes","categoryLabel":"Routes","image":"/services/intercity-hero.webp","alt":"Black SUV on a desert highway beside a railway line at sunset","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/what-is-a-satha-flatbed-tow-truck","title":"What Is a Satha (سطحة)? Flatbed Tow Trucks in Saudi Arabia Explained","excerpt":"Satha (سطحة) is the word every driver in Saudi Arabia needs to know — what a flatbed tow truck is, what it costs, and how to call one fast.","categoryKey":"Car Recovery","categoryLabel":"Car Recovery","image":"/blog/what-is-a-satha-flatbed-tow-truck.webp","alt":"Flatbed tow truck carrying a white SUV on a desert highway under Makkah and Taif road signs","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/car-towing-cost-saudi-arabia-2026","title":"How Much Does Car Towing Cost in Saudi Arabia? 2026 Satha Price Guide","excerpt":"How towing (satha) pricing works in Saudi Arabia in 2026 — what drives the cost of within-city and intercity car transport, and how to avoid overcharging.","categoryKey":"Car Recovery","categoryLabel":"Car Recovery","image":"/blog/car-towing-cost-saudi-arabia-2026.webp","alt":"A flatbed tow truck carrying a sedan beside a hook-and-chain tow truck pulling a car","dateLabel":"1 October 2026","readLabel":"2 min read","featured":"$undefined"},{"href":"/blog/riyadh-business-events-executive-transfer-guide","title":"Riyadh Conference Venues: Executive Transfer Guide for RECC, RICEC, KAICC and RFECC","excerpt":"Where Riyadh's major exhibitions and conferences happen — RECC in Malham, RICEC, KAICC and RFECC — and how to plan executive transfers, hourly cars and delegate movements around them.","categoryKey":"Events & Conferences","categoryLabel":"Events & Conferences","image":"/blog/riyadh-business-events-executive-transfer-guide.webp","alt":"Chauffeur in a suit holding open the rear door of a black sedan outside a glass office building","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/riyadh-season-taxi-transport-guide","title":"Riyadh Season 2026: Airport, Hotel & Event-Zone Transport Guide","excerpt":"Getting around Riyadh Season 2026 (from 21 October): the Boulevard World and Boulevard City zones in Hittin, drop-offs and late pickups, groups and families, and booking ahead on event nights.","categoryKey":"Events & Conferences","categoryLabel":"Events & Conferences","image":"/blog/riyadh-season-taxi-transport-guide.webp","alt":"Black sedan parked outside a busy, brightly lit entertainment boulevard at night","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/alula-winter-season-travel-guide","title":"AlUla in Winter: When to Go, How Long to Stay and Planning Your Private Transport","excerpt":"Planning AlUla between October and March: best months, how many days you need, sample day plans, booking ahead for peak weekends and how to organise transfers and a driver.","categoryKey":"AlUla & Tourism","categoryLabel":"AlUla & Tourism","image":"/blog/alula-winter-season-travel-guide.webp","alt":"Black SUV on a desert track among weathered sandstone rock formations under a clear sky","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/car-breakdown-saudi-highway-guide","title":"Car Breakdown on a Saudi Highway? 7 Steps to Stay Safe and Get Recovered Fast","excerpt":"Broken down on a Saudi highway? The 7 steps that keep you safe — where to stop, who to call, what a recovery truck needs, and mistakes to avoid.","categoryKey":"Car Recovery","categoryLabel":"Car Recovery","image":"/blog/car-breakdown-saudi-highway-guide.webp","alt":"White sedan stopped on a highway hard shoulder with a red warning triangle behind it","dateLabel":"30 September 2026","readLabel":"2 min read","featured":"$undefined"},{"href":"/blog/private-driver-cost-saudi-arabia","title":"How Much Does a Private Driver Cost in Saudi Arabia? Hourly, Full-Day & Per-Trip Pricing Explained","excerpt":"How private driver pricing works in Saudi Arabia — per trip, by the hour or for a full day — what changes the fare, and how to get a fixed price for your plans.","categoryKey":"Pricing","categoryLabel":"Pricing","image":"/services/vip-luxury-hero.webp","alt":"Chauffeur holding the rear door of a black executive sedan outside a lit hotel entrance at night","dateLabel":"2 October 2026","readLabel":"5 min read","featured":"$undefined"},{"href":"/blog/umrah-season-autumn-winter-family-group-transport","title":"Umrah in Autumn and Winter: A Transport Plan for Families and Groups","excerpt":"Planning Umrah between October and March with family or a group: arrival airports, the order of cities, vehicle sizes, Miqat stops, Ziyarat days and booking every leg together.","categoryKey":"Umrah","categoryLabel":"Umrah","image":"/blog/umrah-season-autumn-winter-family-group-transport.webp","alt":"Family loading suitcases into a white van at an airport kerb under a large canopy","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/eastern-province-corporate-visitor-transport-guide","title":"Eastern Province Business Travel: Transport Guide for Dammam, Al Khobar, Dhahran and Jubail","excerpt":"Visiting the Eastern Province for work: King Fahd International Airport (DMM) transfers, moving between Dammam, Al Khobar, Dhahran and Jubail, site access, multi-day projects and Bahrain trips.","categoryKey":"Business Travel","categoryLabel":"Business Travel","image":"/blog/eastern-province-corporate-visitor-transport-guide.webp","alt":"Black sedan on a highway with an illuminated industrial plant on the horizon at dusk","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/flatbed-vs-hook-towing-automatic-cars","title":"Flatbed vs Hook Towing: Which Is Safe for Your Automatic Car?","excerpt":"Towing an automatic, AWD, or luxury car the wrong way can destroy the transmission — why flatbed (satha) is the only safe choice for modern cars.","categoryKey":"Car Recovery","categoryLabel":"Car Recovery","image":"/blog/flatbed-vs-hook-towing-automatic-cars.webp","alt":"White sedan being winched onto a flatbed tow truck on a city street","dateLabel":"29 September 2026","readLabel":"2 min read","featured":"$undefined"},{"href":"/blog/vip-airport-meet-greet-saudi-arabia","title":"Airport Meet & Greet in Saudi Arabia: What to Expect at JED, RUH, MED and DMM","excerpt":"How a pre-booked airport pickup works in Saudi Arabia — what to send when you book, how the driver finds you, what happens if your flight is late, and what a VIP arrival adds.","categoryKey":"Airport Transfers","categoryLabel":"Airport Transfers","image":"/blog/vip-airport-meet-greet-saudi-arabia.webp","alt":"Driver in a dark suit holding a passenger name card in an airport arrivals hall","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/car-transport-between-saudi-cities","title":"Transporting a Car Between Riyadh, Jeddah & Dammam: 2026 Complete Guide","excerpt":"Moving a car between Saudi cities? How Riyadh–Jeddah–Dammam intercity flatbed transport pricing works, what changes the cost, and how to book it fast.","categoryKey":"Car Recovery","categoryLabel":"Car Recovery","image":"/blog/car-transport-between-saudi-cities.webp","alt":"Flatbed truck carrying a white car on a highway with a city skyline behind","dateLabel":"28 September 2026","readLabel":"2 min read","featured":"$undefined"},{"href":"/blog/private-car-vs-shared-van-umrah","title":"Private Car, Family Van or Shared Shuttle for Umrah: Which Should You Choose?","excerpt":"Umrah transport compared: private sedan, private SUV or van for your own group, and shared shuttles or group buses. Cost per person, comfort, Miqat stops, luggage and timing.","categoryKey":"Umrah","categoryLabel":"Umrah","image":"/services/umrah-transport-hero.webp","alt":"Family loading luggage into a black SUV in a plaza below a tall clock tower at dusk","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/buying-sim-cards-jeddah-airport-stc-mobily-zain","title":"Buying SIM Cards at Jeddah Airport: STC vs Mobily vs Zain","excerpt":"STC, Mobily or Zain? How to buy a visitor SIM at Jeddah Airport (JED), what documents you need, eSIM alternatives, and staying reachable on the way to Makkah.","categoryKey":"Travel Tips","categoryLabel":"Travel Tips","image":"/blog/buying-sim-cards-jeddah-airport-stc-mobily-zain.webp","alt":"Mobile operator SIM card kiosks in an airport arrivals hall","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/how-to-choose-private-chauffeur-company-saudi-arabia","title":"How to Choose a Private Chauffeur Company in Saudi Arabia: A Buyer's Checklist","excerpt":"Ten questions to ask before booking a private chauffeur or limousine service in Saudi Arabia — pricing, vehicles, drivers, delays, cancellations, invoices — and the red flags to avoid.","categoryKey":"Travel Tips","categoryLabel":"Travel Tips","image":"/services/business-executive-hero.webp","alt":"Businessman in a ghutra working on a laptop in the rear seat of a car, city skyline outside","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/riyadh-to-diriyah-visitor-transport-guide","title":"Riyadh to Diriyah: Visitor & Transport Guide to At-Turaif and Bujairi Terrace","excerpt":"How to get from Riyadh to Diriyah — At-Turaif, Bujairi Terrace, when to go, where drivers drop you, and why a private car with a fixed pickup time is the easy option.","categoryKey":"City Guides","categoryLabel":"City Guides","image":"/services/heritage-tours-hero.webp","alt":"Black SUV on a palm-lined road in front of a restored mud-brick town at sunset","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/complete-miqat-locations-guide-umrah-pilgrims","title":"Miqat Locations for Umrah: Where to Enter Ihram by Air and by Road","excerpt":"The five Miqat points, which one applies to your route, what to do if you fly into Jeddah, and how to plan a Miqat stop on a private transfer from Madinah, Taif or Riyadh.","categoryKey":"Umrah","categoryLabel":"Umrah","image":"/blog/complete-miqat-locations-guide-umrah-pilgrims.webp","alt":"Pilgrims in white Ihram garments seated in prayer in a mosque courtyard at sunset","dateLabel":"2 October 2026","readLabel":"7 min read","featured":"$undefined"},{"href":"/blog/saudi-riyal-cash-cards-guide-pilgrims","title":"Saudi Riyal Guide for Visitors and Pilgrims: Cash, Cards, Mada and ATMs","excerpt":"Using money in Saudi Arabia: the riyal's fixed rate to the dollar, where cards and phone payments work, when you still need cash, ATMs, exchange tips and paying for transport.","categoryKey":"Travel Tips","categoryLabel":"Travel Tips","image":"/blog/saudi-riyal-cash-cards-guide-pilgrims.webp","alt":"Saudi riyal banknotes and a payment card on a wooden table","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/alula-travel-guide-hegra-dadan-transport","title":"AlUla Travel Guide: Hegra, Dadan, the Old Town and How to Get There","excerpt":"Getting to AlUla by air (ULH) or by road from Madinah, Riyadh or Jeddah, how to move between Hegra, Dadan, the Old Town and the resorts, and when a private driver makes sense.","categoryKey":"AlUla & Tourism","categoryLabel":"AlUla & Tourism","image":"/blog/alula-travel-guide-hegra-dadan-transport.webp","alt":"Dark SUV parked on desert sand in front of a tomb facade carved into a sandstone cliff","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/riyadh-to-dubai-taxi-gcc-road-trip","title":"Riyadh to Dubai by Road: Distance, Border Crossing & Private Car Guide","excerpt":"Riyadh to Dubai by private car: about 990 km and roughly 9 hours plus the Al Batha–Ghuwaifat border. What the drive involves, documents, when it beats flying, and how to book.","categoryKey":"Routes","categoryLabel":"Routes","image":"/blog/riyadh-to-dubai-taxi-gcc-road-trip.webp","alt":"Black SUV on a highway approaching a city skyline with a supertall tower at sunset","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/neom-the-line-visiting-saudi-arabia-city-of-future","title":"Travelling to NEOM and the Tabuk Region: Airports, Road Distances and Transfers","excerpt":"How business visitors and travellers reach the NEOM area in Tabuk province: flying into Tabuk (TUU), road distances from Jeddah and Riyadh, site access and choosing a vehicle.","categoryKey":"City Guides","categoryLabel":"City Guides","image":"/blog/neom-the-line-visiting-saudi-arabia-city-of-future.webp","alt":"Coastal development and marina on turquoise water beneath desert mountains at sunset","dateLabel":"2 October 2026","readLabel":"2 min read","featured":"$undefined"},{"href":"/blog/corporate-travel-saudi-arabia-business-etiquette","title":"Business Etiquette in Saudi Arabia: A Practical Guide for Visiting Executives","excerpt":"Meetings, greetings, dress, the working week, prayer times and hospitality in Saudi Arabia — practical etiquette for visiting executives, plus how to plan getting between meetings.","categoryKey":"Business Travel","categoryLabel":"Business Travel","image":"/blog/corporate-travel-saudi-arabia-business-etiquette.webp","alt":"Two businessmen in suits shaking hands in a bright office lobby with a city skyline behind","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/best-time-visit-makkah-crowds-weather-umrah","title":"Best Time to Visit Makkah for Umrah: Crowds, Weather and Seasons Compared","excerpt":"When to perform Umrah: Ramadan, the cooler winter months, the quieter weeks after Hajj and the hot summer compared — crowds, temperatures, prices and what each means for transport.","categoryKey":"Umrah","categoryLabel":"Umrah","image":"/blog/best-time-visit-makkah-crowds-weather-umrah.webp","alt":"Crowds of pilgrims around the Kaaba in the courtyard of Masjid al-Haram, clock tower behind","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/madinah-to-makkah-taxi-price-distance-time","title":"Madinah to Makkah by Car: Distance, Travel Time, Miqat Stop & Fares (2026)","excerpt":"Madinah to Makkah by private car: about 430 km and 4 hours, with a stop at the Abyar Ali Miqat. Vehicle choice, timing your arrival for Umrah, the train alternative and how fares work.","categoryKey":"Routes","categoryLabel":"Routes","image":"/blog/madinah-to-makkah-taxi-price-distance-time.webp","alt":"White passenger van on a desert highway between rocky hills at sunset","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/jeddah-to-madinah-taxi-guide-fares","title":"Jeddah Airport to Madinah: Private Transfer, Haramain Train & Other Travel Options","excerpt":"Getting from Jeddah Airport (JED) to Madinah: private transfer (about 410 km, ~4 hours door to door), the Haramain train from the airport station, coaches and flights — compared honestly.","categoryKey":"Routes","categoryLabel":"Routes","image":"/blog/jeddah-to-madinah-taxi-guide-fares.webp","alt":"Black sedan on a multi-lane desert highway with road signs and hills at sunset","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/taxi-cost-saudi-arabia-price-guide","title":"How Much Does a Taxi Cost in Saudi Arabia? Metered Taxis, Apps & Fixed-Fare Transfers Compared","excerpt":"Metered taxi, ride-hailing app or pre-booked transfer? How each is priced in Saudi Arabia, what pushes fares up, and which option fits airport, city and intercity trips.","categoryKey":"Pricing","categoryLabel":"Pricing","image":"/blog/taxi-cost-saudi-arabia-price-guide.webp","alt":"Saudi riyal notes and coins on the dashboard tray of a car, steering wheel in view","dateLabel":"2 October 2026","readLabel":"4 min read","featured":"$undefined"},{"href":"/blog/makkah-ziyarat-taxi-holy-sites-tour","title":"Makkah Ziyarat by Private Car: Holy Sites, Route Order and How Long It Takes","excerpt":"Planning a Makkah Ziyarat: Jabal al-Nour, Jabal Thawr, Mina, Muzdalifah, Arafat and Masjid Aisha — a sensible route order, timing, what to wear and how a private car tour works.","categoryKey":"Umrah","categoryLabel":"Umrah","image":"/blog/makkah-ziyarat-taxi-holy-sites-tour.webp","alt":"Aerial view of Makkah's mountains and city around Masjid al-Haram and the clock tower","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"},{"href":"/blog/riyadh-airport-ruh-taxi-guide","title":"Riyadh Airport (RUH) Arrival Guide: Taxi, Private Transfer & Metro to the City and Hotels","excerpt":"Arriving at King Khalid International Airport (RUH): terminals, private transfer vs taxi rank vs app vs metro, drive times to Olaya, KAFD and the Diplomatic Quarter, and departure timing.","categoryKey":"Airport Transfers","categoryLabel":"Airport Transfers","image":"/blog/riyadh-airport-ruh-taxi-guide.webp","alt":"Cars at the kerb outside a modern airport terminal with a lattice canopy roof","dateLabel":"2 October 2026","readLabel":"3 min read","featured":"$undefined"}],"categories":[{"key":"Airport Transfers","label":"Airport Transfers","count":2},{"key":"Routes","label":"Routes","count":6},{"key":"City Guides","label":"City Guides","count":2},{"key":"Business Travel","label":"Business Travel","count":3},{"key":"Umrah","label":"Umrah","count":5},{"key":"AlUla & Tourism","label":"AlUla & Tourism","count":2},{"key":"Events & Conferences","label":"Events & Conferences","count":3},{"key":"Travel Tips","label":"Travel Tips","count":4},{"key":"Pricing","label":"Pricing","count":5},{"key":"Car Recovery","label":"Car Recovery","count":5}],"allLabel":"All","readLabel":"Read guide","emptyLabel":"No guides in this category yet."}]]}]
