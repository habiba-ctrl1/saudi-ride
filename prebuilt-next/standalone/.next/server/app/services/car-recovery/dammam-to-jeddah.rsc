1d:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-28","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Dammam to Jeddah car transport & satha\",\"description\":\"Dammam to Jeddah is a full cross-Kingdom car transport — about 1,340 km from the Gulf coast to the Red Sea. As a Dammam-based operator we take this as a booked flatbed job: a car for sale, a relocation, or a vehicle that has to reach a specific Jeddah workshop or the Islamic Port. Your car travels secured on the bed and is delivered to the address you choose. Send the vehicle type, pickup, and destination on WhatsApp and we confirm the price and schedule before booking.\",\"serviceType\":\"Vehicle Transport\",\"url\":\"https://taxisaudiarabia.com/services/car-recovery/dammam-to-jeddah\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Dammam\"},{\"@type\":\"Place\",\"name\":\"Jeddah\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much is car transport from Dammam to Jeddah?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on the vehicle, pickup and drop-off points, and timing — a long cross-Kingdom job. Send the details on WhatsApp and we confirm a clear price before booking.\"}},{\"@type\":\"Question\",\"name\":\"How long does Dammam to Jeddah car transport take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's about 1,340 km — roughly a 13-hour drive. As a booked job we agree the pickup and expected delivery window with you on WhatsApp.\"}},{\"@type\":\"Question\",\"name\":\"Can you deliver a car to Jeddah Islamic Port?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes — delivery to or collection from the 