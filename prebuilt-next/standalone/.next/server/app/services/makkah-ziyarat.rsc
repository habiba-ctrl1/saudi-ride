1c:Tbb9,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I book a Makkah Ziyarat taxi?","acceptedAnswer":{"@type":"Answer","text":"Send your hotel, date, number of passengers, and whether you want a half day or a full day, by the form or on WhatsApp. We reply with the vehicle and one fixed fare before anything is booked."}},{"@type":"Question","name":"Which sites can the Makkah Ziyarat car visit?","acceptedAnswer":{"@type":"Answer","text":"Most requests include Jabal Al-Noor (Cave of Hira), Jabal Thawr, Mina, Muzdalifah, Arafat with Jabal Al-Rahmah, and Jannat Al-Mu'alla. You choose the sites; the car takes you to each and waits."}},{"@type":"Question","name":"How long does a Makkah Ziyarat tour by car take?","acceptedAnswer":{"@type":"Answer","text":"A half-day is usually enough for the main sites. Time at each stop depends on you — climbing Jabal Al-Noor on foot, for example, takes much longer than a photo stop. A full day gives a relaxed pace."}},{"@type":"Question","name":"Can elderly parents or young children join?","acceptedAnswer":{"@type":"Answer","text":"Yes. Tell us who is travelling and we choose a vehicle with easier boarding and plan longer waiting stops. Some sites involve steps or climbs, so plan which stops they will actually get out at."}},{"@type":"Question","name":"Does the driver explain the sites or give religious guidance?","acceptedAnswer":{"@type":"Answer","text":"No. The service is transport: the car, the driver, the waiting time. We do not provide religious guidance or a guide; bring your own guidebook or guide if you want one."}},{"@type":"Question","name":"Can you pick us up from our Makkah hotel?","acceptedAnswer":{"@type":"Answer","text":"Yes — from hotels in Aziziyah, Ajyad, around the Haram and other Makkah districts. Near the Haram the car may need to meet you at the nearest permitted point; the driver tells you where."}},{"@type":"Question","name":"Which vehicle should I choose for a family or group?","acceptedAnswer":{"@type":"Answer","text":"A sedan fits one to three people. A GMC or full-size SUV or a Hyundai Staria suits families. A Hiace van or coaster suits larger groups; larger coaches are arranged on request. We confirm the vehicle against your group size when we quote."}},{"@type":"Question","name":"Can I add a stop at Masjid Aisha (Tan'eem)?","acceptedAnswer":{"@type":"Answer","text":"Yes, as a transport stop on request. We cannot advise on religious matters — tell us where you want to stop and the car waits."}},{"@type":"Question","name":"Is this a private tour or a shared bus?","acceptedAnswer":{"@type":"Answer","text":"Private. The car is only for your group — it is not a shared bus tour — and the fare is agreed before booking."}},{"@type":"Question","name":"Can I cancel or change the booking?","acceptedAnswer":{"@type":"Answer","text":"Yes. Cancellation is free up to 24 hours before pickup, and changes of time or hotel can be made on WhatsApp."}}]}f:["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Makkah Ziyarat Taxi\",\"description\":\"Private Makkah Ziyarat transportation: a car and driver between Jabal Al-Noor, Jabal Thawr, Mina, Muzdalifah, Arafat and Jannat Al-Mu'alla, with waiting time at each stop. Transport only, coordinated through a partner network.\",\"serviceType\":\"Ziyarat transportation\",\"url\":\"https://taxisaudiarabia.com/services/makkah-ziyarat\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Makkah\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],"$L1d"],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}],null,"$L27"]}]
