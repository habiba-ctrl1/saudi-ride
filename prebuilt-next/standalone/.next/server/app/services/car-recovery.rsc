1c:T4c5,{"@context":"https://schema.org","@type":"AutomotiveBusiness","@id":"https://taxisaudiarabia.com/services/car-recovery#recovery","name":"Car Recovery — Dammam Satha (سطحة الدمام)","description":"Dammam-based flatbed satha (سطحة) — 24/7 car recovery across the Eastern Province (Dammam, Khobar, Dhahran, Qatif, Al-Ahsa) plus booked intercity car transport to Riyadh, Jeddah & Yanbu. Price on WhatsApp.","url":"https://taxisaudiarabia.com/services/car-recovery","telephone":"+966539388072","parentOrganization":{"@id":"https://taxisaudiarabia.com/#taxiservice"},"address":{"@type":"PostalAddress","addressLocality":"Dammam","addressRegion":"Eastern Province","addressCountry":"SA"},"areaServed":[{"@type":"Place","name":"Dammam"},{"@type":"Place","name":"Al Khobar"},{"@type":"Place","name":"Dhahran"},{"@type":"Place","name":"Qatif"},{"@type":"Place","name":"Ras Tanura"},{"@type":"Place","name":"Abqaiq"},{"@type":"Place","name":"Al-Ahsa"},{"@type":"Place","name":"Jubail"},{"@type":"Place","name":"Eastern Province"}],"openingHoursSpecification":{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],"opens":"00:00","closes":"23:59"}}1d:T7df,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I request a recovery truck (satha)?","acceptedAnswer":{"@type":"Answer","text":"Send your live location on WhatsApp along with your car make/model and what happened (breakdown, accident, flat battery). We confirm a clear price and the truck's timing before anything moves."}},{"@type":"Question","name":"How much does car towing cost in Saudi Arabia?","acceptedAnswer":{"@type":"Answer","text":"There is no fixed public price — the cost depends on the car's location, the destination, vehicle type, and distance. You always get a clear quote on WhatsApp before the truck moves, so there are no surprises on arrival."}},{"@type":"Question","name":"What is the difference between a satha (سطحة) and a normal tow truck?","acceptedAnswer":{"@type":"Answer","text":"A satha is a flatbed: your car is winched fully onto the truck bed, so no wheels touch the road during transport. This is the safest method for automatic, AWD, and luxury vehicles. Hook-and-chain trucks drag two wheels on the road and can damage modern cars — we recommend flatbed."}},{"@type":"Question","name":"Do you work at night and on Fridays?","acceptedAnswer":{"@type":"Answer","text":"Yes — recovery is available 24/7, including late nights, Fridays, and public holidays. Message us on WhatsApp and we confirm availability."}},{"@type":"Question","name":"Can you recover my car if I'm not with it?","acceptedAnswer":{"@type":"Answer","text":"Yes. Share the car's location, a photo, and the drop-off address on WhatsApp. Many customers leave the key with a guard or family member and track the delivery by phone."}},{"@type":"Question","name":"Do you transport cars between cities?","acceptedAnswer":{"@type":"Answer","text":"Yes — intercity car transport is one of our main services, especially from Dammam and the Eastern Province to Riyadh, Jeddah, Yanbu, and beyond. Send the car type and destination on WhatsApp for a quote."}}]}f:["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-28","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Car Recovery & Towing Service (Satha سطحة)\",\"description\":\"Dammam-based flatbed car recovery and roadside assistance across the Eastern Province, plus booked intercity car transport across Saudi Arabia.\",\"serviceType\":\"Vehicle Towing & Recovery\",\"url\":\"https://taxisaudiarabia.com/services/car-recovery\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Dammam\"},{\"@type\":\"Place\",\"name\":\"Al Khobar\"},{\"@type\":\"Place\",\"name\":\"Dhahran\"},{\"@type\":\"Place\",\"name\":\"Qatif\"},{\"@type\":\"Place\",\"name\":\"Ras Tanura\"},{\"@type\":\"Place\",\"name\":\"Abqaiq\"},{\"@type\":\"Place\",\"name\":\"Al-Ahsa\"},{\"@type\":\"Place\",\"name\":\"Jubail\"},{\"@type\":\"Place\",\"name\":\"Eastern Province\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1d"}}],"$L1e","$L1f"],"$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b"]}],null,"$L2c"]}]
