ver:underline","children":"events transport hub"}],"."]}]]}],["$","div",null,{"children":[["$","h2",null,{"className":"font-heading text-2xl font-bold mb-3","children":"Book per trip, or request one quote for a programme?"}],["$","p",null,{"className":"text-sm md:text-base text-[#4B5563] leading-relaxed","children":["A single trip is fastest on WhatsApp, while several trips, several travellers or an invoice requirement suit one written quote by email. If you are unsure, send the details on WhatsApp and we will say which fits; see also ",["$","$L1c",null,{"href":"/pricing","className":"font-semibold text-[#15803D] hover:underline","children":"how fares are quoted"}]," or ",["$","$L1c",null,{"href":"/contact","className":"font-semibold text-[#15803D] hover:underline","children":"contact us"}],"."]}]]}]]}]}]
28:["$","section",null,{"id":"apply","className":"section-container max-w-3xl py-20","children":["$","div",null,{"className":"bg-white border border-[#16A34A]/15 shadow-lg rounded-3xl p-8 md:p-12","children":[["$","div",null,{"className":"text-center mb-10","children":[["$","h2",null,{"className":"font-heading text-3xl font-bold mb-3 text-[#1C1C1C]","children":"Request a Corporate Account"}],["$","p",null,{"className":"text-sm text-[#6B7280]","children":"Fill out the details below and we will reply with a written quote."}]]}],["$","$L32",null,{}],["$","div",null,{"className":"mt-6 pt-6 border-t border-[#16A34A]/10 text-center","children":[["$","p",null,{"className":"text-xs text-[#6B7280] mb-3","children":"Prefer email? Send your requirements and we will reply with a written quote; invoicing details are confirmed before the booking is finalised."}],["$","a",null,{"href":"mailto:infotaxisaudiarabia@gmail.com?subject=Corporate%20account%20%2F%20transport%20RFQ&body=Hello%20Taxi%20Saudi%20Arabia%20team%2C%0A%0AWe'd%20like%20to%20set%20up%20a%20corporate%20transport%20account%20%2F%20request%20a%20written%20quote.%0A%0A%E2%80%A2%20Company%3A%20%0A%E2%80%A2%20Contact%20name%20%26%20role%3A%20%0A%E2%80%A2%20City%20%2F%20cities%3A%20%0A%E2%80%A2%20Estimated%20monthly%20trips%20or%20routes%3A%20%0A%E2%80%A2%20Vehicle%20types%20needed%20(Executive%20sedan%20%2F%20SUV%20%2F%20Van%20%2F%20Luxury)%3A%20%0A%E2%80%A2%20Invoicing%20(VAT%20%2F%20PO)%20%26%20payment%20terms%3A%20%0A%0AThank%20you.","className":"inline-flex items-center gap-2 rounded-full border border-[#C9A84C] px-7 py-3 text-xs font-bold uppercase text-[#C9A84C] hover:bg-[#C9A84C]/10 transition-all","children":"Email our corporate desk"}]]}]]}]}]
33:T464,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How does corporate invoicing work?","acceptedAnswer":{"@type":"Answer","text":"Corporate invoicing can be arranged through our sister company. Send your company name, VAT number and PO reference with your enquiry and we'll confirm invoicing details before the booking is finalised."}},{"@type":"Question","name":"Can one company book trips for several employees?","acceptedAnswer":{"@type":"Answer","text":"Yes. Send the travellers, routes, dates and passenger numbers by email or WhatsApp and we reply with one quote covering them, with the fare agreed before booking."}},{"@type":"Question","name":"Is the fare fixed for corporate trips?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every trip is quoted and agreed before booking — no meter and no surge — so the cost is known for approvals and expense reports."}},{"@type":"Question","name":"Can we pay by bank transfer?","acceptedAnswer":{"@type":"Answer","text":"Payment is by cash to the driver or bank transfer, and electronic receipts are available on request."}}]}29:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$33"}}]],["$","section",null,{"className":"section-container max-w-4xl py-20 border-t border-[#C9A84C]/10","children":[["$","h2",null,{"className":"font-heading text-3xl font-bold mb-12 text-center","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"bg-white border border-[#16A34A]/12 rounded-2xl p-6","children":[["$","h3",null,{"className":"font-bold text-[#1C1C1C] mb-2","children":"How does corporate invoicing work?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Corporate invoicing can be arranged through our sister company. Send your company name, VAT number and PO reference with your enquiry and we'll confirm invoicing details before the booking is finalised."}