1c:T46e,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How far is Taif from Makkah and how long does the tour take?","acceptedAnswer":{"@type":"Answer","text":"Taif is approximately 85 km from Makkah via the Al-Hada mountain road (~1 hour drive). A full day trip usually takes 6 to 8 hours."}},{"@type":"Question","name":"Which sites are included in the Taif Ziyarat tour?","acceptedAnswer":{"@type":"Answer","text":"Our standard tour includes Masjid Abdullah Ibn Abbas, Wadi Mitna (Addas garden), Al-Hada cable car area, Shubra Palace, and a Taif rose factory."}},{"@type":"Question","name":"Can we get picked up from Makkah or Jeddah?","acceptedAnswer":{"@type":"Answer","text":"Yes! We provide hotel pickup and drop-off from any hotel in Makkah, Jeddah, or Taif."}},{"@type":"Question","name":"Can we add a stop on the return to Makkah?","acceptedAnswer":{"@type":"Answer","text":"Yes. Prayer, meal and rest stops can be added on request. Whether a Miqat stop applies to you depends on your own religious circumstances, which we cannot advise on — tell us when you book if you want one."}}]}f:["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Taif Ziyarat Tour | Rose Farms, Al-Hada & Heritage\",\"description\":\"Book a private Taif Ziyarat tour from Makkah or Jeddah — Masjid Abdullah Ibn Abbas, Wadi Mitna, Al-Hada cable car, and rose factories with professional drivers.\",\"serviceType\":\"ChauffeurService\",\"url\":\"https://taxisaudiarabia.com/services/taif-ziyarat\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Saudi Arabia\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","script","2",{"t