1c:T683,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Where do you drop us off in Makkah?","acceptedAnswer":{"@type":"Answer","text":"We drop you off directly at your hotel's lobby. If your hotel is located on the immediate Haram boundary where vehicles are restricted during prayer times, we will safely drop you at the closest permitted security checkpoint."}},{"@type":"Question","name":"What languages do your drivers speak?","acceptedAnswer":{"@type":"Answer","text":"We understand pilgrims come from all over the world. Drivers in our partner network speak English and Arabic. Please tell us your preferred language when you book."}},{"@type":"Question","name":"Can you arrange a trip to a Miqat before Makkah?","acceptedAnswer":{"@type":"Answer","text":"If your plans include a visit to a Miqat such as Al-Juhfah before Makkah, tell us when you book and we quote it as a separate trip. We provide transport only and cannot advise on religious matters."}},{"@type":"Question","name":"Is Jeddah a Miqat for Umrah?","acceptedAnswer":{"@type":"Answer","text":"Jeddah lies inside the Miqat boundary, so a pickup at Jeddah Airport does not by itself involve a Miqat stop. What applies to you depends on your route and your own religious circumstances, which we cannot advise on — see our Miqat guide, and tell us if you want a separate trip planned."}},{"@type":"Question","name":"How far is Jeddah Airport from Makkah for Umrah?","acceptedAnswer":{"@type":"Answer","text":"King Abdulaziz International Airport (JED) is about 80 km from Makkah — roughly a 1-hour direct transfer, with prayer and rest stops on request."}}]}f:["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Umrah Taxi Service\",\"description\":\"Dedicated Umrah taxi service in Saudi Arabia — Jeddah Airport to Makkah transfers, Makkah to Madinah rides, Ziyarat tours, and prayer stops with English- and Arabic-speaking drivers.\",\"serviceType\":\"Umrah Transport\",\"url\":\"https://taxisaudiarabia.com/services/umrah-transport\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Makkah\"},{\"@type\":\"Place\",\"name\":\"Madinah\"},{\"@type\":\"Place\",\"name\":\"Jeddah\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1c"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/services/umrah-transport#webpage\",\"url\":\"https://taxisaudiarabia.com/services/umrah-transport\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}]],[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://taxisaudiarabia.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Services\",\"item\":\"https://taxisaudiarabia.com/services\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Umrah Taxi\",\"item\":\"https://taxisaudiarabia.com/services/umrah-transport\"}]}"}}]],"$L1d"],"$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25"]}],null,"$L26"]}]
