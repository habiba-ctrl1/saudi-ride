32:["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"What the Miqat is: the Miqat is the boundary at which a pilgrim must already be in the state of Ihram before proceeding to Makkah for Umrah or Hajj."}]
33:["$","li","1",{"className":"flex items-start gap-4 p-6 rounded-2xl bg-white border border-[#C9A84C]/10","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C9A84C]/10 border border-[#C9A84C]/30 text-sm font-bold text-[#16A34A]","children":2}],["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"Arriving by air into Jeddah: most international flights cross the Miqat boundary before landing, so you enter Ihram on the aircraft. The crew or captain announces when the Miqat is approaching — change into Ihram and make your intention (niyyah) before that point."}]]}]
34:["$","li","2",{"className":"flex items-start gap-4 p-6 rounded-2xl bg-white border border-[#C9A84C]/10","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C9A84C]/10 border border-[#C9A84C]/30 text-sm font-bold text-[#16A34A]","children":3}],["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"Jeddah is NOT a Miqat: the city of Jeddah lies inside the Miqat boundary, so you cannot wait until you land to enter Ihram if your flight has already crossed it."}]]}]
35:["$","li","3",{"className":"flex items-start gap-4 p-6 rounded-2xl bg-white border border-[#C9A84C]/10","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C9A84C]/10 border border-[#C9A84C]/30 text-sm font-bold text-[#16A34A]","children":4}],["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"If you land without Ihram: the designated land Miqat for those coming from the Jeddah/Rabigh direction is Al-Juhfah (near Rabigh), north of Jeddah. Scholars differ on the ruling for those who pass the air Miqat without Ihram, so many pilgrims choose to travel out to Al-Juhfah to enter Ihram to be safe."}]]}]
36:["$","li","4",{"className":"flex items-start gap-4 p-6 rounded-2xl bg-white border border-[#C9A84C]/10","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C9A84C]/10 border border-[#C9A84C]/30 text-sm font-bold text-[#16A34A]","children":5}],["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"Practical option from Jeddah Airport: there is no Miqat on the road from the airport to Makkah. If you landed without Ihram and choose to go to Al-Juhfah, book the car with that stop in advance — it lies north of Jeddah, the opposite direction from Makkah, so it is a long detour that is quoted separately."}]]}]
37:["$","li","5",{"className":"flex items-start gap-4 p-6 rounded-2xl bg-white border border-[#C9A84C]/10","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C9A84C]/10 border border-[#C9A84C]/30 text-sm font-bold text-[#16A34A]","children":6}],["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"Ihram essentials: wear the two white seamless garments (men), keep a clean backup set, and avoid prohibited acts (perfume, cutting hair/nails) once in Ihram."}]]}]
38:["$","li","6",{"className":"flex items-start gap-4 p-6 rounded-2xl bg-white border border-[#C9A84C]/10","children":[["$","span",null,{"className":"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#C9A84C]/10 border border-[#C9A84C]/30 text-sm font-bold text-[#16A34A]","children":7}],["$","p",null,{"className":"m-0 pt-1 leading-relaxed text-[#1C1C1C]","children":"After Ihram: continue to Makkah (~80 km, ~1 hour), check into your hotel, then proceed to Masjid al-Haram to perform Tawaf and Sa'i."}]]}]
39:["$","div",null,{"className":"mt-16","children":[["$","h2",null,{"className":"font-heading text-2xl font-bold mb-6 flex items-center gap-3 text-[#1C1C1C]","children":[["$","$L27",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3","key":"1u773s"}],["path",{"d":"M12 17h.01","key":"p32p05"}]],"className":"lucide-circle-question-mark text-[#C9A84C]"}],"Frequently Asked Questions"]}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"border border-[#16A34A]/12 rounded-2xl p-6 bg-white","children":[["$","h3",null,{"className":"font-bold text-base mb-2 text-[#1C1C1C]","children":"Is Jeddah a Miqat for Umrah?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"No. Jeddah lies inside the Miqat boundary, so it is not a Miqat. If you intend Umrah you must be in Ihram before crossing the Miqat — usually announced on your flight before landing in Jeddah."}]]}],["$","div","1",{"className":"border border-[#16A34A]/12 rounded-2xl p-6 bg-white","children":[["$","h3",null,{"className":"font-bold text-base mb-2 text-[#1C1C1C]","children":"Where do I enter Ihram if I arrive at Jeddah airport?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Normally on the aircraft, when the crew announces the Miqat. If you arrive without Ihram, the relevant land Miqat is Al-Juhfah (near Rabigh), and a taxi can take you there before heading to Makkah."}]]}],["$","div","2",{"className":"border border-[#16A34A]/12 rounded-2xl p-6 bg-white","children":[["$","h3",null,{"className":"font-bold text-base mb-2 text-[#1C1C1C]","children":"Can a taxi stop at the Miqat on the way to Makkah?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Yes. On the Jeddah Airport to Makkah transfer, tell the driver in advance and they will stop at the Miqat so you can change into Ihram and pray before continuing to Makkah."}]]}],["$","div","3",{"className":"border border-[#16A34A]/12 rounded-2xl p-6 bg-white","children":[["$","h3",null,{"className":"font-bold text-base mb-2 text-[#1C1C1C]","children":"What if I forgot to enter Ihram before the Miqat?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Rulings vary, so consult a scholar. Many pilgrims travel out to the nearest Miqat (Al-Juhfah for the Jeddah direction) to enter Ihram there to avoid any shortfall before performing Umrah."}]]}]]}]]}]
