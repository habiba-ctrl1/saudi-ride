24:Tb86,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which terminal do international flights use at Jeddah airport?","acceptedAnswer":{"@type":"Answer","text":"Terminal 1 is the main hub for international and domestic flights, including Saudia. Since September 2026, foreign airlines have also been moving to the new Terminal 4. Confirm your terminal with your airline, because assignments are still changing."}},{"@type":"Question","name":"What is the difference between Terminal 1 and the North Terminal at Jeddah airport?","acceptedAnswer":{"@type":"Answer","text":"Terminal 1 is the main hub and opened in 2019. The North Terminal handled most foreign airlines and is being phased out, with its flights moving to Terminal 4 and the Hajj and Umrah Terminals from 17 October 2026, according to Khaleej Times."}},{"@type":"Question","name":"Is Terminal 4 open at Jeddah airport?","acceptedAnswer":{"@type":"Answer","text":"Yes, in phases. Terminal 4 began opening on 27 September 2026 with Wizz Air, AJet and SalamAir, and other airlines have been moving since. It covers about 97,000 square metres and is designed for up to 15 million passengers a year."}},{"@type":"Question","name":"Which terminal is the Hajj terminal at Jeddah airport?","acceptedAnswer":{"@type":"Answer","text":"The Hajj and Umrah Terminal is a separate terminal for pilgrim flights, distinct from Terminal 4. Terminal 4 also has a dedicated group check-in area for pilgrims. Your airline confirms which one your flight uses."}},{"@type":"Question","name":"How do I find my driver at Jeddah airport?","acceptedAnswer":{"@type":"Answer","text":"Your driver provides meet and greet at arrivals. Share your flight number and the terminal your airline shows when you book, and tell us if it changes before you fly so the driver waits at the right place."}},{"@type":"Question","name":"What happens if my flight to Jeddah is delayed?","acceptedAnswer":{"@type":"Answer","text":"We track your flight, so a delay moves the pickup to your actual landing time. Free waiting of 15 to 30 minutes after landing applies, so you are not charged for the time it takes to clear immigration and collect bags."}},{"@type":"Question","name":"How far is Jeddah airport from Makkah and Madinah?","acceptedAnswer":{"@type":"Answer","text":"Makkah is about 80 km, roughly one hour. Madinah is about 420 km, roughly four to five hours. A pre-booked private car takes you straight from your terminal to your hotel, with the fare confirmed on WhatsApp before you book."}},{"@type":"Question","name":"Should I take the train or a private car from Jeddah airport to Makkah?","acceptedAnswer":{"@type":"Answer","text":"The Haramain train suits light luggage and a hotel near a station; the airport station connects to Terminal 1. A private car suits families, groups, heavy bags and late arrivals, and takes you door to door at a fare agreed before you travel."}}]}19:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Jeddah Airport Terminals: Terminal 1, Terminal 4, North Terminal and Hajj Terminal\",\"description\":\"Terminal 1, new Terminal 4, North Terminal and Hajj Terminal at Jeddah airport (JED) explained, with the airline moves reported since September 2026.\",\"url\":\"https://taxisaudiarabia.com/guides/jeddah-airport-guide\",\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/guides/jeddah-airport-guide\"},\"author\":{\"@type\":\"Organization\",\"name\":\"Taxi Saudi Arabia\",\"url\":\"https://taxisaudiarabia.com/about\"},\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://taxisaudiarabia.com/#taxiservice\",\"name\":\"Taxi Saudi Arabia\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://taxisaudiarabia.com/icon.png\"}}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://taxisaudiarabia.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Guides\",\"item\":\"https://taxisaudiarabia.com/guides\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Jeddah Airport Terminals: Terminal 1, Terminal 4, North Terminal and Hajj Terminal\",\"item\":\"https://taxisaudiarabia.com/guides/jeddah-airport-guide\"}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$24"}}]],"$L25","$L26"]}]
