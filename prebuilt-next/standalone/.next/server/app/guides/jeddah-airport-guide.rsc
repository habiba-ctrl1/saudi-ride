37:["$","div","6",{"className":"border border-[#16A34A]/12 rounded-2xl p-6 bg-white","children":[["$","h3",null,{"className":"font-bold text-base mb-2 text-[#1C1C1C]","children":"How far is Jeddah airport from Makkah and Madinah?"}],["$","p",null,{"className":"text-sm text-[#6B7280] leading-relaxed","children":"Makkah is about 80 km, roughly one hour. Madinah is about 420 km, roughly four to five hours. A pre-booked private car takes you straight from your terminal to your hotel, with the fare confirmed on WhatsApp before you book."}]]}]
