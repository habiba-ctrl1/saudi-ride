t-sm font-bold text-[#15803D]","children":"Terminal 1"}]]}],["$","div","New",{"className":"min-w-0 rounded-2xl border border-[#16A34A]/10 bg-[#F4FAF5] px-3.5 py-3","children":[["$","dt",null,{"className":"text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[#64748B]","children":"New"}],["$","dd",null,{"className":"mt-1 break-words text-sm font-bold text-[#15803D]","children":"Terminal 4 (from 27 Sep 2026)"}]]}],["$","div","To Makkah",{"className":"min-w-0 rounded-2xl border border-[#16A34A]/10 bg-[#F4FAF5] px-3.5 py-3","children":[["$","dt",null,{"className":"text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[#64748B]","children":"To Makkah"}],["$","dd",null,{"className":"mt-1 break-words text-sm font-bold text-[#15803D]","children":"~80 km, ~1 hr"}]]}],["$","div","Pickup",{"className":"min-w-0 rounded-2xl border border-[#16A34A]/10 bg-[#F4FAF5] px-3.5 py-3","children":[["$","dt",null,{"className":"text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[#64748B]","children":"Pickup"}],["$","dd",null,{"className":"mt-1 break-words text-sm font-bold text-[#15803D]","children":"Meet & greet at arrivals"}]]}]]}]]}],["$","div",null,{"className":"space-y-14","children":[["$","section","Which terminal does my flight use at Jeddah airport?",{"children":[["$","h2",null,{"className":"font-heading text-2xl font-bold mb-4 text-[#0F172A]","children":"Which terminal does my flight use at Jeddah airport?"}],[["$","p","0",{"className":"mb-4 leading-[1.8] text-[#475569] max-w-[70ch]","children":"Your airline decides, and the answer has been changing since September 2026, so check it on your ticket or the airline's app before you leave and again a day before you land. Your ticket may still show the North Terminal even after the move, so a quick confirmation with the airline is worth it."}],"$L29"],"$undefined","$L2a","$L2b"]}],"$L2c","$L2d","$L2e","$L2f","$L30"]}],"$L31","$L32","$L33"]}]
