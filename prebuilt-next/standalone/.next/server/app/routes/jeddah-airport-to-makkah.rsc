27:T9e7,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I travel from Jeddah Airport directly to my Makkah hotel?","acceptedAnswer":{"@type":"Answer","text":"Yes. The driver takes you from your JED terminal to your hotel — about 80 km, ~1 hr — as close to the entrance as vehicles are permitted. Near Masjid al-Haram that may be the nearest permitted drop-off point at prayer times."}},{"@type":"Question","name":"Where does the driver meet me at Jeddah Airport?","acceptedAnswer":{"@type":"Answer","text":"After baggage claim in the arrivals area of your terminal. JED has Terminal 1, the North Terminal and, in pilgrimage season, the Hajj Terminal. Send your flight number and we confirm the meeting point on WhatsApp before you land."}},{"@type":"Question","name":"What happens if my flight is delayed?","acceptedAnswer":{"@type":"Answer","text":"We track your flight, so the pickup moves with it. After you land, the first 15–30 minutes of waiting is free."}},{"@type":"Question","name":"Is the transfer private?","acceptedAnswer":{"@type":"Answer","text":"Yes. The whole car is yours — you share it only with the people in your group. There are no other pickups on the way."}},{"@type":"Question","name":"Which vehicle should I choose for my family and luggage?","acceptedAnswer":{"@type":"Answer","text":"A sedan suits one to three people with normal luggage. A GMC or full-size SUV, or a Hyundai Staria, suits families with more luggage. A Hiace van or coaster suits larger groups; coaches are arranged on request. We confirm the vehicle against your passenger and luggage count when we quote."}},{"@type":"Question","name":"Can I book the return journey to Jeddah Airport at the same time?","acceptedAnswer":{"@type":"Answer","text":"Yes. Tell us the return date and time when you book and both legs are quoted together, or add the return later on WhatsApp."}},{"@type":"Question","name":"Does a Jeddah Airport pickup involve a Miqat stop?","acceptedAnswer":{"@type":"Answer","text":"A pickup in Jeddah does not by itself involve a Miqat stop. Whether a Miqat matters depends on where you travelled from and on your own religious circumstances, which we cannot advise on. If your plans include a stop, tell us when you book."}},{"@type":"Question","name":"How do I get a quote?","acceptedAnswer":{"@type":"Answer","text":"Send pickup, drop-off, date, passengers and luggage by the form or on WhatsApp. We reply with the vehicle and one fixed fare before anything is booked."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TouristTrip\",\"name\":\"Jeddah Airport to Makkah Transfer\",\"description\":\"The most requested pilgrim corridor. Direct, air-conditioned transfers from King Abdulaziz International Airport to the Holy Mosque.\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"itinerary\":{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Jeddah Airport\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Makkah\"}}]}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}],"$L28","$L29","$L2a","$L2b","$L2c",false,false]}]
