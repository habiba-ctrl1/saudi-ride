27:T7c5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I book a private car from Madinah to Makkah?","acceptedAnswer":{"@type":"Answer","text":"Yes. Pickup at your Madinah hotel, drop-off at your Makkah hotel — about 430 km, ~4 hr of driving — with a fixed fare agreed first."}},{"@type":"Question","name":"How long is the drive?","acceptedAnswer":{"@type":"Answer","text":"About ~4 hr of driving. Prayer and meal stops, traffic arriving in Makkah and Umrah peaks add time."}},{"@type":"Question","name":"Can we stop at Dhul Hulaifah (Abyar Ali) on the way?","acceptedAnswer":{"@type":"Answer","text":"Yes, if you want a stop there, tell us when you book and the driver includes it. Whether it applies to you depends on your intentions and religious circumstances, which we cannot advise on."}},{"@type":"Question","name":"Which vehicle should I choose for a family with elderly parents?","acceptedAnswer":{"@type":"Answer","text":"A sedan suits one to three people with normal luggage. A GMC or full-size SUV, or a Hyundai Staria, suits families with more luggage. A Hiace van or coaster suits larger groups; coaches are arranged on request. We confirm the vehicle against your passenger and luggage count when we quote."}},{"@type":"Question","name":"Can I book from Madinah Airport instead?","acceptedAnswer":{"@type":"Answer","text":"Yes. Madinah Airport to Makkah is its own route, with pickup timed from your landing and flight tracking."}},{"@type":"Question","name":"Can I book the Makkah to Madinah leg together?","acceptedAnswer":{"@type":"Answer","text":"Yes. Tell us the return date and time when you book and both legs are quoted together, or add the return later on WhatsApp."}},{"@type":"Question","name":"How do I get a quote?","acceptedAnswer":{"@type":"Answer","text":"Send pickup, drop-off, date, passengers and luggage by the form or on WhatsApp. We reply with the vehicle and one fixed fare before anything is booked."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TouristTrip\",\"name\":\"Madinah to Makkah Transfer\",\"description\":\"Complete your Umrah journey with a comfortable inter-city transfer between the two Holy Cities.\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"itinerary\":{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Madinah\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Makkah\"}}]}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://taxisaudiarabia.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Routes\",\"item\":\"https://taxisaudiarabia.com/routes\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Madinah to Makkah\",\"item\":\"https://taxisaudiarabia.com/routes/madinah-to-makkah\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/routes/madinah-to-makkah#webpage\",\"url\":\"https://taxisaudiarabia.com/routes/madinah-to-makkah\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}],"$L28","$L29",false,false,"$undefined"]}]
