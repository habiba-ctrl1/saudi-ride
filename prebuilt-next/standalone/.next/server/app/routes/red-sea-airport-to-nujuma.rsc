49:["$","section","The Nujuma journey, leg by leg",{"id":"$undefined","aria-labelledby":"h-The-Nujuma-journey-leg-by-leg","className":"scroll-mt-24","children":[["$","h2",null,{"id":"h-The-Nujuma-journey-leg-by-leg","className":"font-heading text-2xl font-bold sm:text-3xl","children":"The Nujuma journey, leg by leg"}],["$","div",null,{"className":"mt-3 space-y-3 text-[0.95rem] leading-relaxed text-[#475569]","style":{"maxWidth":"70ch"},"children":[["$","p","Nujuma, a Ritz-Carlton Reserve, sits on an island, and guests reach it by boat or seaplane, not by road. The usual shape of the trip is RSI Airport, a private land transfer, the Turtle Bay or relevant transfer point, then a boat or seaplane to Nujuma.",{"children":"Nujuma, a Ritz-Carlton Reserve, sits on an island, and guests reach it by boat or seaplane, not by road. The usual shape of the trip is RSI Airport, a private land transfer, the Turtle Bay or relevant transfer point, then a boat or seaplane to Nujuma."}],["$","p","TSA's rate covers the private land transportation component only. Because the resort controls the onward boat or seaplane, confirm that booking directly with Nujuma or the relevant Red Sea transfer service.",{"children":"TSA's rate covers the private land transportation component only. Because the resort controls the onward boat or seaplane, confirm that booking directly with Nujuma or the relevant Red Sea transfer service."}]]}],"$undefined"]}]
4a:["$","section","St. Regis Red Sea and other island resorts",{"id":"island-resorts","aria-labelledby":"h-St-Regis-Red-Sea-and-other-island-resorts","className":"scroll-mt-24","children":[["$","h2",null,{"id":"h-St-Regis-Red-Sea-and-other-island-resorts","className":"font-heading text-2xl font-bold sm:text-3xl","children":"St. Regis Red Sea and other island resorts"}],["$","div",null,{"className":"mt-3 space-y-3 text-[0.95rem] leading-relaxed text-[#475569]","style":{"maxWidth":"70ch"},"children":[["$","p","Nujuma shares its island setting with other Red Sea Global island properties, including St. Regis Red Sea. They follow the same pattern: a land leg to the relevant transfer point, then a marine or air connection. We quote the land leg for these properties on WhatsApp; tell us the resort and your landing time and we confirm what applies.",{"children":"Nujuma shares its island setting with other Red Sea Global island properties, including St. Regis Red Sea. They follow the same pattern: a land leg to the relevant transfer point, then a marine or air connection. We quote the land leg for these properties on WhatsApp; tell us the resort and your landing time and we confirm what applies."}]]}],"$undefined"]}]
