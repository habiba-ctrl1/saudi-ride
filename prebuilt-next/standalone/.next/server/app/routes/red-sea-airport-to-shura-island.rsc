46:["$","section","Can private cars drive onto Shura Island?",{"id":"shura-access","aria-labelledby":"h-Can-private-cars-drive-onto-Shura-Island-","className":"scroll-mt-24","children":[["$","h2",null,{"id":"h-Can-private-cars-drive-onto-Shura-Island-","className":"font-heading text-2xl font-bold sm:text-3xl","children":"Can private cars drive onto Shura Island?"}],["$","div",null,{"className":"mt-3 space-y-3 text-[0.95rem] leading-relaxed text-[#475569]","style":{"maxWidth":"70ch"},"children":[["$","p","Not in the usual door-to-door way. Shura Island is a car-free island: guests leave the vehicle at the mainland parking or causeway access point and cross to the island by electric transfer. Your journey is RSI Airport → Shura Island access / parking / causeway point → property transfer.",{"children":"Not in the usual door-to-door way. Shura Island is a car-free island: guests leave the vehicle at the mainland parking or causeway access point and cross to the island by electric transfer. Your journey is RSI Airport → Shura Island access / parking / causeway point → property transfer."}],["$","p","Exact access and drop-off depend on the property, and each resort runs its own electric transfer arrangement. Tell us your hotel when you book and we confirm what applies to it.",{"children":"Exact access and drop-off depend on the property, and each resort runs its own electric transfer arrangement. Tell us your hotel when you book and we confirm what applies to it."}]]}],["$","ul",null,{"className":"mt-5 grid gap-3 sm:grid-cols-3","children":[["$","li","Our leg",{"className":"rounded-2xl border border-[#0E7490]/15 bg-white p-4 text-sm leading-relaxed text-[#475569]","children":[["$","span",null,{"className":"font-semibold text-[#0F172A]","children":["Our leg","."]}]," ","A private vehicle from RSI arrivals to the Shura Island access point."]}],["$","li","The property's leg",{"className":"rounded-2xl border border-[#0E7490]/15 bg-white p-4 text-sm leading-relaxed text-[#475