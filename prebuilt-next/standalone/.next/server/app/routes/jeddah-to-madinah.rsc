1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] text-[#1C1C1C] pb-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"TouristTrip\",\"name\":\"Jeddah to Madinah Transfer\",\"description\":\"Long distance premium transfer from Jeddah to the Prophet's City via the Haramain highway.\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"itinerary\":{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Jeddah\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@type\":\"TouristAttraction\",\"name\":\"Madinah\"}}]}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How far is Jeddah from Madinah?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Jeddah is about 420 km from Madinah — roughly a 4 to 5 hour drive on the Haramain highway.\"}},{\"@type\":\"Question\",\"name\":\"What is the taxi fare from Jeddah to Madinah (Madina)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The exact fare is confirmed on WhatsApp before booking, based on your vehicle choice — sedan, SUV, or van for families. Tolls included, no surge.\"}},{\"@type\":\"Question\",\"name\":\"Can you collect me from my Jeddah hotel?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, we provide door-to-door pickup from any Jeddah hotel or address and drop you at your Madinah hotel near Masjid an-Nabawi.\"}},{\"@type\":\"Question\",\"name\":\"Are prayer and rest stops included?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Short stops for prayer and refreshments are included on this long-distance route — just tell your driver.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\