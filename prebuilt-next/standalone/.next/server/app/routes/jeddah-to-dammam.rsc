3b:["$","section",null,{"aria-labelledby":"sr-faq","children":[["$","h2",null,{"id":"sr-faq","className":"font-heading text-2xl font-bold sm:text-3xl","children":["Jeddah to Dammam",": your questions"]}],["$","div",null,{"className":"mt-5 space-y-3","children":[["$","details","Can I book a private car from Jeddah to Dammam?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"Can I book a private car from Jeddah to Dammam?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes. We arrange a private car with a driver from any address in Jeddah to Dammam, Al Khobar or Dhahran. Send your pickup and drop-off addresses, date, passengers and luggage, and we reply on WhatsApp, usually within 1–2 hours, with one fixed fare for the vehicle you choose."}]]}],["$","details","How far is Jeddah from Dammam by road, and how long does it take?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"How far is Jeddah from Dammam by road, and how long does it take?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Jeddah to Dammam is about 1,360 km by road and roughly 14 to 15 hours of driving, plus rest, meal and prayer stops. The road crosses the Kingdom through Taif and Riyadh. Real travel time depends on traffic and how many stops you want."}]]}],["$","details","How much is a taxi from Jeddah to Dammam?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"How much is a taxi from Jeddah to Dammam?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"We do not publish a price list because the fare depends on the vehicle, the date and whether you want a night stop. The fare is fixed and agreed on WhatsApp before you book, with no meter and no surge."}]]}],["$","details","Can we stop overnight in Riyadh?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"Can we stop overnight in Riyadh?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes, and many travellers do. Riyadh is roughly two-thirds of the way. Tell us when you book and the overnight stop is included in the quote, so the fare you agree is the fare you pay."}]]}],["$","details","Which vehicle is best for Jeddah to Dammam?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"Which vehicle is best for Jeddah to Dammam?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"A full-size SUV suits most travellers on this route because of the hours involved and the luggage space. A sedan works for one or two adults with light bags, and a van suits a larger family. The exact vehicle is confirmed with your fare."}]]}],["$","details","Can you pick us up from Jeddah airport and drive straight to Dammam?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":["$L46","$L47"]}],"$L48"]}]]}]
