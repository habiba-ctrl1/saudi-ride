27:T56b,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How far is NEOM from Aqaba?","acceptedAnswer":{"@type":"Answer","text":"It depends on where in NEOM you start. From the NEOM Bay Airport (Sharma) area it is about 235 km by road; from Magna in the north it is about 165 km. Both cross at Al Durrah near Haql."}},{"@type":"Question","name":"Which border do you use between NEOM and Aqaba?","acceptedAnswer":{"@type":"Answer","text":"Al Durrah on the Gulf of Aqaba coast, just north of Haql. Aqaba is about 30 km beyond it."}},{"@type":"Question","name":"Are border crossing fees included?","acceptedAnswer":{"@type":"Answer","text":"Yes — border crossing fees for the vehicle are included in the fixed fare. Personal visa or entry fees, where they apply, are the passenger's."}},{"@type":"Question","name":"What documents do I need?","acceptedAnswer":{"@type":"Answer","text":"A valid passport and the right to enter Jordan; Saudi residents generally also need a valid exit and re-entry visa. Check official sources before travel — we do not arrange visas."}},{"@type":"Question","name":"Can my company book regular NEOM–Aqaba trips?","acceptedAnswer":{"@type":"Answer","text":"Yes. Email an RFQ with dates, passengers and pickup points and we reply with a written quote. Corporate invoicing can be arranged through our sister company."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] pb-28 text-[#1C1C1C] lg:pb-16","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"NEOM to Aqaba, Jordan private transfer\",\"description\":\"A private transfer from NEOM to Aqaba runs north along the Gulf of Aqaba coast to Haql, crosses at Al Durrah and ends in Aqaba. Measured from the NEOM Bay Airport (Sharma) area it is about 235 km and roughly 3 hours of driving; pickups further north in NEOM, such as Magna, are shorter. Border time is extra. Border crossing fees are included in the fixed fare.\",\"serviceType\":\"Private cross-border transfer\",\"url\":\"https://taxisaudiarabia.com/routes/neom-to-aqaba\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Saudi Arabia\"},{\"@type\":\"Place\",\"name\":\"Jordan\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://taxisaudiarabia.com/routes/neom-to-aqaba#webpage\",\"url\":\"https://taxisaudiarabia.com/routes/neom-to-aqaba\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"#speakable-summary\"]}}"}}]],[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://taxisaudiarabia.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Border Crossings\",\"item\":\"https://taxisaudiarabia.com/services/border-crossings\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Saudi Arabia – Jordan\",\"item\":\"https://taxisaudiarabia.com/cross-border/saudi-to-jordan\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"NEOM to Aqaba, Jordan\",\"item\":\"https://taxisaudiarabia.com/routes/neom-to-aqaba\"}]}"}}]],"$L28"],"$L29","$L2a","$L2b"]}]
