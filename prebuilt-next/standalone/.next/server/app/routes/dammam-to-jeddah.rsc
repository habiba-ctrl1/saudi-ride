3a:["$","section",null,{"aria-labelledby":"sr-faq","children":[["$","h2",null,{"id":"sr-faq","className":"font-heading text-2xl font-bold sm:text-3xl","children":["Dammam to Jeddah",": your questions"]}],["$","div",null,{"className":"mt-5 space-y-3","children":[["$","details","How many hours is Dammam to Jeddah by car?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"How many hours is Dammam to Jeddah by car?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Dammam to Jeddah is roughly 14 to 15 hours of driving for about 1,360 km, before stops. With rest, meals and prayers most trips take a full day and evening, which is why many travellers stay overnight in Riyadh."}]]}],["$","details","Is there a taxi from Dammam to Jeddah?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"Is there a taxi from Dammam to Jeddah?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes. We arrange a pre-booked private car with a driver from Dammam, Al Khobar or Dhahran to Jeddah. It is not a metered street taxi: you agree one fixed fare on WhatsApp before booking and the vehicle is yours for the whole trip."}]]}],["$","details","What does a private car from Dammam to Jeddah cost?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"What does a private car from Dammam to Jeddah cost?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"The fare depends on the vehicle, the date and any overnight stop, so we quote each trip rather than publish a list. Send the details and we reply, usually within 1–2 hours, with a fixed fare. There is no meter and no surge."}]]}],["$","details","Can the driver stop at the Miqat for Umrah?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"Can the driver stop at the Miqat for Umrah?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes. Travellers coming from the east pass the Qarn al-Manazil Miqat at As-Sayl Al-Kabir, near Taif. Tell us when you book and the stop is planned into the trip."}]]}],["$","details","Can you drop us at Jeddah airport instead of the city?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":["$","h3",null,{"className":"inline","children":"Can you drop us at Jeddah airport instead of the city?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes. King Abdulaziz International Airport (JED) can be the drop-off. Share your flight time so the departure from Dammam is set with enough margin."}]]}],["$","details","Can we go to Makkah or Madinah on the same trip?",{"className":"rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold marker:hidden","children":"$L45"}],"$L46"]}],"$L47"]}]]}]
