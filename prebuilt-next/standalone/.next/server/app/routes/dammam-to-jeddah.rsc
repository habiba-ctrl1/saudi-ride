38:["$","section",null,{"aria-labelledby":"sr-booking","className":"rounded-3xl border border-[#16A34A]/15 bg-white p-6 sm:p-8","children":[["$","h2",null,{"id":"sr-booking","className":"font-heading text-2xl font-bold","children":"One-way, return and booking ahead from Dammam"}],["$","div",null,{"className":"mt-3 space-y-3 text-[0.95rem] leading-relaxed text-[#475569]","style":{"maxWidth":"70ch"},"children":[["$","p","You can book one-way to Jeddah, or a return where the same request covers the journey back on a later date. Each leg has its own fare, agreed before travel.",{"children":"You can book one-way to Jeddah, or a return where the same request covers the journey back on a later date. Each leg has its own fare, agreed before travel."}],["$","p","Around school holidays, Ramadan and the Hajj season the western region is busy and vehicles are booked early, so send your dates as soon as they are fixed. For other dates a few days' notice is usually enough; we confirm availability with the quote rather than promising it in advance.",{"children":"Around school holidays, Ramadan and the Hajj season the western region is busy and vehicles are booked early, so send your dates as soon as they are fixed. For other dates a few days' notice is usually enough; we confirm availability with the quote rather than promising it in advance."}],["$","p","If the trip continues to Makkah or Madinah, say so in the same message. It changes the route and the fare, and it is easier to plan as one journey than as two.",{"children":"If the trip continues to Makkah or Madinah, say so in the same message. It changes the route and the fare, and it is easier to plan as one journey than as two."}]]}]]}]
