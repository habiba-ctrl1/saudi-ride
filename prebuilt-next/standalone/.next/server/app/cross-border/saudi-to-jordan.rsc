27:T826,{"@context":"https://schema.org","@type":"ItemList","numberOfItems":16,"itemListElement":[{"@type":"ListItem","position":1,"name":"Haql to Aqaba, Jordan","url":"https://taxisaudiarabia.com/routes/haql-to-aqaba"},{"@type":"ListItem","position":2,"name":"Tabuk to Aqaba, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-aqaba"},{"@type":"ListItem","position":3,"name":"NEOM to Aqaba, Jordan","url":"https://taxisaudiarabia.com/routes/neom-to-aqaba"},{"@type":"ListItem","position":4,"name":"AlUla to Aqaba, Jordan","url":"https://taxisaudiarabia.com/routes/alula-to-aqaba"},{"@type":"ListItem","position":5,"name":"Tabuk to Wadi Rum, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-wadi-rum"},{"@type":"ListItem","position":6,"name":"Tabuk to Petra, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-petra"},{"@type":"ListItem","position":7,"name":"Tabuk to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/tabuk-to-amman"},{"@type":"ListItem","position":8,"name":"NEOM to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/neom-to-amman"},{"@type":"ListItem","position":9,"name":"AlUla to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/alula-to-amman"},{"@type":"ListItem","position":10,"name":"Madinah to Amman, Jordan","url":"https://taxisaudiarabia.com/routes/medinah-to-amman"},{"@type":"ListItem","position":11,"name":"Aqaba, Jordan to Tabuk","url":"https://taxisaudiarabia.com/routes/aqaba-to-tabuk"},{"@type":"ListItem","position":12,"name":"Aqaba, Jordan to NEOM","url":"https://taxisaudiarabia.com/routes/aqaba-to-neom"},{"@type":"ListItem","position":13,"name":"Amman, Jordan to Tabuk","url":"https://taxisaudiarabia.com/routes/amman-to-tabuk"},{"@type":"ListItem","position":14,"name":"Amman, Jordan to NEOM","url":"https://taxisaudiarabia.com/routes/amman-to-neom"},{"@type":"ListItem","position":15,"name":"Amman, Jordan to AlUla","url":"https://taxisaudiarabia.com/routes/amman-to-alula"},{"@type":"ListItem","position":16,"name":"Amman, Jordan to Madinah","url":"https://taxisaudiarabia.com/routes/amman-to-madinah"}]}28:T934,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Which border crossing do you use between Saudi Arabia and Jordan?","acceptedAnswer":{"@type":"Answer","text":"Whichever is shorter for your trip. Halat Ammar–Al Mudawwara, about 110 km north of Tabuk, for Amman, Petra and Wadi Rum. Al Durrah–Durra on the Gulf of Aqaba coast, near Haql, for Aqaba and for trips starting on the NEOM coast."}},{"@type":"Question","name":"Can I take a private car from Tabuk to Aqaba?","acceptedAnswer":{"@type":"Answer","text":"Yes. A driver collects you in Tabuk and drives about 270 km west through Haql and across the Al Durrah crossing to your address in Aqaba. Each passenger completes their own exit and entry checks at the border."}},{"@type":"Question","name":"Can you take me from Saudi Arabia to Petra or Wadi Rum?","acceptedAnswer":{"@type":"Answer","text":"Yes. Tabuk to Petra (about 275 km) and Tabuk to Wadi Rum (about 230 km) both cross at Halat Ammar–Al Mudawwara. AlUla to Petra or Wadi Rum can be quoted on request."}},{"@type":"Question","name":"What documents do I need to enter Jordan by road from Saudi Arabia?","acceptedAnswer":{"@type":"Answer","text":"Each passenger needs a valid passport and the right to enter Jordan; Saudi residents generally also need a valid exit and re-entry visa. Entry rules depend on nationality and change, so confirm with official sources before travel. We do not arrange visas."}},{"@type":"Question","name":"Can you arrange private transfers inside Jordan?","acceptedAnswer":{"@type":"Answer","text":"Yes. Through our partner in Jordan we arrange pre-booked private cars inside Jordan, for example Queen Alia International Airport (AMM) to your Amman hotel, or onward from Amman, Aqaba, Petra or Wadi Rum. Tell us the route and dates on WhatsApp and we confirm a fixed fare before you travel. These are pre-booked private transfers, not street-hail taxis."}},{"@type":"Question","name":"Can I book a private car in Jordan as well as the cross-border leg?","acceptedAnswer":{"@type":"Answer","text":"Yes. Book the Saudi–Jordan leg and your Jordan transfers together and we quote them in one written offer. For example, Amman to Petra is about 230 km and Aqaba to Petra about 125–130 km by road, according to Visit Jordan, the official Jordan Tourism Board site."}}]}1c:["$","div",null,{"className":"min-h-screen bg-[#FAFAF7] pb-24 text-[#1C1C1C]","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Saudi Arabia – Jordan private cross-border transfer\",\"description\":\"Private transfer from Saudi Arabia to Jordan — Tabuk, NEOM, AlUla and Madinah to Aqaba, Petra, Wadi Rum and Amman via the Halat Ammar or Al Durrah crossing. Fixed fare, border fees included.\",\"serviceType\":\"Private cross-border transfer\",\"url\":\"https://taxisaudiarabia.com/cross-border/saudi-to-jordan\",\"provider\":{\"@id\":\"https://taxisaudiarabia.com/#taxiservice\"},\"areaServed\":[{\"@type\":\"Place\",\"name\":\"Saudi Arabia\"},{\"@type\":\"Place\",\"name\":\"Jordan\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$28"}}],"$L29"],"$L2a","$L2b","$L2c"]}]
