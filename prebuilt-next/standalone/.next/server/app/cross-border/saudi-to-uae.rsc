3d:["$","section",null,{"aria-labelledby":"xb-faq","children":[["$","h2",null,{"id":"xb-faq","className":"font-heading text-2xl font-bold","children":["UAE"," cross-border transfer questions"]}],["$","div",null,{"className":"mt-5 space-y-3","children":[["$","details","Can I travel from Saudi Arabia to the UAE by car?",{"className":"group rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-[#1C1C1C] marker:hidden","children":["$","h3",null,{"className":"inline","children":"Can I travel from Saudi Arabia to the UAE by car?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes. Road trips cross at Al Batha on the Saudi side and Ghuwaifat on the UAE side. We arrange a private car with a professional driver from your address in Saudi Arabia to your address in Abu Dhabi or Dubai."}]]}],["$","details","How long is the drive from Riyadh to Dubai?",{"className":"group rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-[#1C1C1C] marker:hidden","children":["$","h3",null,{"className":"inline","children":"How long is the drive from Riyadh to Dubai?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Riyadh to Dubai is about 990 km, roughly 9 hours of driving plus time at the Al Batha–Ghuwaifat border and rest stops. Plan it as a full day."}]]}],["$","details","Is it better to fly or drive from Riyadh to Dubai?",{"className":"group rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-[#1C1C1C] marker:hidden","children":["$","h3",null,{"className":"inline","children":"Is it better to fly or drive from Riyadh to Dubai?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Flying is faster for one person with little luggage. A private car makes more sense for families, groups, heavy luggage or relocation, because it runs door to door with no airport transfers or baggage limits."}]]}],["$","details","What documents do I need to drive into the UAE?",{"className":"group rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-[#1C1C1C] marker:hidden","children":["$","h3",null,{"className":"inline","children":"What documents do I need to drive into the UAE?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Each passenger needs a valid passport or accepted ID and the right to enter the UAE; Saudi residents generally also need a valid exit and re-entry visa. Requirements change, so confirm with official sources before travel. We do not arrange visas."}]]}],["$","details","Can I book a car from Dubai to Riyadh?",{"className":"group rounded-2xl border border-[#16A34A]/12 bg-white p-5 open:border-[#16A34A]/35","children":[["$","summary",null,{"className":"cursor-pointer list-none font-semibold text-[#1C1C1C] marker:hidden","children":["$","h3",null,{"className":"inline","children":"Can I book a car from Dubai to Riyadh?"}]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes. Dubai to Riyadh is a bookable route with pickup from your address in Dubai. Other UAE origins are quoted on request."}]]}]]}]]}]
