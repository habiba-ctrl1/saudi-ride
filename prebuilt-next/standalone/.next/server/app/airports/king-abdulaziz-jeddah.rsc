20:{"metadata":[["$","title","0",{"children":"Jeddah Airport Taxi (JED) | King Abdulaziz International Airport"}],["$","meta","1",{"name":"description","content":"Jeddah Airport (JED) taxi — King Abdulaziz International Airport to Makkah, Madinah or your Jeddah hotel. Meet & greet, flight tracking, fare confirmed on WhatsApp, 24/7."}],["$","link","2",{"rel":"canonical","href":"https://taxisaudiarabia.com/airports/king-abdulaziz-jeddah"}],["$","meta","3",{"property":"og:title","content":"Taxi Service at JED Airport | Taxi Saudi Arabia"}],["$","meta","4",{"property":"og:description","content":"Pre-book a private transfer from King Abdulaziz International Airport (JED) to Makkah (~1 hour), Madinah, or your Jeddah hotel. Meet & greet at arrivals with a name sign, no surge pricing, and 24/7 service — including late-night and early-morning pilgrim flights. Jeddah lies inside the Miqat boundary, so pilgrims arriving by air usually enter Ihram on the plane before landing."}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Jeddah Airport Taxi (JED) | King Abdulaziz International Airport"}],["$","meta","7",{"name":"twitter:description","content":"Jeddah Airport (JED) taxi — King Abdulaziz International Airport to Makkah, Madinah or your Jeddah hotel. Meet & greet, flight tracking, fare confirmed on WhatsApp, 24/7."}],["$","link","8",{"rel":"icon","href":"/icon.svg?5807c8323a0afe6d","type":"image/svg+xml","sizes":"any"}],["$","link","9",{"rel":"apple-touch-icon","href":"/apple-icon.png?a3d778ef374593ff","type":"image/png","sizes":"180x180"}],["$","$L27","10",{}]],"error":null,"digest":"$undefined"}
