20:{"metadata":[["$","title","0",{"children":"Madinah Airport Taxi & Private Car Service (MED) | Meet & Greet"}],["$","meta","1",{"name":"description","content":"Madinah Airport (MED) taxi & private car service — a pre-booked private transfer to your Madinah (Medina) hotel near Masjid an-Nabawi (~25 min). Meet & greet, chauffeur, family vans; get the current fare on WhatsApp, 24/7."}],["$","link","2",{"rel":"canonical","href":"https://taxisaudiarabia.com/airports/prince-mohammad-madinah"}],["$","meta","3",{"property":"og:title","content":"Taxi Service at MED Airport | Taxi Saudi Arabia"}],["$","meta","4",{"property":"og:description","content":"Pre-book a private transfer or private car with chauffeur from Prince Mohammad Bin Abdulaziz Airport (MED) — Madinah (Medina) — to your hotel near Masjid an-Nabawi (~20 km, ~25 min), or a long-distance transfer to Makkah. This is a pre-booked private airport transfer in your own vehicle: meet & greet at arrivals, flight tracking, spacious family vans, and 24/7 service for pilgrims and families."}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"Madinah Airport Taxi & Private Car Service (MED) | Meet & Greet"}],["$","meta","7",{"name":"twitter:description","content":"Madinah Airport (MED) taxi & private car service — a pre-booked private transfer to your Madinah (Medina) hotel near Masjid an-Nabawi (~25 min). Meet & greet, chauffeur, family vans; get the current fare on WhatsApp, 24/7."}],["$","link","8",{"rel":"icon","href":"/icon.svg?5807c8323a0afe6d","type":"image/svg+xml","sizes":"any"}],["$","link","9",{"rel":"apple-touch-icon","href":"/apple-icon.png?a3d778ef374593ff","type":"image/png","sizes":"180x180"}],["$","$L27","10",{}]],"error":null,"digest":"$undefined"}
