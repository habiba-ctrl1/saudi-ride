20:{"metadata":[["$","title","0",{"children":"AlUla Airport (ULH) Private Transfer | Meet & Greet"}],["$","meta","1",{"name":"description","content":"Pre-book a private transfer from AlUla International Airport (ULH) to your resort, hotel or Hegra — on-demand taxis at ULH are very limited. Meet & greet, flight tracking, fare agreed before you travel."}],["$","link","2",{"rel":"canonical","href":"https://taxisaudiarabia.com/airports/alula"}],["$","meta","3",{"property":"og:title","content":"Taxi Service at ULH Airport | Taxi Saudi Arabia"}],["$","meta","4",{"property":"og:description","content":"Private airport transfers from AlUla International Airport (ULH) to your desert resort, hotel or onward sights such as Hegra. Pre-booked, fare agreed before you travel; we track your flight."}],["$","meta","5",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","6",{"name":"twitter:title","content":"AlUla Airport (ULH) Private Transfer | Meet & Greet"}],["$","meta","7",{"name":"twitter:description","content":"Pre-book a private transfer from AlUla International Airport (ULH) to your resort, hotel or Hegra — on-demand taxis at ULH are very limited. Meet & greet, flight tracking, fare agreed before you travel."}],["$","link","8",{"rel":"icon","href":"/icon.svg?5807c8323a0afe6d","type":"image/svg+xml","sizes":"any"}],["$","link","9",{"rel":"apple-touch-icon","href":"/apple-icon.png?a3d778ef374593ff","type":"image/png","sizes":"180x180"}],["$","$L27","10",{}]],"error":null,"digest":"$undefined"}
