1f:{"metadata":[["$","title","0",{"children":"Dammam Airport Taxi (DMM) | King Fahd International Airport"}],["$","meta","1",{"name":"description","content":"Dammam Airport (DMM) taxi — King Fahd International Airport to Dammam, Khobar, Dhahran or Jubail. Meet & greet, fare confirmed on WhatsApp, 24/7."}],["$","link","2",{"rel":"canonical","href":"https://taxisaudiarabia.com/airports/king-fahd-dammam"}],["$","meta","3",{"property":"og:title","content":"Taxi Service at DMM Airport | Taxi Saudi Arabia"}],["$","meta","4",{"property":"og:description","content":"Pre-book a private car from King Fahd International Airport (DMM) to Dammam, Al Khobar, Dhahran (about 50 km), Jubail (about 90 km), Qatif or Half Moon Bay — or straight across the causeway to Bahrain (about 105 km). We track your flight and the fare is agreed before you land."}],["$","meta","5",{"property":"og:url","content":"https://taxisaudiarabia.com/airports/king-fahd-dammam"}],["$","meta","6",{"property":"og:image","content":"https://taxisaudiarabia.com/opengraph-image"}],["$","meta","7",{"property":"og:image:width","content":"1200"}],["$","meta","8",{"property":"og:image:height","content":"630"}],["$","meta","9",{"property":"og:image:alt","content":"Taxi Saudi Arabia"}],["$","meta","10",{"property":"og:type","content":"website"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"Dammam Airport Taxi (DMM) | King Fahd International Airport"}],["$","meta","13",{"name":"twitter:description","content":"Dammam Airport (DMM) taxi — King Fahd International Airport to Dammam, Khobar, Dhahran or Jubail. Meet & greet, fare confirmed on WhatsApp, 24/7."}],["$","meta","14",{"name":"twitter:image","content":"https://taxisaudiarabia.com/opengraph-image"}],["$","meta","15",{"name":"twitter:image:width","content":"1200"}],["$","meta","16",{"name":"twitter:image:height","content":"630"}],["$","meta","17",{"name":"twitter:image:alt","content":"Taxi S