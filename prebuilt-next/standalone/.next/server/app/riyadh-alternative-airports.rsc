4a:["$","details","Can I travel to Bahrain, Doha or Dubai by road?",{"className":"group rounded-2xl border border-[#16A34A]/15 bg-white p-4 open:shadow-sm","children":[["$","summary",null,{"className":"flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold","children":["Can I travel to Bahrain, Doha or Dubai by road?",["$","span",null,{"aria-hidden":true,"className":"text-[#16A34A] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Yes, on request. Bahrain is reached over the King Fahd Causeway, Qatar via the Salwa–Abu Samra crossing and the UAE via the Saudi–UAE land border. Not every vehicle can cross every border, so cross-border eligibility is confirmed for your date before you book."}]]}]
4b:["$","details","What documents should I check before an international transfer?",{"className":"group rounded-2xl border border-[#16A34A]/15 bg-white p-4 open:shadow-sm","children":[["$","summary",null,{"className":"flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold","children":["What documents should I check before an international transfer?",["$","span",null,{"aria-hidden":true,"className":"text-[#16A34A] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Every passenger needs a valid passport and the right to enter the destination country, and residents should confirm their Saudi exit and re-entry status. Requirements differ by nationality and change, so check official government sources and your airline. We do not arrange visas or immigration, and a driver cannot resolve entry problems."}]]}]
4c:["$","details","How early should I leave Riyadh for my flight?",{"className":"group rounded-2xl border border-[#16A34A]/15 bg-white p-4 open:shadow-sm","children":[["$","summary",null,{"className":"flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold","children":["How early should I leave Riyadh for my flight?",["$","span",null,{"aria-hidden":true,"className":"text-[#16A34A] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"There is no single safe buffer. Work backwards from your airline's check-in deadline, then add the road time for your route, traffic, stops and, on international trips, border processing that we cannot predict to the minute. For Doha, Dubai and Jeddah, consider travelling the day before."}]]}]
4d:["$","details","Can I book a return transfer to Riyadh?",{"className":"group rounded-2xl border border-[#16A34A]/15 bg-white p-4 open:shadow-sm","children":[["$","summary",null,{"className":"flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold","children":["Can I book a return transfer to Riyadh?",["$","span",null,{"aria-hidden":true,"className":"text-[#16A34A] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"You can ask for one, subject to route coverage and partner availability. Reverse routes exist for Jeddah, Bahrain, Doha and Dubai. Return fares are quoted separately — they are not assumed to match the outbound fare."}]]}]
4e:["$","details","Can I request a specific vehicle?",{"className":"group rounded-2xl border border-[#16A34A]/15 bg-white p-4 open:shadow-sm","children":[["$","summary",null,{"className":"flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold","children":["Can I request a specific vehicle?",["$","span",null,{"aria-hidden":true,"className":"text-[#16A34A] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"You can request a category — executive sedan, full-size SUV or van — and we match it from the partner network for your date. A specific make or model cannot be promised ahead of confirmation."}]]}]
4f:["$","details","What happens if my flight changes after I request a transfer?",{"className":"group rounded-2xl border border-[#16A34A]/15 bg-white p-4 open:shadow-sm","children":[["$","summary",null,{"className":"flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold","children":["What happens if my flight changes after I request a transfer?",["$","span",null,{"aria-hidden":true,"className":"text-[#16A34A] transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-[#475569]","children":"Message us on WhatsApp as soon as you know, with the new flight number and time. We track flights for airport transfers and adjust the pickup where the partner's schedule allows. Changes on long or cross-border runs depend on availability, and free cancellation applies up to 24 hours before pickup."}]]}]
